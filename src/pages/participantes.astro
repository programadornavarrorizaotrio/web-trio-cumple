---
import Layout from '../layouts/Layout.astro';
import Section from '../components/common/Section.astro';
import Cromos from '../components/cromos/Cromos.astro';
---

<Layout title="Participantes · Trio Feliz">
	<main>
		<h1 class="sr-only">Participantes</h1>
		<Section
			id="participantes"
			antetitulo="Colección"
			titulo="Participantes"
			subtitulo="Cada invitado tiene su cromo. Se descubre cuando se registra: ¿cuántos faltan?"
		>
			<Cromos />
		</Section>
	</main>
</Layout>
