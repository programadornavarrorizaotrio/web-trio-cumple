---
import Layout from '../layouts/Layout.astro';
import Section from '../components/common/Section.astro';
import Juegos from '../components/juegos/Juegos.astro';
---

<Layout title="Juegos · Trio Feliz">
	<main>
		<h1 class="sr-only">Juegos de la fiesta</h1>
		<Section
			id="juegos"
			antetitulo="Recreativos"
			titulo="Juegos"
			subtitulo="¿Qué hacemos entre canción y canción? Propón un juego y mira los de los demás."
		>
			<Juegos />
		</Section>
	</main>
</Layout>
