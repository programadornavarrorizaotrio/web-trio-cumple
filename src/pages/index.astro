---
import Layout from '../layouts/Layout.astro';
import Section from '../components/common/Section.astro';
import Portada from '../components/landing/Portada.astro';
import Ventanas from '../components/landing/Ventanas.astro';
import Asistencia from '../components/rsvp/Asistencia.astro';
import Trio from '../components/trio/Trio.astro';

// Home: portada, el trío, accesos a las secciones (cada una tiene su página) y asistencia.
---

<Layout>
	<main>
		<!-- landing: Persona A -->
		<Portada />

		<!-- trio: Persona A (escena a sangre, lleva su propio <section id="trio">) -->
		<Trio />

		<!-- landing: Persona A -->
		<Ventanas />

		<!-- rsvp: Persona B -->
		<Section
			id="asistencia"
			antetitulo="RSVP"
			titulo="¿Vienes o qué?"
			subtitulo="Dinos si vienes, con cuánta gente y si hay alguna alergia. Lo puedes cambiar cuando quieras."
			fondo="granate"
			centrado
		>
			<Asistencia />
		</Section>
	</main>
</Layout>
