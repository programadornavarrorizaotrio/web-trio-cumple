---
import Layout from '../layouts/Layout.astro';
import Fotos from '../components/fotos/Fotos.astro';
---

<Layout title="Fotos · Trio Feliz">
	<main class="flex-1 bg-crema px-3 pb-12 pt-4 sm:pt-8">
		<div class="mx-auto max-w-2xl">
			<header class="mb-3 px-0.5">
				<h1 class="text-lg font-bold text-granate-oscuro">Fotos de la fiesta</h1>
				<p class="text-[12px] text-tinta-suave">Lo que pasa en la fiesta, subido por los que están en la fiesta.</p>
			</header>
			<Fotos />
		</div>
	</main>
</Layout>
