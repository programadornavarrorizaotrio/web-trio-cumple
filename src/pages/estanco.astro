---
import Layout from '../layouts/Layout.astro';
import Section from '../components/common/Section.astro';
import Estanco from '../components/estanco/Estanco.astro';
---

<Layout title="Estanco · Trio Feliz">
	<main class="min-h-dvh bg-granate">
		<h1 class="sr-only">El estanco</h1>
		<Section
			id="estanco"
			antetitulo="Desde Purias, con cariño"
			titulo="El estanco"
			subtitulo="El estanquero es de Purias. Llena el carrito, confirma la reserva y te lo trae a la fiesta: allí lo pagas."
			fondo="granate"
		>
			<Estanco />
		</Section>
	</main>
</Layout>
