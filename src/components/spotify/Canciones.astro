---
import fiesta from '../../data/fiesta.json';
import Button from '../common/Button.astro';
import Campo from '../common/Campo.astro';
import Marco from '../common/Marco.astro';
import { MAX_CANCIONES } from './datos';

// Gramola: lista colaborativa de Spotify + propuestas para quien no tiene Spotify.
const playlist = fiesta.spotify.playlist as string | null;
const invitacion = fiesta.spotify.invitacion as string | null;
---

<div class="space-y-8 lg:grid lg:grid-cols-[1.2fr_1fr] lg:items-start lg:gap-10 lg:space-y-0">
	<!-- Lista de Spotify -->
	<div>
		{
			playlist ? (
				<iframe
					src={`https://open.spotify.com/embed/playlist/${playlist}?utm_source=generator&theme=0`}
					title="Lista de canciones de la fiesta en Spotify"
					class="h-[380px] w-full rounded-xl border-0 shadow-chapa"
					allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
					loading="lazy"
				/>
			) : (
				<Marco>
					<div class="py-6 text-center">
						<p class="text-5xl" aria-hidden="true">
							🎶
						</p>
						<p class="rotulo mt-3 text-xl text-granate">La gramola se enchufa pronto</p>
						<p class="mt-2 text-sm text-tinta-suave">Aquí saldrá la lista de Spotify de la fiesta.</p>
					</div>
				</Marco>
			)
		}

		{
			invitacion && (
				<Button href={invitacion} target="_blank" rel="noopener" tamano="lg" variante="granate" class="mt-4 w-full">
					Añadir canciones en Spotify
				</Button>
			)
		}
	</div>

	<!-- Propuestas sin Spotify -->
	<div class="rounded-lg border-2 border-granate/15 bg-crema-oscuro/60 p-5">
		<h3 class="text-xl text-granate">¿Sin Spotify?</h3>
		<p class="mt-1 text-sm text-tinta-suave">
			Propón hasta {MAX_CANCIONES} canciones y las añadimos nosotros.
		</p>

		<form data-form-cancion class="mt-4 space-y-4">
			<Campo etiqueta="Canción" name="titulo" required maxlength={80} placeholder="Porompompero" autocomplete="off" />
			<Campo etiqueta="Artista" name="artista" required maxlength={80} placeholder="Manolo Escobar" autocomplete="off" />
			<p data-error hidden role="alert" class="text-sm font-bold text-granate"></p>
			<Button type="submit" class="w-full">Proponer</Button>
		</form>

		<div data-mias hidden class="mt-6">
			<p class="flex items-baseline justify-between text-xs font-black uppercase tracking-[0.2em] text-granate">
				Tus propuestas <span data-quedan class="tracking-normal text-tinta-suave"></span>
			</p>
			<ol data-lista class="mt-2 divide-y-2 divide-dashed divide-granate/15 rounded border-2 border-granate/15 bg-white"></ol>
		</div>
	</div>
</div>

<template data-plantilla-cancion>
	<li class="flex items-center gap-3 px-3 py-2.5">
		<span data-num class="rotulo w-6 text-center text-lg text-granate/40"></span>
		<span class="min-w-0">
			<span data-titulo class="block truncate font-bold"></span>
			<span data-artista class="block truncate text-sm text-tinta-suave"></span>
		</span>
	</li>
</template>

<script>
	import { MAX_CANCIONES, misCanciones, proponerCancion, type Cancion } from './datos';

	const form = document.querySelector<HTMLFormElement>('[data-form-cancion]')!;
	const caja = document.querySelector<HTMLElement>('[data-mias]')!;
	const lista = caja.querySelector<HTMLOListElement>('[data-lista]')!;
	const plantilla = document.querySelector<HTMLTemplateElement>('[data-plantilla-cancion]')!.content.firstElementChild!;
	const error = form.querySelector<HTMLElement>('[data-error]')!;
	const enviar = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

	function pintar(canciones: Cancion[]) {
		caja.hidden = canciones.length === 0;
		lista.replaceChildren(
			...canciones.map((c, i) => {
				const li = plantilla.cloneNode(true) as HTMLLIElement;
				li.querySelector('[data-num]')!.textContent = String(i + 1);
				li.querySelector('[data-titulo]')!.textContent = c.titulo;
				li.querySelector('[data-artista]')!.textContent = c.artista;
				return li;
			}),
		);
		const quedan = MAX_CANCIONES - canciones.length;
		caja.querySelector('[data-quedan]')!.textContent = quedan > 0 ? `Te quedan ${quedan}` : 'Completo';
		form.querySelectorAll('input, button').forEach((el) => ((el as HTMLInputElement).disabled = quedan <= 0));
	}

	pintar(await misCanciones());

	form.addEventListener('submit', async (ev) => {
		ev.preventDefault();
		const datos = new FormData(form);
		error.hidden = true;
		enviar.disabled = true;
		try {
			pintar(
				await proponerCancion({
					titulo: String(datos.get('titulo')).trim(),
					artista: String(datos.get('artista')).trim(),
				}),
			);
			form.reset();
		} catch {
			error.textContent = `Ya has propuesto ${MAX_CANCIONES} canciones.`;
			error.hidden = false;
		} finally {
			enviar.disabled = lista.children.length >= MAX_CANCIONES;
		}
	});
</script>
