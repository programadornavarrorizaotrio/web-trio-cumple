---
import './riverland.css';

// Tocadiscos: gira cuando suena la lista de Spotify y al tocarlo pone o para la música.
// Se sincroniza con el reproductor que tenga `data-spotify` (API de iFrame de Spotify, sin tokens).
// Sin lista, solo gira.
interface Props {
	conLista: boolean;
}

const { conLista } = Astro.props;
const surcos = [88, 83, 78, 73, 62, 57, 52, 47, 42];
---

<div class="rv" data-tocadiscos data-con-lista={conLista ? '' : undefined}>
	<button type="button" data-plato aria-pressed="false" aria-label="Poner la música" class="block w-full cursor-pointer">
		<svg viewBox="0 0 320 230" class="block w-full drop-shadow-[0_12px_24px_rgb(0_0_0/0.6)]" aria-hidden="true">
			<defs>
				<linearGradient id="rv-td-metal" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" stop-color="#cbbccf"></stop>
					<stop offset="0.05" stop-color="#6b5872"></stop>
					<stop offset="0.5" stop-color="#2a1530"></stop>
					<stop offset="0.95" stop-color="#1a0a1d"></stop>
					<stop offset="1" stop-color="#8a7690"></stop>
				</linearGradient>
				<linearGradient id="rv-td-cromo" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" stop-color="#ffffff"></stop>
					<stop offset="0.45" stop-color="#d4c4d8"></stop>
					<stop offset="1" stop-color="#6b5872"></stop>
				</linearGradient>
				<radialGradient id="rv-td-vinilo">
					<stop offset="0" stop-color="#1c1a22"></stop>
					<stop offset="1" stop-color="#050507"></stop>
				</radialGradient>
			</defs>

			<!-- Mueble -->
			<rect class="rv-td-borde" x="4" y="4" width="312" height="222" rx="16" fill="url(#rv-td-metal)" stroke="#ff6fe0" stroke-width="1.5"></rect>

			<!-- Plato con puntos estroboscópicos -->
			<circle cx="130" cy="115" r="103" fill="#120614" stroke="#5a4860" stroke-width="2"></circle>
			<circle cx="130" cy="115" r="99.5" fill="none" stroke="#ff4fbf" stroke-width="1.5" stroke-dasharray="1.5 4" opacity="0.7"></circle>

			<!-- Vinilo (lo que gira) -->
			<g class="rv-disco">
				<circle cx="130" cy="115" r="94" fill="url(#rv-td-vinilo)"></circle>
				{surcos.map((r) => <circle cx="130" cy="115" r={r} fill="none" stroke="#2c2a36" stroke-width="0.6" />)}
				<circle cx="130" cy="115" r="67.5" fill="none" stroke="#000" stroke-width="2.5"></circle>
				<circle cx="130" cy="115" r="32" fill="#ff4fbf"></circle>
				<circle cx="130" cy="115" r="29" fill="none" stroke="#000" stroke-width="0.6" stroke-dasharray="2 2"></circle>
				<text x="130" y="108" text-anchor="middle" font-family="ui-monospace, Menlo, monospace" font-weight="700" font-size="9" fill="#000">TRIOLAND</text>
				<text x="130" y="130" text-anchor="middle" font-family="ui-monospace, Menlo, monospace" font-size="4.6" fill="#000">TRIO FELIZ · LADO A</text>
				<circle cx="130" cy="115" r="3" fill="#e6dce8"></circle>
			</g>

			<!-- Brillo fijo sobre el vinilo -->
			<path d="M130 115 75 35A94 94 0 0 1 112 22Z" fill="#fff" opacity="0.07"></path>
			<path d="M130 115 185 195A94 94 0 0 1 148 208Z" fill="#fff" opacity="0.05"></path>

			<!-- Piloto y rótulos -->
			<circle class="rv-td-led" cx="24" cy="207" r="4.5"></circle>
			<text x="34" y="210" font-family="ui-monospace, Menlo, monospace" font-size="7" fill="#c9b8cc">START</text>
			<text x="290" y="214" text-anchor="end" font-family="ui-monospace, Menlo, monospace" font-size="7" fill="#c9b8cc">33 · 45</text>

			<!-- Pitch -->
			<rect x="300" y="140" width="6" height="58" rx="3" fill="#0a0410" stroke="#5a4860"></rect>
			<rect x="296" y="164" width="14" height="8" rx="2" fill="url(#rv-td-cromo)"></rect>

			<!-- Reposabrazos -->
			<rect x="236" y="187" width="18" height="7" rx="2" fill="#0a0410" stroke="#5a4860"></rect>

			<!-- Brazo -->
			<circle cx="272" cy="48" r="17" fill="#0a0410" stroke="#5a4860" stroke-width="2"></circle>
			<g class="rv-brazo">
				<rect x="265" y="14" width="14" height="20" rx="3" fill="url(#rv-td-cromo)"></rect>
				<path d="M272 48 270 140 205 167" fill="none" stroke="url(#rv-td-cromo)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
				<rect x="190" y="161" width="20" height="12" rx="2" fill="#e6dce8" transform="rotate(-22 200 167)"></rect>
				<circle cx="272" cy="48" r="7" fill="url(#rv-td-cromo)"></circle>
			</g>
		</svg>
	</button>
	<p class="rv-mono mt-3 flex items-center justify-between gap-3 text-xs uppercase tracking-[0.2em]">
		<span data-td-estado class="text-white/60">Toca el disco</span>
		<span class="text-(--rv-rosa)">33⅓ rpm</span>
	</p>
</div>

<style>
	.rv-disco {
		transform-box: fill-box;
		transform-origin: center;
	}

	@media (prefers-reduced-motion: no-preference) {
		.rv-disco {
			animation: rv-girar 1.8s linear infinite paused;
		}
	}

	[data-sonando] .rv-disco {
		animation-play-state: running;
	}

	@keyframes rv-girar {
		to {
			transform: rotate(360deg);
		}
	}

	/* Brazo: en reposo fuera del disco; al sonar baja a los surcos */
	.rv-brazo {
		transform-origin: 272px 48px;
		transform: rotate(-20deg);
		transition: transform 0.9s cubic-bezier(0.5, 0, 0.2, 1);
	}

	[data-sonando] .rv-brazo {
		transform: rotate(0deg);
	}

	.rv-td-led {
		fill: #3a1a35;
		transition: fill 0.3s;
	}

	[data-sonando] .rv-td-led {
		fill: var(--rv-verde);
		filter: drop-shadow(0 0 4px var(--rv-verde));
	}

	[data-sonando] .rv-td-borde {
		filter: drop-shadow(0 0 8px var(--rv-neon));
	}
</style>

<script>
	interface ControladorSpotify {
		togglePlay(): void;
		addListener(evento: 'playback_update', fn: (e: { data: { isPaused: boolean } }) => void): void;
	}
	interface ApiSpotify {
		createController(
			elemento: HTMLElement,
			opciones: { uri: string; width: string; height: number },
			listo: (c: ControladorSpotify) => void,
		): void;
	}

	const caja = document.querySelector<HTMLElement>('[data-tocadiscos]')!;
	const plato = caja.querySelector<HTMLButtonElement>('[data-plato]')!;
	const estado = caja.querySelector<HTMLElement>('[data-td-estado]')!;
	const reproductor = document.querySelector<HTMLIFrameElement>('[data-spotify]');
	const conLista = caja.hasAttribute('data-con-lista');

	let controlador: ControladorSpotify | null = null;

	function sonar(si: boolean) {
		caja.toggleAttribute('data-sonando', si);
		plato.setAttribute('aria-pressed', String(si));
		plato.setAttribute('aria-label', si ? 'Parar la música' : 'Poner la música');
		estado.textContent = si ? (controlador ? '● Sonando' : '● Girando (sin lista aún)') : 'Toca el disco';
	}

	plato.addEventListener('click', () => {
		const ahora = !caja.hasAttribute('data-sonando');
		sonar(ahora); // al momento; si hay Spotify, `playback_update` lo corrige con el estado real
		controlador?.togglePlay();
	});

	// Con lista: se cambia el <iframe> por uno controlable, para que el disco siga a Spotify
	if (conLista && reproductor) {
		(window as unknown as { onSpotifyIframeApiReady: (api: ApiSpotify) => void }).onSpotifyIframeApiReady = (api) => {
			api.createController(reproductor, { uri: reproductor.dataset.spotify!, width: '100%', height: 380 }, (c) => {
				controlador = c;
				c.addListener('playback_update', (e) => {
					if (e.data.isPaused === caja.hasAttribute('data-sonando')) sonar(!e.data.isPaused);
				});
			});
		};
		const api = document.createElement('script');
		api.src = 'https://open.spotify.com/embed/iframe-api/v1';
		api.async = true;
		document.head.append(api);
	}
</script>
