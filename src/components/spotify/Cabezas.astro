---
import { Image } from 'astro:assets';
import trio from '../../data/trio.json';
import './riverland.css';

// /canciones: los tres cumpleañeros como cabezas de cartel, debajo del cartel (Cartel.astro).
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/trio/*.jpg', { eager: true });
const foto = (archivo: string) => fotos[`../../assets/trio/${archivo}`].default;

// Recuadros de "foco" como en el cartel: punto de la foto (fracciones de la imagen original)
// y, si lo lleva, lo que "detecta" al aparecer
type Foco = { punto: [number, number]; texto?: string };
const focos: Record<string, Foco[]> = {
	pencho: [
		{ punto: [0.48, 0.5], texto: 'mirada.seductora.detectada' }, // un ojo
		{ punto: [0.135, 0.635] }, // el otro
	],
	fran: [
		{ punto: [0.565, 0.455], texto: 'nacionalidad.detectada' }, // la barba
		{ punto: [0.26, 0.79] }, // el brazo
	],
	juan: [
		{ punto: [0.43, 0.5], texto: 'mancha.detectada' }, // la camiseta
		{ punto: [0.48, 0.14], texto: 'kalimotxo.detectado' }, // el vaso
	],
};

// Fracciones x/y de un `object-position` ("top", "50% 62%"...)
function fraccionesEncuadre(encuadre: string): [number, number] {
	let x = 0.5;
	let y = 0.5;
	const porcentajes: number[] = [];
	for (const t of encuadre.split(/\s+/)) {
		if (t === 'top') y = 0;
		else if (t === 'bottom') y = 1;
		else if (t === 'left') x = 0;
		else if (t === 'right') x = 1;
		else if (t.endsWith('%')) porcentajes.push(parseFloat(t) / 100);
	}
	if (porcentajes.length > 0) x = porcentajes[0];
	if (porcentajes.length > 1) y = porcentajes[1];
	return [x, y];
}

// Dónde cae el foco dentro de una tarjeta de proporción `aspecto` (ancho/alto) con object-fit: cover
function posicionFoco(img: ImageMetadata, encuadre: string, [fx, fy]: [number, number], aspecto: number) {
	const escala = Math.max(aspecto / img.width, 1 / img.height);
	const [w, h] = [img.width * escala, img.height * escala];
	const [ex, ey] = fraccionesEncuadre(encuadre);
	const x = ((aspecto - w) * ex + fx * w) / aspecto;
	const y = (1 - h) * ey + fy * h;
	const recorta = (v: number) => Math.min(0.88, Math.max(0.12, v));
	return [recorta(x), recorta(y)];
}

function datosFoco(p: (typeof trio)[number], aspectoMovil: number) {
	const lista = focos[p.slug];
	if (!lista) return null;
	const img = foto(p.foto);
	const pct = (v: number) => `${(v * 100).toFixed(1)}%`;
	const recuadros = lista.map(({ punto, texto }, n) => {
		const [x, y] = posicionFoco(img, p.encuadre, punto, aspectoMovil);
		const [sx, sy] = posicionFoco(img, p.encuadre, punto, 4 / 5);
		return {
			x,
			y,
			sx,
			sy,
			texto: texto && `> ${texto}`,
			// El texto se escribe hacia dentro de la tarjeta para que no se corte en los bordes
			// (clases escritas enteras para que Tailwind las vea)
			claseTexto: [
				x > 0.5 ? 'right-0' : 'left-0',
				y > 0.7 ? 'bottom-full' : 'top-full',
				sx > 0.5 ? 'sm:right-0 sm:left-auto' : 'sm:left-0 sm:right-auto',
				sy > 0.7 ? 'sm:bottom-full sm:top-auto' : 'sm:top-full sm:bottom-auto',
			],
			// Los siguientes recuadros aparecen con un poco de retraso
			estilo: `--x: ${pct(x)}; --y: ${pct(y)}; --sx: ${pct(sx)}; --sy: ${pct(sy)}; --letras: ${(texto?.length ?? 0) + 2}; --retraso: ${n * 0.18}s`,
		};
	});
	// El nombre va abajo; si algún foco cae abajo a la izquierda, se pasa a la derecha para no taparlo
	const abajoIzquierda = recuadros.some((r) => r.y > 0.6 && r.x < 0.5);
	const abajoIzquierdaSm = recuadros.some((r) => r.sy > 0.6 && r.sx < 0.5);
	return {
		recuadros,
		claseNombre: [
			abajoIzquierda ? 'right-2 items-end' : 'left-2 items-start',
			abajoIzquierdaSm ? 'sm:right-2 sm:left-auto sm:items-end' : 'sm:left-2 sm:right-auto sm:items-start',
		],
	};
}
---

<section class="rv bg-(--rv-negro) pb-2 pt-10 text-white" aria-label="Cabezas de cartel">
	<div class="mx-auto max-w-3xl">
		<!-- Cabezas de cartel -->
		<div class="flex items-baseline justify-between gap-3 px-4">
			<h2 class="text-base"><span class="rv-tag rv-tag-lg whitespace-nowrap">Cabezas de cartel</span></h2>
			<p class="rv-mono text-xs uppercase text-white/60 sm:hidden" aria-hidden="true">Desliza →</p>
		</div>
		<ul class="mt-4 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto px-4 pb-2 [scrollbar-width:none] sm:grid sm:grid-cols-3 sm:gap-2 sm:overflow-visible">
			{
				trio.map((p, i) => {
					const foco = datosFoco(p, 4 / 5);
					return (
						<li data-tarjeta class="rv-duo rv-tarjeta relative w-[72%] shrink-0 snap-start overflow-hidden rounded-2xl sm:w-auto">
							<Image
								src={foto(p.foto)}
								alt={`${p.nombre}, cumpleañero`}
								widths={[360, 720]}
								sizes="(min-width: 640px) 33vw, 72vw"
								class="aspect-[4/5] w-full object-cover"
								style={`object-position: ${p.encuadre}`}
								draggable="false"
							/>
							{foco?.recuadros.map((r, n) => (
								<span
									class="rv-foco absolute left-(--x) top-(--y) size-12 -translate-x-1/2 -translate-y-1/2 border-2 border-white sm:left-(--sx) sm:top-(--sy) sm:size-14"
									style={r.estilo}
									aria-hidden="true"
								>
									<span class:list={['rv-punto', (i + n) % 2 ? '-bottom-1.5 -right-1.5' : '-left-1.5 -top-1.5']} />
									{r.texto && <span class:list={['rv-foco-texto rv-mono absolute my-1.5', r.claseTexto]}>{r.texto}</span>}
								</span>
							))}
							<span class:list={['absolute bottom-2 flex flex-col', foco?.claseNombre ?? 'left-2 items-start']}>
								<span class="rv-tag">{p.nombre}</span>
								<span class="rv-tag rv-tag-negro text-xs">{p.lema}</span>
							</span>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>

<script>
	// El recuadro aparece (con glitch) la primera vez que pasas el ratón o pulsas la foto, y ya se queda
	document.querySelectorAll<HTMLElement>('[data-tarjeta]').forEach((tarjeta) => {
		const activar = () => tarjeta.setAttribute('data-visto', '');
		tarjeta.addEventListener('pointerenter', (ev) => ev.pointerType === 'mouse' && activar());
		tarjeta.addEventListener('pointerdown', activar);
		tarjeta.addEventListener('contextmenu', (ev) => ev.preventDefault());
	});
</script>
