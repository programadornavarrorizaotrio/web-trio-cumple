---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import fiesta from '../../data/fiesta.json';
import trio from '../../data/trio.json';
import './riverland.css';

// Cartel de festival en negro y rosa: título vertical en letra de píxel a todo lo alto y line-up de la A a la Z
// con los invitados que han confirmado (llegan en el navegador). No hay secciones: lo que parte la lista son las
// fotos del trío, en rosa y negro, con sus recuadros de foco. Los cumpleañeros salen solo en foto, sin nombre.

const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/trio/*.jpg', { eager: true });
const foto = (archivo: string) => fotos[`../../assets/trio/${archivo}`].default;

const inicio = new Date(fiesta.inicio);
const fecha = (opciones: Intl.DateTimeFormatOptions) =>
	new Intl.DateTimeFormat('es-ES', { timeZone: fiesta.zonaHoraria, ...opciones }).format(inicio);

// Recuadros de foco de cada foto: punto de la imagen original (en fracciones) y, si lo lleva, lo que "detecta"
type Foco = { punto: [number, number]; texto?: string };
const focos: Record<string, Foco[]> = {
	pencho: [
		{ punto: [0.48, 0.5], texto: 'mirada.seductora.detectada' }, // un ojo
		{ punto: [0.135, 0.635] }, // el otro
	],
	fran: [
		{ punto: [0.565, 0.375], texto: 'nacionalidad.detectada' }, // la cara
		{ punto: [0.26, 0.79] }, // el brazo
	],
	juan: [
		{ punto: [0.43, 0.5], texto: 'mancha.detectada' }, // la camiseta
		{ punto: [0.48, 0.14], texto: 'kalimotxo.detectado' }, // el vaso
	],
};

// Fracciones x/y de un `object-position` ("top", "50% 62%")
function fraccionesEncuadre(encuadre: string): [number, number] {
	if (encuadre === 'top') return [0.5, 0];
	const [x = 0.5, y = 0.5] = encuadre.split(/\s+/).map((t) => parseFloat(t) / 100);
	return [x, y];
}

// Dónde cae el foco dentro de una ventana de proporción ASPECTO (ancho/alto) con object-fit: cover
const ASPECTO = 4 / 5;
function posicionFoco(img: ImageMetadata, encuadre: string, [fx, fy]: [number, number]) {
	const escala = Math.max(ASPECTO / img.width, 1 / img.height);
	const [w, h] = [img.width * escala, img.height * escala];
	const [ex, ey] = fraccionesEncuadre(encuadre);
	const recorta = (v: number) => Math.min(0.88, Math.max(0.12, v));
	return [recorta(((ASPECTO - w) * ex + fx * w) / ASPECTO), recorta((1 - h) * ey + fy * h)];
}

// Las fotos en el orden del cartel: Pencho y Fran juntos, y Juan aparte
const ventanas = trio.map((p) => ({
	...p,
	focos: focos[p.slug].map(({ punto, texto }, n) => {
		const [x, y] = posicionFoco(foto(p.foto), p.encuadre, punto);
		return {
			texto: texto && `> ${texto}`,
			// El texto se escribe hacia dentro de la foto para que no se corte en los bordes
			clases: [x > 0.5 ? 'texto-izq' : 'texto-der', y > 0.7 ? 'texto-arriba' : 'texto-abajo'],
			// Los siguientes recuadros aparecen con un poco de retraso
			estilo: `left: ${(x * 100).toFixed(1)}%; top: ${(y * 100).toFixed(1)}%; --letras: ${(texto?.length ?? 0) + 2}; --retraso: ${n * 0.18}s`,
		};
	}),
}));
const grupos = [ventanas.slice(0, 2), ventanas.slice(2)];
---

<section aria-label="Cartel del festival" class="cartel rv" data-cartel>
	<!-- Título vertical, a todo lo alto -->
	<p class="titulo" aria-label="Trio Feliz">TRIO FELIZ</p>

	<div class="contenido">
		<div class="etiquetas">
			<p class="tag">{fiesta.lugar.nombre}</p>
			<p class="tag">{fecha({ year: 'numeric' })}</p>
		</div>
		<p class="tag tag-hueco">LINE UP A-Z</p>

		<ul class="nombres" data-nombres aria-label="Invitados confirmados"></ul>
		{
			grupos.map((grupo, i) => (
				<>
					<div class="fotos">
						{grupo.map((p) => (
							<div class:list={['ventana rv-tarjeta', `ventana-${p.slug}`]} data-ventana>
								<Image
									src={foto(p.foto)}
									alt={`${p.nombre}, cumpleañero`}
									widths={[320, 640]}
									sizes="(min-width: 40rem) 20rem, 50vw"
									style={`object-position: ${p.encuadre}`}
									draggable="false"
								/>
								{p.focos.map((f) => (
									<span class="rv-foco foco" style={f.estilo} aria-hidden="true">
										<span class="rv-punto -left-1.5 -top-1.5" />
										{f.texto && <span class:list={['rv-foco-texto rv-mono', f.clases]}>{f.texto}</span>}
									</span>
								))}
							</div>
						))}
						{/* La fecha, en el hueco que deja Fran al ir más abajo */}
						{i === 0 && (
							<p class="fecha">
								{fecha({ weekday: 'long' })}
								<strong>{fecha({ day: 'numeric' })}</strong>
								{fecha({ month: 'long' })}
							</p>
						)}
						<span class="nodo" aria-hidden="true" />
						<span class="barra-ui" aria-hidden="true" />
					</div>
					<ul class="nombres" data-nombres aria-label="Más invitados confirmados" />
				</>
			))
		}

		<p class="tag web">TRIOFELIZ.FEST</p>
	</div>

	<!-- Líneas discontinuas que cruzan el cartel -->
	<svg class="rutas" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
		<path d="M14 2 C 40 20, 95 10, 92 40 S 30 70, 60 98"></path>
		<path d="M100 18 C 70 30, 20 35, 18 60 S 60 80, 40 100"></path>
	</svg>
</section>

<!-- Descargar el cartel como imagen -->
<div class="rv bg-(--rv-negro) px-3 lg:px-[max(1rem,calc((100vw-72rem)/2))]">
	<div class="flex items-center justify-between gap-3 border-t-2 border-dashed border-white/20 py-3">
		<p class="rv-mono text-xs uppercase leading-tight text-white/60">Guárdalo y pásalo<br />por el grupo</p>
		<button
			type="button"
			data-descargar
			class="rv-mono flex shrink-0 items-center gap-2 border-2 border-(--rv-rosa) px-3 py-2 text-sm font-bold uppercase tracking-wider text-(--rv-rosa) transition-colors hover:bg-(--rv-rosa) hover:text-black active:bg-(--rv-rosa) active:text-black disabled:pointer-events-none disabled:opacity-40"
		>
			Descargar <span aria-hidden="true">↓</span>
		</button>
	</div>
	<p data-descargar-error hidden role="alert" class="rv-mono pb-3 text-sm font-bold uppercase text-(--rv-rosa)"></p>
</div>

<script>
	import { obtenerConfirmados } from './datos';

	const cartel = document.querySelector<HTMLElement>('[data-cartel]')!;

	// Los confirmados, de la A a la Z, en tres bloques separados por las fotos. Los bloques van de 4 en 4
	// para que las filas (2 por fila en móvil, 4 en pantallas anchas) salgan completas.
	const bloques = [...cartel.querySelectorAll<HTMLElement>('[data-nombres]')];
	function pintar(nombres: string[]) {
		const porBloque = Math.ceil(nombres.length / bloques.length / 4) * 4;
		bloques.forEach((ul, i) => {
			const lista = nombres.slice(i * porBloque, (i + 1) * porBloque);
			ul.hidden = lista.length === 0;
			ul.replaceChildren(
				...lista.map((n) => {
					const li = document.createElement('li');
					li.textContent = n;
					return li;
				}),
			);
		});
	}

	obtenerConfirmados()
		.then((nombres) => pintar(nombres.length ? nombres.sort((a, b) => a.localeCompare(b, 'es')) : ['Por anunciar']))
		.catch(() => pintar(['No se ha podido cargar el line-up']));

	// Los recuadros aparecen con glitch al llegar a la foto, una sola vez, y ya se quedan
	const ventanas = [...cartel.querySelectorAll<HTMLElement>('[data-ventana]')];
	const alVer = new IntersectionObserver(
		(entradas) =>
			entradas.forEach(({ isIntersecting, target }) => {
				if (!isIntersecting) return;
				target.setAttribute('data-visto', '');
				alVer.unobserve(target);
			}),
		{ threshold: 0.6 },
	);
	ventanas.forEach((v) => {
		alVer.observe(v);
		v.addEventListener('contextmenu', (ev) => ev.preventDefault());
	});

	// Descargar el cartel como PNG. La librería se carga solo al pulsar (no va en el bundle).
	const botonDescarga = document.querySelector<HTMLButtonElement>('[data-descargar]')!;
	const errorDescarga = document.querySelector<HTMLElement>('[data-descargar-error]')!;
	botonDescarga.addEventListener('click', async () => {
		const texto = botonDescarga.innerHTML;
		botonDescarga.disabled = true;
		botonDescarga.textContent = 'Preparando…';
		errorDescarga.hidden = true;
		// En la imagen salen todos los recuadros, ya quietos
		ventanas.forEach((v) => v.setAttribute('data-visto', ''));
		cartel.getAnimations({ subtree: true }).forEach((a) => a.finish());
		try {
			const url = 'https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/+esm';
			const { toBlob } = await import(/* @vite-ignore */ url);
			const blob: Blob | null = await toBlob(cartel, { pixelRatio: 2, backgroundColor: '#0b0b0b', includeQueryParams: true });
			if (!blob) throw new Error('sin imagen');
			const enlace = document.createElement('a');
			enlace.href = URL.createObjectURL(blob);
			enlace.download = 'cartel-trio-feliz.png';
			enlace.click();
			setTimeout(() => URL.revokeObjectURL(enlace.href), 10000);
		} catch {
			errorDescarga.textContent = 'No se ha podido crear la imagen. Haz una captura de pantalla del cartel.';
			errorDescarga.hidden = false;
		} finally {
			botonDescarga.disabled = false;
			botonDescarga.innerHTML = texto;
		}
	});
</script>

<style>
	.cartel {
		--rosa: #f53fc9;
		position: relative;
		overflow: hidden;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0 0.6rem;
		padding: 0.9rem 0.75rem 1rem 0.5rem;
		background: #0b0b0b;
		color: #f5f5f5;
		font-family: 'Space Mono', ui-monospace, monospace;
	}

	/* Título vertical, de abajo arriba, a todo lo alto del cartel */
	.titulo {
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		font-family: 'Silkscreen', 'Space Mono', monospace;
		font-weight: 700;
		font-size: clamp(3.2rem, 16vw, 7rem);
		line-height: 0.8;
		letter-spacing: -0.06em;
		color: var(--rosa);
		text-align: justify;
		text-align-last: justify;
	}

	/* El contenido se reparte a lo largo: las franjas llegan hasta el final */
	.contenido {
		min-width: 0;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.7rem;
	}
	.etiquetas {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.tag {
		width: fit-content;
		padding: 0.05em 0.4em;
		background: var(--rosa);
		color: #0b0b0b;
		font-size: 0.8rem;
		font-weight: 700;
		line-height: 1.35;
		text-transform: uppercase;
	}
	.tag-hueco {
		background: transparent;
		color: var(--rosa);
		box-shadow: inset 0 0 0 2px var(--rosa);
	}

	.nombres {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.25rem 0.9rem;
		font-size: 0.85rem;
		font-weight: 700;
		line-height: 1.25;
		text-transform: uppercase;
	}
	.nombres[hidden] {
		display: none;
	}
	.nombres :global(li) {
		position: relative;
		overflow-wrap: anywhere;
	}
	.nombres :global(li:only-child) {
		grid-column: 1 / -1;
	}
	/* Punto separador entre columnas */
	.nombres :global(li:nth-child(odd):not(:last-child))::after {
		content: '·';
		position: absolute;
		top: 0;
		right: -0.65rem;
	}
	@media (min-width: 40rem) {
		.nombres {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			font-size: 0.95rem;
		}
		.nombres :global(li:nth-child(odd):not(:last-child))::after {
			content: none;
		}
		.nombres :global(li:not(:nth-child(4n)):not(:last-child))::after {
			content: '·';
			position: absolute;
			top: 0;
			right: -0.65rem;
		}
		.tag {
			font-size: 0.95rem;
		}
	}

	/* --- Fotos entre bloque y bloque de nombres, en rosa y negro --- */
	.fotos {
		position: relative;
		display: grid;
		grid-template-columns: repeat(100, minmax(0, 1fr));
		align-items: start;
		width: 100%;
		max-width: 36rem;
		margin: 0.6rem auto;
	}
	.ventana {
		grid-row: 1;
		position: relative;
		isolation: isolate;
		aspect-ratio: 4 / 5; /* ASPECTO */
		border-radius: 1.1rem;
		background: var(--rosa);
	}
	.ventana :global(img) {
		width: 100%;
		height: 100%;
		border-radius: inherit;
		object-fit: cover;
		filter: grayscale(1) contrast(1.5) brightness(1.05);
		mix-blend-mode: multiply;
	}
	/* Pencho arriba a la izquierda y Fran más abajo, pisándole solo la esquina */
	.ventana-pencho {
		grid-column: 1 / 58;
	}
	/* Su foto es de noche: sin más luz no se le ve la cara */
	.ventana-pencho :global(img) {
		filter: grayscale(1) brightness(1.7) contrast(1.35);
	}
	.ventana-fran {
		grid-column: 49 / 101;
		margin-top: 100%; /* del ancho de su columna */
		box-shadow: 0 0 0 3px #0b0b0b;
	}
	.ventana-juan {
		grid-column: 20 / 82;
	}

	.foco {
		position: absolute;
		width: 28%;
		aspect-ratio: 1;
		translate: -50% -50%; /* `transform` lo usa el glitch */
		border: 2px solid #fff;
	}
	.foco .rv-foco-texto {
		position: absolute;
		margin-block: 0.375rem;
	}
	.texto-izq {
		right: 0;
	}
	.texto-der {
		left: 0;
	}
	.texto-arriba {
		bottom: 100%;
	}
	.texto-abajo {
		top: 100%;
	}

	.fecha {
		grid-row: 1;
		grid-column: 60 / 101;
		display: grid;
		justify-items: end;
		padding-top: 0.2rem;
		color: var(--rosa);
		font-size: 0.8rem;
		font-weight: 700;
		line-height: 1.2;
		text-transform: uppercase;
	}
	.fecha strong {
		font-family: 'Silkscreen', 'Space Mono', monospace;
		font-size: 3.2rem;
		line-height: 0.95;
		letter-spacing: -0.06em;
	}

	.nodo {
		position: absolute;
		z-index: 2;
		left: 3%;
		bottom: 12%;
		width: 0.7rem;
		height: 1rem;
		border: 2px solid var(--rosa);
		background: #0b0b0b;
	}
	.nodo::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		width: 0.3rem;
		height: 0.3rem;
		border-radius: 9999px;
		background: #7dff9a;
		transform: translate(-50%, -50%);
	}
	.barra-ui {
		position: absolute;
		z-index: 2;
		left: 14%;
		bottom: 22%;
		width: 3.2rem;
		height: 0.55rem;
		border: 2px solid #0b0b0b;
		background: var(--rosa);
	}

	.rutas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}
	.rutas path {
		fill: none;
		stroke: rgb(255 255 255 / 0.75);
		stroke-width: 1;
		stroke-dasharray: 5 4;
		vector-effect: non-scaling-stroke;
	}

	.web {
		align-self: flex-end;
		position: relative;
		z-index: 2;
		font-size: 1rem;
	}

	@media (min-width: 64rem) {
		.cartel {
			padding-inline: max(1rem, calc((100vw - 72rem) / 2));
		}
	}
</style>
