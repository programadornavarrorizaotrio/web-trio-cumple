---
import fiesta from '../../data/fiesta.json';
import Recorrido from './Recorrido.astro';

// Fecha legible en hora de Madrid, calculada en el build: "sábado, 27 de febrero"
const fecha = new Intl.DateTimeFormat('es-ES', {
	weekday: 'long',
	day: 'numeric',
	month: 'long',
	timeZone: fiesta.zonaHoraria,
}).format(new Date(fiesta.inicio));

// Hora de llegada del día de la fiesta, con la zona de `inicio`
const llegada = `${fiesta.inicio.slice(0, 11)}${fiesta.llegada}:00${fiesta.inicio.slice(19)}`;
---

<!-- Paleta de la charca: las usa el recorrido y el contador -->
<div id="inicio" data-llegada={llegada} class="selva">
	<Recorrido fecha={fecha} />
</div>

<style>
	.selva {
		--c-bosque: #0e2a1f;
		--c-hoja: #1d6b45;
		--c-lima: #c6f26b;
		--c-agua: #0f7a72;
		--c-flor: #ff7fa8;
		--c-sol: #ffcf5c;
		--c-crema: #fff4d6;
	}
</style>

<script>
	import { leerSesion, EXIGIR_REGISTRO } from '../registro/sesion';

	// El día de la fiesta cambian el texto y los botones (en pruebas: ?fiesta=hoy)
	const portada = document.querySelector<HTMLElement>('#inicio')!;
	const forzado = new URLSearchParams(location.search).get('fiesta') === 'hoy' && (import.meta.env.DEV || !EXIGIR_REGISTRO);
	function comprobarDia() {
		const esDia = forzado || Date.now() >= new Date(portada.dataset.llegada!).getTime();
		portada.querySelectorAll<HTMLElement>('[data-cta]').forEach((el) => (el.hidden = (el.dataset.cta === 'fiesta') !== esDia));
		return esDia;
	}
	if (!comprobarDia()) {
		const intervalo = setInterval(() => comprobarDia() && clearInterval(intervalo), 30_000);
	}

	// "¡Hola, Marta! Estás invitada…" con el nombre de la sesión
	const sesion = leerSesion();
	const saludo = document.querySelector('[data-saludo]');
	if (sesion && saludo) saludo.textContent = `¡Hola, ${sesion.nombre.split(' ')[0]}! Estás invitado`;
</script>
