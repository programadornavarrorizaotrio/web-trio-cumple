---
import Emblema from '../common/Emblema.astro';
import FotosDemo from '../cromos/FotosDemo.astro';

// Accesos a cada sección desde la home. Participantes va destacada; el resto en rejilla.
// Cada ventana enseña un dato vivo (data-dato) que rellena el script.
const ventanas = [
	{ href: '/estanco', emoji: '🚬', titulo: 'Estanco', texto: 'Reserva tu tabaco', dato: 'estanco' },
	{ href: '/canciones', emoji: '🎶', titulo: 'Canciones', texto: 'Pon tú la música' },
	{ href: '/juegos', emoji: '🎲', titulo: 'Juegos', texto: 'Propón a qué jugamos' },
	{ href: '/fotos', emoji: '📷', titulo: 'Fotos', texto: 'El carrete de la fiesta' },
];
---

<FotosDemo />

<nav aria-label="Secciones" class="space-y-3">
	<!-- Participantes: la principal -->
	<a
		href="/participantes"
		class="group relative block overflow-hidden rounded-lg border-2 border-amarillo bg-granate p-5 text-crema shadow-chapa transition-transform active:scale-[0.98]"
	>
		<Emblema class="absolute -right-6 -top-6 size-32 text-granate-claro/40" hueco="var(--color-granate)" />
		<span class="relative block text-xs font-black uppercase tracking-[0.2em] text-amarillo-claro">Álbum de cromos</span>
		<span class="rotulo relative mt-1 block text-2xl text-amarillo sm:text-4xl">Participantes</span>
		<span class="relative mt-1 block text-sm text-crema/85">¿Quién viene? Descubre el cromo de cada invitado.</span>

		<!-- Primeros cromos -->
		<span data-v-caras class="relative mt-4 flex -space-x-2" aria-hidden="true"></span>

		<span class="relative mt-4 flex items-center justify-between gap-3 text-sm font-bold">
			<span><span data-v-conseguidos class="rotulo text-xl text-amarillo">–</span> de <span data-v-total>–</span> cromos</span>
			<span class="rounded bg-amarillo px-3 py-1.5 text-xs font-black uppercase tracking-wider text-granate-oscuro">Ver álbum →</span>
		</span>
		<span class="relative mt-2 block h-1.5 overflow-hidden rounded-full bg-crema/20">
			<span data-v-progreso class="block h-full w-0 rounded-full bg-amarillo transition-[width] duration-700"></span>
		</span>
	</a>

	<!-- Resto de secciones -->
	<div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
		{
			ventanas.map((v) => (
				<a
					href={v.href}
					class="flex min-h-32 flex-col rounded-lg border-2 border-granate/15 bg-white p-4 shadow-chapa transition-transform active:scale-[0.97]"
				>
					<span class="text-3xl" aria-hidden="true">
						{v.emoji}
					</span>
					<span class="rotulo mt-2 text-base text-granate sm:text-lg">{v.titulo}</span>
					<span class="text-sm leading-snug text-tinta-suave">{v.texto}</span>
					{v.dato && <span data-dato={v.dato} hidden class="mt-auto pt-2 text-xs font-black uppercase tracking-wider text-granate" />}
				</a>
			))
		}
	</div>
</nav>

<template data-plantilla-cara>
	<span class="relative grid size-11 place-items-center overflow-hidden rounded-full border-2 border-amarillo bg-granate-oscuro">
		<img data-c-foto alt="" class="size-full object-cover" hidden />
		<span data-c-inicial class="rotulo text-base text-amarillo"></span>
	</span>
</template>

<script>
	import { obtenerAlbum } from '../cromos/datos';
	import { pintarFoto } from '../cromos/pintar';
	import { estadoEstanco } from '../estanco/datos';

	const $ = (sel: string) => document.querySelector<HTMLElement>(sel)!;

	// Participantes: progreso y primeras caras
	const { cromos, total } = await obtenerAlbum();
	$('[data-v-conseguidos]').textContent = String(cromos.length);
	$('[data-v-total]').textContent = String(total);
	$('[data-v-progreso]').style.width = `${total ? (cromos.length / total) * 100 : 0}%`;
	const plantilla = document.querySelector<HTMLTemplateElement>('[data-plantilla-cara]')!.content.firstElementChild!;
	$('[data-v-caras]').replaceChildren(
		...cromos.slice(0, 7).map((c) => {
			const cara = plantilla.cloneNode(true) as HTMLElement;
			pintarFoto(cara.querySelector('img')!, cara.querySelector<HTMLElement>('[data-c-inicial]')!, c);
			return cara;
		}),
	);

	// Datos de un vistazo
	const dato = (nombre: string, texto: string) => {
		const el = $(`[data-dato="${nombre}"]`);
		el.textContent = texto;
		el.hidden = false;
	};
	const unidades = Object.values((await estadoEstanco()).mias).reduce((a, b) => a + b, 0);
	if (unidades) dato('estanco', `${unidades} reservado${unidades === 1 ? '' : 's'}`);
</script>
