---
import { Image } from 'astro:assets';
import fiesta from '../../data/fiesta.json';
import saluda from '../../assets/mascota/saluda.png';
import reloj from '../../assets/mascota/reloj.png';
import mapa from '../../assets/mascota/mapa.png';
import Contador from './Contador.astro';

// La portada son TRES SECCIONES normales, una debajo de otra, con el scroll de siempre (nada de
// páginas fijas ni scroll secuestrado):
//   1 · título                   (amanecer, la rana saluda)
//   2 · cuándo y dónde           (tarde, la rana con el mapa)
//   3 · cuenta atrás y confirmar (noche con luciérnagas, la rana mirando la hora)
// Al llegar a cada sección la rana SALTA desde fuera del cuadro hasta su nenúfar y deja una onda
// en el agua; la tarjeta aparece a la vez. Es solo un añadido: con "reducir movimiento" (o sin JS)
// todo se ve ya colocado. El script está al final del archivo.
interface Props {
	fecha: string;
}
const { fecha } = Astro.props;

// Luciérnagas de la noche: [x %, y %, retraso s]
const luciernagas = [
	[8, 14, 0], [24, 8, 1.2], [78, 12, 0.6], [92, 26, 1.8], [14, 36, 0.9], [64, 6, 2.2],
	[48, 20, 0.3], [34, 30, 1.5], [88, 42, 0.4], [6, 50, 2],
];
---

<div class="rec">
	<!-- ================= 1 · Título ================= -->
	<section class="fase f0" aria-label="Trioland">
		<div class="arte" aria-hidden="true">
			<div class="astro"></div>
			<svg class="colinas lejos" viewBox="0 0 400 120" preserveAspectRatio="none">
				<path d="M0 120V70C40 40 80 30 130 55C180 80 220 20 280 35C330 48 370 60 400 40V120Z"></path>
			</svg>
			<svg class="colinas cerca" viewBox="0 0 400 120" preserveAspectRatio="none">
				<path d="M0 120V80C60 55 100 75 160 60C220 45 260 85 320 65C360 52 385 62 400 58V120Z"></path>
			</svg>
			<div class="agua"><div class="reflejos"></div></div>
		</div>

		<!-- Sin tarjeta: el título va directo sobre el cielo -->
		<div class="cabecera">
			<p data-saludo class="etiqueta">¡Estás invitado!</p>
			<h1 class="titulo">
				Trioland
				<span class="sr-only">· Trio Feliz, {fiesta.edicion}ª edición</span>
			</h1>
			<p class="chip" aria-hidden="true">Trio Feliz  {fiesta.edicion}ª edición</p>
		</div>

		<div class="sitio">
			<!-- Nenúfar y rana se mecen juntos -->
			<!-- Huevo de Pascua: el nenúfar de la primera sección no se toca (ver el script del final) -->
			<div class="mece" data-huevo role="button" tabindex="0" aria-label="Nenúfar de la rana. Mejor no tocarlo">
			<svg class="nenufar" viewBox="0 0 120 50" aria-hidden="true">
				<defs>
					<radialGradient id="hoja-1" cx="45%" cy="40%" r="70%">
						<stop offset="0" stop-color="#4fae5f"></stop>
						<stop offset="1" stop-color="#1d6b45"></stop>
					</radialGradient>
				</defs>
				<ellipse cx="60" cy="31" rx="56" ry="19" fill="rgb(6 40 38 / 0.6)"></ellipse>
				<path d="M60 25L115 21.5A56 20 0 1 0 115 28.5Z" fill="url(#hoja-1)" stroke="#14502f" stroke-width="1.2"></path>
			</svg>
			<div class="rana">
				<div class="flota">
					<Image
						src={saluda}
						alt="Una rana de juguete con corbata negra, cara de pocos amigos, que te saluda con una mano"
						widths={[300, 460, 640]}
						sizes="(min-width: 1024px) 211px, (min-width: 640px) 184px, 150px"
						format="webp"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</div>
			</div>
			<i class="onda"></i>
			<span class="gotas" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
			<p data-cta="antes" class="bocadillo der">Estoy bastante seguro de que no tienes nada mejor que hacer ese día... <br />Pasa, pasa… y no toques el nenúfar.</p>
			<p data-cta="fiesta" hidden class="bocadillo der">¡Hoy es! Saca el móvil, anda, que no se hacen fotos solas.</p>
			<p data-huevo-texto hidden class="bocadillo der"></p>
		</div>
	</section>

	<!-- ================= 2 · Cuándo y dónde ================= -->
	<section class="fase f1" aria-label="Cuándo y dónde">
		<svg class="ola" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true">
			<path d="M0 0H400V10C350 24 300 0 250 10C200 20 150 0 100 10C50 20 25 14 0 10Z"></path>
		</svg>
		<div class="arte" aria-hidden="true">
			<div class="astro"></div>
			<svg class="colinas lejos" viewBox="0 0 400 120" preserveAspectRatio="none">
				<path d="M0 120V70C40 40 80 30 130 55C180 80 220 20 280 35C330 48 370 60 400 40V120Z"></path>
			</svg>
			<svg class="colinas cerca" viewBox="0 0 400 120" preserveAspectRatio="none">
				<path d="M0 120V80C60 55 100 75 160 60C220 45 260 85 320 65C360 52 385 62 400 58V120Z"></path>
			</svg>
			<div class="agua"><div class="reflejos"></div></div>
		</div>

		<div class="carta">
			<dl class="panel">
				<div class="fila">
					<dt>Cuándo</dt>
					<dd class="primera-may">{fecha}</dd>
				</div>
				<div class="fila">
					<dt>Llegada</dt>
					<dd>Desde las {fiesta.llegada}</dd>
				</div>
				<div class="fila">
					<dt>Dónde</dt>
					<dd>
						<a href={fiesta.lugar.mapa} target="_blank" rel="noopener" class="subrayado">{fiesta.lugar.nombre}</a>
					</dd>
				</div>
			</dl>
			<div class="dos">
				<a href="/fiesta.ics" class="boton-borde"><span aria-hidden="true">📅</span> Al calendario</a>
				<a href={fiesta.lugar.mapa} target="_blank" rel="noopener" class="boton-borde"><span aria-hidden="true">📍</span> Cómo llegar</a>
			</div>
		</div>

		<div class="sitio">
			<!-- Nenúfar y rana se mecen juntos -->
			<div class="mece">
			<svg class="nenufar" viewBox="0 0 120 50" aria-hidden="true">
				<defs>
					<radialGradient id="hoja-2" cx="45%" cy="40%" r="70%">
						<stop offset="0" stop-color="#4fae5f"></stop>
						<stop offset="1" stop-color="#1d6b45"></stop>
					</radialGradient>
				</defs>
				<ellipse cx="60" cy="31" rx="56" ry="19" fill="rgb(6 40 38 / 0.6)"></ellipse>
				<path d="M60 25L115 21.5A56 20 0 1 0 115 28.5Z" fill="url(#hoja-2)" stroke="#14502f" stroke-width="1.2"></path>
				<g transform="translate(86 17)">
					<circle r="6" fill="#ff7fa8"></circle>
					<circle r="3" fill="#ffcf5c"></circle>
				</g>
			</svg>
			<div class="rana">
				<div class="flota">
					<Image
						src={mapa}
						alt="La misma rana consultando un mapa"
						widths={[300, 460, 640]}
						sizes="(min-width: 1024px) 211px, (min-width: 640px) 184px, 150px"
						format="webp"
						loading="lazy"
					/>
				</div>
			</div>
			</div>
			<i class="onda"></i>
			<p class="bocadillo izq">¿Otro año en mi puta casa?.</p>
		</div>
	</section>

	<!-- ================= 3 · Cuenta atrás y confirmar ================= -->
	<section class="fase f2" aria-label="Cuenta atrás">
		<svg class="ola" viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true">
			<path d="M0 0H400V10C350 24 300 0 250 10C200 20 150 0 100 10C50 20 25 14 0 10Z"></path>
		</svg>
		<div class="arte" aria-hidden="true">
			<div class="astro"></div>
			<svg class="colinas lejos" viewBox="0 0 400 120" preserveAspectRatio="none">
				<path d="M0 120V70C40 40 80 30 130 55C180 80 220 20 280 35C330 48 370 60 400 40V120Z"></path>
			</svg>
			<svg class="colinas cerca" viewBox="0 0 400 120" preserveAspectRatio="none">
				<path d="M0 120V80C60 55 100 75 160 60C220 45 260 85 320 65C360 52 385 62 400 58V120Z"></path>
			</svg>
			<svg class="guirnalda" viewBox="0 0 400 50" preserveAspectRatio="none">
				<path d="M0 6Q100 46 200 10Q300 46 400 6" fill="none" stroke="rgb(14 42 31 / 0.8)" stroke-width="1.5"></path>
				<circle cx="50" cy="21" r="4.5" fill="#ffcf5c"></circle>
				<circle cx="100" cy="27" r="4.5" fill="#ff7fa8"></circle>
				<circle cx="150" cy="23" r="4.5" fill="#c6f26b"></circle>
				<circle cx="250" cy="23" r="4.5" fill="#ffcf5c"></circle>
				<circle cx="300" cy="27" r="4.5" fill="#ff7fa8"></circle>
				<circle cx="350" cy="22" r="4.5" fill="#c6f26b"></circle>
			</svg>
			<div class="luciernagas">
				{luciernagas.map(([x, y, d]) => <i style={`left:${x}%;top:${y}%;--d:${d}s`}></i>)}
			</div>
			<div class="agua"><div class="reflejos"></div></div>
		</div>

		<div class="carta">
			<Contador />
			<div data-cta="antes" class="botones">
				<a href="#asistencia" class="boton">Confirmar asistencia</a>
				<a href="/participantes" class="boton-borde">Ver participantes</a>
			</div>
			<div data-cta="fiesta" hidden class="botones">
				<a href="/fotos" class="boton">📷 Sube tus fotos</a>
				<a href="/participantes" class="boton-borde">Ver participantes</a>
			</div>
		</div>

		<div class="sitio">
			<!-- Nenúfar y rana se mecen juntos -->
			<div class="mece">
			<svg class="nenufar" viewBox="0 0 120 50" aria-hidden="true">
				<defs>
					<radialGradient id="hoja-3" cx="45%" cy="40%" r="70%">
						<stop offset="0" stop-color="#4fae5f"></stop>
						<stop offset="1" stop-color="#1d6b45"></stop>
					</radialGradient>
				</defs>
				<ellipse cx="60" cy="31" rx="56" ry="19" fill="rgb(6 40 38 / 0.6)"></ellipse>
				<path d="M60 25L115 21.5A56 20 0 1 0 115 28.5Z" fill="url(#hoja-3)" stroke="#14502f" stroke-width="1.2"></path>
			</svg>
			<div class="rana">
				<div class="flota">
					<Image
						src={reloj}
						alt="La misma rana mirando la hora en su reloj"
						widths={[300, 460, 640]}
						sizes="(min-width: 1024px) 211px, (min-width: 640px) 184px, 150px"
						format="webp"
						loading="lazy"
					/>
				</div>
			</div>
			</div>
			<i class="onda"></i>
			<!-- El texto depende de si ha confirmado (data-resp: ninguna | si | no; lo decide el script del final).
			     El envoltorio con data-cta lo gestiona Portada (antes / día de la fiesta); los de dentro, el script. -->
			<div data-cta="antes">
				<p data-resp="ninguna" class="bocadillo der">Tic, tac… <br /> Es solo cuestión de tiempo... <br />¿Has confirmado ya o qué?</p>
				<p data-resp="si" hidden class="bocadillo der">Tic, tac… <br /> Ya estás apuntado, así me gusta. <br /> Y no llegues tarde.</p>
				<p data-resp="no" hidden class="bocadillo der">¿Que no vienes? Tú sabrás… Aún estás a tiempo de cambiar de opinión.</p>
			</div>
			<div data-cta="fiesta" hidden>
				<p data-resp="ninguna" class="bocadillo der">Es solo cuestión de tiempo</p>
				<p data-resp="si" hidden class="bocadillo der">Ya empezó y tú ya estabas apuntado. ¡A disfrutar!</p>
				<p data-resp="no" hidden class="bocadillo der">Dijiste que no venías… y aquí estás. Anda, pásate.</p>
			</div>
		</div>
	</section>
</div>

<style>
	.rec {
		--rw: 9rem; /* ancho de la rana */
		--agua: 3.4rem; /* altura de la línea de nenúfares sobre el borde inferior */
		--alto-agua: calc(var(--agua) + 4.5rem);
		color: var(--c-crema);
		background: #06353a;
	}

	/* =====================================================================
	   Cada sección es un cuadro: cielo, colinas, agua, tarjeta y rana
	   ===================================================================== */
	.fase {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		/* Cabe bajo la barra de arriba (3,5 rem) */
		min-height: calc(100svh - 3.5rem);
		/* Arriba aire; abajo sitio para el agua y la rana (alto de la imagen = 1,18 × ancho) */
		padding: 2.5rem 1rem calc(var(--alto-agua) + var(--rw) * 0.85);
	}

	.f0 {
		--cielo: linear-gradient(180deg, #3b3584 0%, #7d56a4 34%, #ff9aa8 66%, #ffd9a0 100%);
		--x: 28%;
		--desde: -75vw;
		--giro: -5deg;
		/* Algo más de aire abajo: el bocadillo de esta sección es largo y en móviles estrechos roza el chip */
		padding-bottom: calc(var(--alto-agua) + var(--rw) * 0.85 + 2.5rem);
	}
	.f1 {
		--cielo: linear-gradient(180deg, #3f6fb3 0%, #6f9fd0 38%, #f4a259 78%, #ffd37a 100%);
		--x: 72%;
		--desde: 75vw;
		--giro: 5deg;
	}
	.f2 {
		--cielo: linear-gradient(180deg, #060c24 0%, #1b1a55 55%, #2c3b6e 100%);
		--x: 28%; /* a un lado, para que el bocadillo quepa al otro */
		--desde: -75vw;
		--giro: -5deg;
	}

	.arte {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--cielo);
	}
	.arte > * {
		position: absolute;
	}

	/* Sol que se va poniendo → luna */
	.astro {
		width: 4rem;
		height: 4rem;
		border-radius: 9999px;
		background: #fff0b8;
		box-shadow: 0 0 40px 14px rgb(255 214 120 / 0.55);
	}
	.f0 .astro {
		right: 14%;
		bottom: calc(var(--alto-agua) + 4rem);
	}
	.f1 .astro {
		left: 12%;
		top: 7rem;
		background: #ffd27a;
	}
	.f2 .astro {
		right: 12%;
		top: 3.6rem;
		width: 3.4rem;
		height: 3.4rem;
		background: #f3f1e6;
		box-shadow: 0 0 30px 10px rgb(210 220 255 / 0.4);
	}

	.colinas {
		left: -10%;
		width: 120%;
		height: 9rem;
		bottom: calc(var(--alto-agua) - 1px);
	}
	.colinas.lejos {
		opacity: 0.55;
	}
	.colinas.lejos path {
		fill: #3a7d5a;
	}
	.colinas.cerca {
		height: 6.5rem;
	}
	.colinas.cerca path {
		fill: #1e5a3d;
	}

	.guirnalda {
		left: 0;
		top: 0;
		width: 100%;
		height: 2.4rem;
		filter: drop-shadow(0 0 6px rgb(255 214 120 / 0.9));
	}
	.luciernagas {
		inset: 0;
	}
	.luciernagas i {
		position: absolute;
		width: 6px;
		height: 6px;
		border-radius: 9999px;
		background: #e9ff9a;
		box-shadow: 0 0 10px 4px rgb(214 255 110 / 0.75);
		opacity: 0.6;
	}

	.agua {
		left: 0;
		right: 0;
		bottom: 0;
		height: var(--alto-agua);
		background: linear-gradient(180deg, #1aa497 0%, #0d6c6a 38%, #06353a 100%);
		border-top: 2px solid rgb(255 255 255 / 0.35);
		overflow: hidden;
	}
	.reflejos {
		position: absolute;
		inset: -3rem 0 0;
		background: repeating-linear-gradient(180deg, transparent 0 14px, rgb(255 255 255 / 0.1) 14px 16px);
	}

	/* Borde ondulado del agua de la sección anterior, que se asoma por arriba */
	.ola {
		position: absolute;
		left: 0;
		top: 0;
		z-index: 0;
		width: 100%;
		height: 1.4rem;
	}
	.ola path {
		fill: #06353a;
	}

	/* =====================================================================
	   Nenúfar y rana
	   ===================================================================== */
	.sitio {
		position: absolute;
		left: var(--x);
		bottom: calc(var(--agua) - 1.05rem);
		width: var(--rw);
		margin-left: calc(var(--rw) / -2);
		z-index: 1;
	}
	.mece {
		position: relative;
	}
	/* Huevo de Pascua: el nenúfar de la primera sección no se toca */
	.mece[data-huevo] {
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	.mece[data-huevo]:focus-visible {
		outline: 3px solid var(--c-lima);
		outline-offset: 4px;
		border-radius: 1rem;
	}
	/* Mientras la rana protesta, el bocadillo de siempre se aparta */
	.sitio.huevo [data-cta] {
		display: none;
	}
	.gotas {
		position: absolute;
		left: 14%;
		bottom: 0.4rem;
		width: 0;
		height: 0;
		pointer-events: none;
	}
	.gotas i {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 9999px;
		background: #c8f3ee;
		opacity: 0;
	}
	.nenufar {
		display: block;
		width: 100%;
		height: auto;
	}
	.onda {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.15rem;
		height: 1rem;
		border: 2px solid rgb(255 255 255 / 0.8);
		border-radius: 50%;
		opacity: 0;
		pointer-events: none;
	}
	.rana {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0.95rem;
		transform-origin: 50% 100%;
	}
	.rana :global(img) {
		display: block;
		width: 100%;
		height: auto;
		filter: drop-shadow(0 10px 12px rgb(0 0 0 / 0.45));
	}

	/* Bocadillo: junto a la cabeza de la rana, en el lado donde hay sitio (.der = a su derecha) */
	.bocadillo {
		position: absolute;
		bottom: calc(var(--rw) * 0.78);
		z-index: 2;
		width: max-content;
		max-width: min(11rem, calc(72vw - var(--rw) / 2 - 0.9rem));
		border: 2px solid #0a2217;
		border-radius: 1rem;
		background: var(--c-crema);
		color: var(--c-bosque);
		padding: 0.55rem 0.75rem;
		font-size: 0.84rem;
		font-weight: 800;
		line-height: 1.25;
		box-shadow: 0 4px 0 rgb(0 0 0 / 0.25);
	}
	.bocadillo[hidden] {
		display: none;
	}
	.bocadillo::after {
		content: '';
		position: absolute;
		bottom: 0.9rem;
		width: 0.8rem;
		height: 0.8rem;
		background: var(--c-crema);
		transform: rotate(45deg);
	}
	.bocadillo.der {
		left: 100%;
		margin-left: 0.5rem;
		transform-origin: 0 100%;
	}
	.bocadillo.der::after {
		left: -0.47rem;
		border-left: 2px solid #0a2217;
		border-bottom: 2px solid #0a2217;
	}
	.bocadillo.izq {
		right: 100%;
		margin-right: 0.5rem;
		transform-origin: 100% 100%;
	}
	.bocadillo.izq::after {
		right: -0.47rem;
		border-right: 2px solid #0a2217;
		border-top: 2px solid #0a2217;
	}

	/* =====================================================================
	   Tarjetas (legibles sobre cualquier cielo)
	   ===================================================================== */
	.carta {
		position: relative;
		width: 100%;
		max-width: 30rem;
		border-radius: 1.25rem;
		border: 2px solid rgb(198 242 107 / 0.45);
		background: rgb(8 30 22 / 0.72);
		backdrop-filter: blur(6px);
		padding: 1.4rem 1.1rem 1.25rem;
		box-shadow: 0 10px 30px rgb(0 0 0 / 0.3);
	}
	/* Cabecera de la sección 1: título enorme, centrado, sin caja */
	.cabecera {
		width: 100%;
		max-width: 56rem;
		text-align: center;
	}
	.etiqueta {
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--c-lima);
		text-shadow: 0 1px 8px rgb(8 30 22 / 0.9);
	}
	.titulo {
		margin-top: 0.2rem;
		font-family: var(--font-sans);
		font-stretch: 100%;
		font-weight: 900;
		text-transform: none;
		letter-spacing: -0.03em;
		line-height: 0.95;
		/* Una línea: "Trioland" mide ~4,15 em, así que 22vw llena el ancho útil del móvil */
		font-size: clamp(3rem, 22vw, 11rem);
		color: var(--c-crema);
		text-shadow:
			0 0.035em 0 var(--c-hoja),
			0 0.07em 0 #0a2217,
			0 0.14em 0.3em rgb(0 0 0 / 0.45);
	}
	.chip {
		display: inline-block;
		margin-top: 0.8rem;
		border-radius: 9999px;
		background: var(--c-lima);
		color: var(--c-bosque);
		padding: 0.25rem 0.8rem;
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.panel {
		border-radius: 0.9rem;
		border: 1px solid rgb(198 242 107 / 0.3);
		background: rgb(255 244 214 / 0.05);
	}
	.fila {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.7rem 1rem;
		font-size: 0.95rem;
	}
	.fila + .fila {
		border-top: 1px dashed rgb(255 244 214 / 0.25);
	}
	.fila dt {
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--c-lima);
	}
	.fila dd {
		text-align: right;
		font-weight: 700;
	}
	.primera-may::first-letter {
		text-transform: uppercase;
	}
	.subrayado {
		text-decoration: underline;
		text-decoration-color: var(--c-flor);
		text-underline-offset: 4px;
	}

	.dos {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.6rem;
		margin-top: 0.8rem;
	}
	.botones {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin-top: 1rem;
	}
	.boton,
	.boton-borde {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		border-radius: 9999px;
		padding: 0.8rem 1.2rem;
		font-size: 0.9rem;
		font-weight: 900;
		text-align: center;
		transition:
			transform 0.15s,
			background-color 0.15s;
	}
	.boton {
		background: var(--c-lima);
		color: var(--c-bosque);
		box-shadow: 0 4px 0 #6fa72f;
	}
	.boton:hover {
		transform: translateY(-2px);
	}
	.boton:active {
		transform: translateY(3px);
		box-shadow: none;
	}
	.boton-borde {
		border: 2px solid rgb(255 244 214 / 0.7);
		color: var(--c-crema);
		background: rgb(8 30 22 / 0.35);
	}
	.boton-borde:hover,
	.boton-borde:active {
		background: rgb(255 244 214 / 0.18);
	}

	/* ===== Pantallas más grandes ===== */
	@media (min-width: 640px) {
		.rec {
			--rw: 11.5rem;
		}
		.fase {
			padding-top: 4rem;
		}
		.carta {
			padding: 1.8rem 1.6rem 1.6rem;
		}
		.bocadillo {
			max-width: 14rem;
			padding: 0.7rem 0.95rem;
			font-size: 1rem;
		}
		.astro {
			width: 5rem;
			height: 5rem;
		}
		.colinas {
			height: 12rem;
		}
		.colinas.cerca {
			height: 8.5rem;
		}
	}
	@media (min-width: 1024px) {
		.rec {
			--rw: 13.2rem;
			--agua: 4rem;
		}
		.f0 {
			--x: 22%;
		}
		.f0 .bocadillo {
			max-width: 20rem; /* hay sitio: menos líneas */
		}
		.f1 {
			--x: 78%;
		}
	}

	/* =====================================================================
	   Animación: solo si hay JS y no se pidió "reducir movimiento".
	   El script marca .rec[data-anim] y, al entrar cada sección, le pone .dentro.
	   ===================================================================== */
	@media (prefers-reduced-motion: no-preference) {
		.reflejos {
			animation: reflejos 5s linear infinite;
		}
		/* Nenúfar y rana se mecen juntos */
		.mece {
			animation: mecer 6s ease-in-out infinite;
		}
		.f1 .mece {
			animation-delay: -2s;
		}
		.f2 .mece {
			animation-delay: -4s;
		}
		.luciernagas i {
			animation: parpadeo 2.6s ease-in-out infinite;
			animation-delay: var(--d);
		}
		.titulo {
			animation: flotar 4.5s ease-in-out 1.3s infinite;
		}

		/* Antes de entrar: la tarjeta, la rana y el astro están "fuera" */
		.rec[data-anim] .fase:not(.dentro) .carta,
		.rec[data-anim] .fase:not(.dentro) .cabecera {
			opacity: 0;
			translate: 0 1.5rem;
		}
		.rec[data-anim] .fase:not(.dentro) .rana {
			visibility: hidden;
		}
		.rec[data-anim] .fase:not(.dentro) .bocadillo {
			opacity: 0;
			scale: 0.5;
		}
		.rec[data-anim] .fase .bocadillo {
			/* Sale cuando la rana ya ha aterrizado */
			transition:
				opacity 0.25s ease 1.5s,
				scale 0.45s cubic-bezier(0.3, 1.6, 0.5, 1) 1.5s;
		}
		.rec[data-anim] .fase:not(.dentro) .astro {
			translate: 0 4rem;
			opacity: 0;
		}
		.rec[data-anim] .fase:not(.dentro) .guirnalda,
		.rec[data-anim] .fase:not(.dentro) .luciernagas {
			opacity: 0;
		}

		/* Al entrar: sube el astro, aparece la tarjeta y la rana salta al nenúfar */
		.rec[data-anim] .fase .carta,
		.rec[data-anim] .fase .cabecera {
			transition:
				opacity 0.6s ease,
				translate 0.7s cubic-bezier(0.2, 0.7, 0.3, 1);
		}
		.rec[data-anim] .fase .astro {
			transition:
				translate 1.6s ease-out,
				opacity 1s ease;
		}
		.rec[data-anim] .fase .guirnalda,
		.rec[data-anim] .fase .luciernagas {
			transition: opacity 1.4s ease 0.5s;
		}
		.rec[data-anim] .fase.dentro .rana {
			animation: salto 1.1s both;
		}
		.rec[data-anim] .fase.dentro .onda {
			animation: onda 1.3s ease-out 0.85s;
		}
	}

	/* ===== Fotogramas ===== */
	/* La rana viene de fuera del cuadro (--desde), sube en arco y cae con un chafón */
	@keyframes salto {
		0% {
			transform: translate(var(--desde), 0);
			animation-timing-function: cubic-bezier(0.2, 0.7, 0.4, 1);
		}
		50% {
			transform: translate(calc(var(--desde) * 0.4), -8rem) rotate(var(--giro)) scale(0.95, 1.07);
			animation-timing-function: cubic-bezier(0.6, 0, 0.8, 0.5);
		}
		80% {
			transform: translate(0, 0) scale(1.12, 0.86);
			animation-timing-function: ease-out;
		}
		100% {
			transform: translate(0, 0);
		}
	}
	@keyframes onda {
		0% {
			opacity: 0.9;
			transform: scale(0.6);
		}
		100% {
			opacity: 0;
			transform: scale(1.7);
		}
	}
	@keyframes reflejos {
		to {
			transform: translateY(1.9rem);
		}
	}
	@keyframes flotar {
		50% {
			transform: translateY(-0.5rem) rotate(0.8deg);
		}
	}
	@keyframes mecer {
		50% {
			transform: translateY(0.25rem) rotate(1.2deg);
		}
	}
	@keyframes parpadeo {
		0%,
		100% {
			opacity: 0.15;
			transform: translate(0, 0);
		}
		50% {
			opacity: 1;
			transform: translate(6px, -8px);
		}
	}
</style>

<script>
	// Cada sección que entra en pantalla reproduce su entrada (la rana salta, aparece la tarjeta).
	// Solo se hace una vez por sección. Sin IntersectionObserver o con "reducir movimiento"
	// no se marca nada y todo se ve ya colocado.
	const rec = document.querySelector<HTMLElement>('.rec');
	const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (rec && !quieto && 'IntersectionObserver' in window) {
		rec.dataset.anim = '';
		const obs = new IntersectionObserver(
			(entradas) => {
				for (const e of entradas) {
					if (!e.isIntersecting) continue;
					e.target.classList.add('dentro');
					obs.unobserve(e.target);
				}
			},
			{ threshold: 0.25 },
		);
		rec.querySelectorAll('.fase').forEach((f) => obs.observe(f));
	}

	// ===== Huevo de Pascua: «no toques el nenúfar» =====
	// En la primera sección la rana avisa de que no se toque el nenúfar. Si se toca, protesta (dos avisos,
	// cada vez más nerviosa) y a la tercera se cae al agua con salpicaduras; después vuelve a subirse
	// empapada. Cada vez que cae cambian los textos. Con «reducir movimiento» solo cambia el bocadillo.
	const huevo = rec?.querySelector<HTMLElement>('[data-huevo]');
	if (huevo) {
		const sitio = huevo.closest<HTMLElement>('.sitio')!;
		const ranaEl = huevo.querySelector<HTMLElement>('.rana')!;
		const hoja = huevo.querySelector<SVGElement>('.nenufar')!;
		const onda = sitio.querySelector<HTMLElement>('.onda')!;
		const gotas = [...sitio.querySelectorAll<HTMLElement>('.gotas i')];
		const texto = sitio.querySelector<HTMLElement>('[data-huevo-texto]')!;

		const rondas = [
			{ avisos: ['¡Eh! ¡Que no se toca!', 'Te lo advierto: una más y me caigo.'], caida: '¡NOOOO…!', vuelta: 'Ya te vale. Mira cómo me has puesto.' },
			{ avisos: ['¿En serio? ¿Otra vez?', 'Ni se te ocurra.'], caida: '¡¡¡TE ODIOOO…!!!', vuelta: 'Me mudo a otro nenúfar. Este está gafado.' },
			{ avisos: ['Esto es acoso a una rana.', 'Que no. Que no. Que no.'], caida: '¡PLOOOF!', vuelta: 'Vale, tú ganas. Disfruta del nenúfar.' },
		];
		let toques = 0;
		let ronda = 0;
		let ocupado = false;
		let callarEn: number | undefined;
		let enfriarEn: number | undefined;
		const espera = (ms: number) => new Promise((ok) => setTimeout(ok, ms));

		function decir(t: string, ms = 0) {
			texto.textContent = t;
			texto.hidden = false;
			sitio.classList.add('huevo');
			clearTimeout(callarEn);
			if (ms) callarEn = window.setTimeout(callar, ms);
		}
		function callar() {
			texto.hidden = true;
			sitio.classList.remove('huevo');
		}

		// La rana y el nenúfar se tambalean (más fuerte cuantos más toques)
		function bambolear(fuerza: number) {
			hoja.animate(
				[
					{ transform: 'rotate(0)' },
					{ transform: `rotate(${-fuerza}deg)` },
					{ transform: `rotate(${fuerza * 0.8}deg)` },
					{ transform: `rotate(${-fuerza * 0.4}deg)` },
					{ transform: 'rotate(0)' },
				],
				{ duration: 500, easing: 'ease-in-out' },
			);
			ranaEl.animate(
				[
					{ transform: 'rotate(0)' },
					{ transform: `rotate(${fuerza * 1.4}deg)` },
					{ transform: `rotate(${-fuerza}deg)` },
					{ transform: `rotate(${fuerza * 0.5}deg)` },
					{ transform: 'rotate(0)' },
				],
				{ duration: 500, easing: 'ease-in-out' },
			);
		}

		// Ondas y gotas donde cae
		function salpicar() {
			[1.8, 2.5, 3.2].forEach((fin, i) =>
				onda.animate(
					[
						{ opacity: 0.9, transform: 'scale(0.6)' },
						{ opacity: 0, transform: `scale(${fin})` },
					],
					{ duration: 1200, delay: i * 180, easing: 'ease-out' },
				),
			);
			gotas.forEach((g, i) => {
				const dx = (i - 2.5) * 0.9;
				const alto = 2.6 + (i % 3) * 0.8;
				g.animate(
					[
						{ transform: 'translate(0, 0)', opacity: 1 },
						{ transform: `translate(${dx}rem, ${-alto}rem)`, opacity: 1, offset: 0.5 },
						{ transform: `translate(${dx * 1.6}rem, 0.8rem)`, opacity: 0 },
					],
					{ duration: 850, delay: i * 40, easing: 'ease-out' },
				);
			});
		}

		async function caer(r: (typeof rondas)[number]) {
			ocupado = true;
			decir(r.caida);
			hoja.animate(
				[
					{ transform: 'rotate(0)' },
					{ transform: 'rotate(14deg) translateY(4px)', offset: 0.25 },
					{ transform: 'rotate(-8deg)', offset: 0.6 },
					{ transform: 'rotate(0)' },
				],
				{ duration: 900, easing: 'ease-in-out' },
			);
			// Se tambalea, resbala hacia la izquierda (el bocadillo está a la derecha) y se hunde
			const caida = ranaEl.animate(
				[
					{ transform: 'translate(0, 0) rotate(0)', opacity: 1, offset: 0 },
					{ transform: 'translate(-0.4rem, -0.5rem) rotate(-14deg)', opacity: 1, offset: 0.18 },
					{ transform: 'translate(-2.8rem, 0.4rem) rotate(-55deg)', opacity: 1, offset: 0.4 },
					{ transform: 'translate(-4.2rem, 5.2rem) rotate(-130deg) scale(0.9)', opacity: 1, offset: 0.72 },
					{ transform: 'translate(-4.6rem, 7.4rem) rotate(-170deg) scale(0.7)', opacity: 0, offset: 1 },
				],
				{ duration: 1100, easing: 'ease-in', fill: 'forwards' },
			);
			setTimeout(salpicar, 800);
			await caida.finished;
			await espera(1500);

			// Vuelve a subirse al nenúfar de un salto, empapada
			decir(r.vuelta, 3800);
			ranaEl.animate(
				[
					{ transform: 'translate(0, 5rem) scale(0.8)', opacity: 0, offset: 0 },
					{ transform: 'translate(0, -6.5rem) rotate(-6deg) scale(0.95, 1.07)', opacity: 1, offset: 0.5 },
					{ transform: 'translate(0, 0) scale(1.12, 0.86)', opacity: 1, offset: 0.82 },
					{ transform: 'translate(0, 0)', opacity: 1, offset: 1 },
				],
				{ duration: 900, easing: 'ease-in-out' },
			);
			caida.cancel();
			salpicar();
			await espera(900);
			ocupado = false;
		}

		function tocar() {
			if (ocupado) return;
			const r = rondas[ronda % rondas.length];
			toques++;
			// Si dejas de tocar un rato, se le pasa el susto
			clearTimeout(enfriarEn);
			enfriarEn = window.setTimeout(() => (toques = 0), 7000);

			if (toques <= r.avisos.length) {
				if (!quieto) bambolear(toques * 4 + 4);
				decir(r.avisos[toques - 1], 3500);
				return;
			}
			toques = 0;
			ronda++;
			if (quieto) decir(r.vuelta, 3500);
			else caer(r);
		}
		huevo.addEventListener('click', tocar);
		huevo.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				tocar();
			}
		});
	}

	// Bocadillo de la sección 3 según haya confirmado o no. Se lee con obtenerAsistencia() (hoy en el
	// móvil; cuando B4 lo conecte a la BD no hay que cambiar nada aquí). Se actualiza al cargar y cada
	// vez que la sección 3 vuelve a verse (por si ha confirmado más abajo, en la sección de asistencia).
	import { obtenerAsistencia } from '../rsvp/datos';

	const f2 = rec?.querySelector<HTMLElement>('.f2');
	async function actualizarBocadillo() {
		if (!f2) return;
		const a = await obtenerAsistencia().catch(() => null);
		const resp = a === null ? 'ninguna' : a.asiste ? 'si' : 'no';
		f2.querySelectorAll<HTMLElement>('[data-resp]').forEach((p) => (p.hidden = p.dataset.resp !== resp));
	}
	if (f2) {
		actualizarBocadillo();
		if ('IntersectionObserver' in window) {
			new IntersectionObserver((e) => e.some((x) => x.isIntersecting) && actualizarBocadillo(), { threshold: 0.25 }).observe(f2);
		}
	}
</script>
