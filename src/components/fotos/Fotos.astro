---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import fiesta from '../../data/fiesta.json';
import trio from '../../data/trio.json';
import FotosDemo from '../cromos/FotosDemo.astro';
import huerto1 from '../../assets/demo/huerto1.jpeg';
import huerto2 from '../../assets/demo/huerto2.jpeg';
import fiestaEnrique from '../../assets/demo/enrique_fiesta.png';
import fotoTrio from '../../assets/foto_trio.jpg';
import { MAX_DESCRIPCION } from './datos';

// Fotos de la fiesta al estilo de una red social de 2008: cada invitado publica desde su perfil
// (foto y nombre de su cromo) con un pie de foto, y el muro enseña lo que va subiendo la gente.
// El estado depende de la hora, así que se calcula en el navegador.

// TODO(B7): quitar el muro de ejemplo cuando exista `listar_fotos`. La primera es la que "llega" en directo.
const lema = (slug: string) => trio.find((p) => p.slug === slug)?.lema ?? slug;
const muroDemo = await Promise.all(
	(
		[
			[huerto2, 'fran', lema('fran'), 'Llegando con el hielo, que sin mí no hay fiesta 🧊', 0],
			[fotoTrio, 'juan', lema('juan'), 'Los tres cumpleañeros antes de que empiece el lío', 6],
			[fiestaEnrique, 'pencho', lema('pencho'), 'Esto a las 3 de la mañana. No preguntéis', 47],
			[huerto1, 'juan', lema('juan'), '', 180],
		] as const
	).map(async ([src, id, nombre, descripcion, minutos], i) => ({
		id: `demo-${i}`,
		url: (await getImage({ src: src as ImageMetadata, width: 1200, format: 'webp' })).src,
		descripcion,
		minutos,
		autor: { id, nombre, foto: null },
	})),
);

const formato = (iso: string) =>
	new Intl.DateTimeFormat('es-ES', {
		weekday: 'long',
		day: 'numeric',
		month: 'long',
		hour: '2-digit',
		minute: '2-digit',
		timeZone: fiesta.zonaHoraria,
	}).format(new Date(iso));

// Piezas de estilo de la época: cajas con cabecera celeste y botones con degradado
const caja = 'overflow-hidden rounded-[3px] border border-[#c5d3e2] bg-white';
const cabecera = 'flex items-center justify-between gap-2 border-b border-[#c5d3e2] bg-gradient-to-b from-[#f4f7fb] to-[#e2eaf4] px-3 py-2';
const botonAzul =
	'inline-flex h-10 items-center justify-center gap-1.5 rounded-[3px] border border-[#2a5482] bg-gradient-to-b from-[#5b8cc1] to-[#3b6ea5] px-4 text-[13px] font-bold text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.35)] active:from-[#3b6ea5] active:to-[#3b6ea5] disabled:opacity-50';
---

<FotosDemo />
<script type="application/json" id="fotos-galeria-demo" set:html={JSON.stringify(muroDemo)} />

<div data-carrete data-desde={fiesta.fotos.abiertasDesde} data-hasta={fiesta.fotos.abiertasHasta} class="space-y-3 text-[13px] leading-snug">
	<!-- Subir fotos -->
	<section class={caja} aria-labelledby="fotos-subir">
		<div class={cabecera}>
			<h2 id="fotos-subir" class="text-[13px] font-bold text-granate-oscuro">Subir fotos</h2>
			<span class="text-[11px] text-tinta-suave">a «Fiesta Trio Feliz»</span>
		</div>

		<div class="flex items-center gap-3 p-3">
			<span data-avatar="yo" class="size-12 shrink-0 block overflow-hidden rounded-[2px] border border-[#c5d3e2] bg-white p-px"></span>
			<p class="min-w-0">
				<span data-mi-nombre class="block truncate font-bold text-granate">…</span>
				<span class="text-[11px] text-tinta-suave">Publicas con la foto y el nombre de tu cromo</span>
			</p>
		</div>

		<div data-estado="proximamente" hidden class="border-t border-dashed border-[#d6dee8] px-3 py-4 text-center">
			<p class="font-bold text-tinta">📷 El álbum aún está cerrado</p>
			<p class="mt-1 text-tinta-suave">
				Se abre el <strong class="first-letter:uppercase">{formato(fiesta.fotos.abiertasDesde)}</strong>.
			</p>
		</div>

		<div data-estado="cerrado" hidden class="border-t border-dashed border-[#d6dee8] px-3 py-4 text-center text-tinta-suave">
			El álbum ya está cerrado. ¡Gracias por las fotos!
		</div>

		<div data-estado="abierto" hidden class="border-t border-dashed border-[#d6dee8] p-3">
			<!-- Borradores: cada foto con su pie antes de publicar -->
			<ul data-borradores class="space-y-3"></ul>

			<div class="grid grid-cols-2 gap-2">
				<label data-elegir class:list={[botonAzul, 'cursor-pointer']}>
					<span aria-hidden="true">📷</span> Hacer foto
					<!-- capture: abre la cámara directamente (una foto cada vez) -->
					<input data-subir type="file" accept="image/*" capture="environment" class="sr-only" />
				</label>
				<label data-elegir class:list={[botonAzul, 'cursor-pointer']}>
					<span aria-hidden="true">🖼️</span> De la galería
					<input data-subir type="file" accept="image/*" multiple class="sr-only" />
				</label>
			</div>
			<div data-publicar-fila hidden class="mt-3 flex items-center gap-2 border-t border-dashed border-[#d6dee8] pt-3">
				<button type="button" data-publicar class:list={[botonAzul, 'flex-1']}>Publicar</button>
				<button type="button" data-cancelar class="h-10 px-2 text-[13px] text-granate underline underline-offset-2">Cancelar</button>
			</div>
			<p data-aviso role="status" class="mt-2 min-h-4 text-[12px] font-bold text-extra"></p>
			<p class="text-[11px] text-tinta-suave">
				Abierto hasta el <span class="first-letter:lowercase">{formato(fiesta.fotos.abiertasHasta)}</span>
			</p>
		</div>
	</section>

	<!-- Muro -->
	<section data-muro-caja hidden class={caja} aria-labelledby="fotos-muro">
		<div class={cabecera}>
			<h2 id="fotos-muro" class="text-[13px] font-bold text-granate-oscuro">
				Novedades de la fiesta <span class="font-normal text-tinta-suave">(<span data-cuenta>0</span> fotos)</span>
			</h2>
			<div class="flex shrink-0 text-[12px]" role="group" aria-label="Vista">
				<button type="button" data-vista="muro" aria-pressed="true" class="px-1.5 py-1 text-granate aria-pressed:font-bold aria-pressed:text-tinta">Muro</button>
				<span class="py-1 text-tinta-suave" aria-hidden="true">·</span>
				<button type="button" data-vista="album" aria-pressed="false" class="px-1.5 py-1 text-granate aria-pressed:font-bold aria-pressed:text-tinta">Álbum</button>
			</div>
		</div>

		<!-- Aviso de fotos nuevas en directo -->
		<button
			type="button"
			data-nuevas
			hidden
			class="flex w-full items-center justify-center gap-2 border-b border-[#e6d58a] bg-[#fff8cc] px-3 py-2.5 font-bold text-[#6b5a00]"
		>
			<span aria-hidden="true">🔔</span> <span data-nuevas-texto></span>
		</button>

		<ul data-muro class="divide-y divide-[#e3e9f0]"></ul>
		<ul data-album hidden class="grid grid-cols-3 gap-1 p-1 sm:grid-cols-4"></ul>
		<p data-vacio hidden class="px-3 py-6 text-center text-tinta-suave">Aún no ha subido nadie nada. ¡Estrena el álbum!</p>
	</section>
</div>

<template data-plantilla-borrador>
	<li class="flex gap-3">
		<img alt="" class="size-20 shrink-0 rounded-[2px] border border-[#c5d3e2] bg-[#f3f3f3] object-cover p-0.5" />
		<div class="min-w-0 flex-1">
			<textarea
				data-descripcion
				rows="3"
				maxlength={MAX_DESCRIPCION}
				placeholder="Escribe algo sobre esta foto…"
				class="block w-full resize-none rounded-[2px] border border-[#b7c6d8] bg-white px-2 py-1.5 text-[13px] text-tinta shadow-[inset_0_1px_2px_rgb(0_0_0/0.08)] placeholder:text-[#aaa] focus:border-granate focus:outline-none"
			></textarea>
			<div class="mt-1 flex items-center justify-between text-[11px]">
				<span data-estado-subida class="font-bold text-tinta-suave"><span data-quedan>{MAX_DESCRIPCION}</span> caracteres</span>
				<button type="button" data-quitar class="px-1 py-1 text-granate hover:underline">Quitar</button>
			</div>
		</div>
	</li>
</template>

<template data-plantilla-publicacion>
	<li class="p-3">
		<div class="flex items-start gap-2.5">
			<span data-avatar class="size-10 shrink-0 block overflow-hidden rounded-[2px] border border-[#c5d3e2] bg-white p-px"></span>
			<div class="min-w-0 flex-1">
				<p><span data-autor class="font-bold text-granate"></span> <span class="text-tinta">ha subido una foto.</span></p>
				<p class="text-[11px] text-tinta-suave"><span data-hace></span> · Fiesta Trio Feliz</p>
			</div>
		</div>
		<p data-pie class="mt-2 border-l-[3px] border-[#c5d3e2] pl-2 text-tinta"></p>
		<button type="button" data-ver class="mt-2 block w-full overflow-hidden rounded-[2px] border border-[#dde4ec] bg-[#f6f6f6] p-1 active:opacity-80">
			<img data-foto alt="" loading="lazy" class="mx-auto max-h-[70dvh] min-h-40 w-full object-contain" />
		</button>
		<p class="mt-1.5 flex gap-3 text-[11px]">
			<button type="button" data-ver-grande class="py-1 text-granate hover:underline">Ver en grande</button>
			<button type="button" data-bajar class="py-1 text-granate hover:underline">Descargar</button>
			<button type="button" data-borrar hidden class="ml-auto py-1 text-[#c0504d] hover:underline">Borrar</button>
		</p>
	</li>
</template>

<template data-plantilla-miniatura>
	<li>
		<button type="button" class="block aspect-square w-full overflow-hidden rounded-[2px] border border-[#dde4ec] bg-[#f3f3f3] p-0.5 active:opacity-80">
			<img alt="" loading="lazy" class="size-full object-cover" />
		</button>
	</li>
</template>

<!-- Visor a pantalla completa: se desliza entre fotos -->
<dialog
	data-visor
	aria-label="Visor de fotos"
	class="m-0 h-dvh max-h-none w-screen max-w-none overflow-hidden border-0 bg-black p-0 text-white backdrop:bg-black"
>
	<div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between gap-2 bg-gradient-to-b from-black/80 to-transparent px-3 pb-6 pt-[max(0.75rem,env(safe-area-inset-top))]">
		<span data-contador class="text-sm font-bold"></span>
		<div class="flex items-center gap-2">
			<button type="button" data-descargar class="rounded-[3px] bg-white/15 px-3 py-2 text-sm font-bold">Descargar</button>
			<form method="dialog">
				<button class="flex size-10 items-center justify-center rounded-full bg-white/15 text-lg font-bold" aria-label="Cerrar">✕</button>
			</form>
		</div>
	</div>
	<ul data-pista class="flex h-full snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"></ul>
</dialog>

<template data-plantilla-diapositiva>
	<li class="relative grid h-full w-screen shrink-0 snap-center place-items-center">
		<img data-foto alt="" class="max-h-[80dvh] max-w-full object-contain" />
		<div class="absolute inset-x-0 bottom-0 flex items-start gap-2.5 bg-gradient-to-t from-black/85 to-transparent px-4 pb-[max(1rem,env(safe-area-inset-bottom))] pt-10 text-[13px]">
			<span data-avatar class="size-9 shrink-0 block overflow-hidden rounded-[2px] border border-[#c5d3e2] bg-white p-px"></span>
			<p class="min-w-0">
				<span data-autor class="font-bold"></span>
				<span data-pie class="block text-white/85"></span>
			</p>
		</div>
	</li>
</template>

<script>
	import { estadoFotos } from './ventana';
	import { listarFotos, subirFoto, borrarFoto, escucharFotos, perfilActual, MAX_DESCRIPCION, type Foto, type Perfil } from './datos';
	import { reducirImagen } from './imagen';
	import { EXIGIR_REGISTRO } from '../registro/sesion';

	const raiz = document.querySelector<HTMLElement>('[data-carrete]')!;
	const $ = <T extends HTMLElement = HTMLElement>(sel: string, el: ParentNode = raiz) => el.querySelector<T>(sel)!;
	const plantilla = (nombre: string) =>
		document.querySelector<HTMLTemplateElement>(`[data-plantilla-${nombre}]`)!.content.firstElementChild!.cloneNode(true) as HTMLElement;

	// --- Avatar: foto del cromo o, si no tiene, sus iniciales sobre un color fijo por persona ---
	const COLORES = ['#3b6ea5', '#5fa83b', '#c0504d', '#8064a2', '#e08a1e', '#2c9c9c'];
	function pintarAvatar(hueco: HTMLElement, perfil: Perfil) {
		if (perfil.foto) {
			const img = Object.assign(document.createElement('img'), { src: perfil.foto, alt: '', className: 'size-full object-cover' });
			hueco.replaceChildren(img);
		} else {
			const iniciales = perfil.nombre
				.split(/\s+/)
				.slice(0, 2)
				.map((p) => p[0])
				.join('')
				.toUpperCase();
			const color = COLORES[[...perfil.id].reduce((s, c) => s + c.charCodeAt(0), 0) % COLORES.length];
			const span = Object.assign(document.createElement('span'), { textContent: iniciales, className: 'grid size-full place-items-center text-[0.8rem] font-bold text-white' });
			span.style.background = color;
			hueco.replaceChildren(span);
		}
	}

	// --- "hace 5 minutos" ---
	const relativo = new Intl.RelativeTimeFormat('es', { numeric: 'auto' });
	function hace(iso: string) {
		const s = (Date.now() - new Date(iso).getTime()) / 1000;
		if (s < 45) return 'hace un momento';
		if (s < 3600) return relativo.format(-Math.round(s / 60), 'minute');
		if (s < 86400) return relativo.format(-Math.round(s / 3600), 'hour');
		return relativo.format(-Math.round(s / 86400), 'day');
	}
	const refrescarTiempos = () => raiz.querySelectorAll<HTMLElement>('[data-hace]').forEach((el) => (el.textContent = hace(el.dataset.iso!)));
	setInterval(refrescarTiempos, 60_000);

	// --- Estado según fechas (en pruebas se puede forzar con ?carrete=abierto|cerrado|proximamente) ---
	// TODO: de momento el álbum se enseña siempre abierto. Para respetar las fechas de fiesta.json, poner a false.
	const SIEMPRE_ABIERTO = true;
	const forzado = new URLSearchParams(location.search).get('carrete');
	const estado =
		(import.meta.env.DEV || !EXIGIR_REGISTRO) && forzado
			? forzado
			: SIEMPRE_ABIERTO
				? 'abierto'
				: estadoFotos({ abiertasDesde: raiz.dataset.desde, abiertasHasta: raiz.dataset.hasta });
	raiz.querySelectorAll<HTMLElement>('[data-estado]').forEach((el) => (el.hidden = el.dataset.estado !== estado));

	const yo = await perfilActual();
	$('[data-mi-nombre]').textContent = yo.nombre;
	pintarAvatar($('[data-avatar="yo"]'), yo);

	// --- Muro y álbum ---
	const muro = $<HTMLUListElement>('[data-muro]');
	const album = $<HTMLUListElement>('[data-album]');
	let fotos: Foto[] = [];

	function publicacion(f: Foto, nueva = false) {
		const li = plantilla('publicacion');
		pintarAvatar($('[data-avatar]', li), f.autor);
		$('[data-autor]', li).textContent = f.autor.nombre;
		const cuando = $('[data-hace]', li);
		cuando.dataset.iso = f.creada;
		cuando.textContent = hace(f.creada);
		const pie = $('[data-pie]', li);
		pie.textContent = f.descripcion;
		pie.hidden = !f.descripcion;
		const img = $<HTMLImageElement>('[data-foto]', li);
		img.src = f.url;
		img.alt = f.descripcion || `Foto de ${f.autor.nombre}`;
		const abrir = () => abrirVisor(fotos.indexOf(f));
		$('[data-ver]', li).addEventListener('click', abrir);
		$('[data-ver-grande]', li).addEventListener('click', abrir);
		$('[data-bajar]', li).addEventListener('click', () => descargar(f));
		const borrar = $<HTMLButtonElement>('[data-borrar]', li);
		borrar.hidden = f.autor.id !== yo.id;
		borrar.addEventListener('click', () => quitarFoto(f, li, borrar));
		nodos.set(f.id, { muro: li });
		if (nueva) {
			li.style.background = '#fff8cc';
			li.style.transition = 'background 2s';
			setTimeout(() => (li.style.background = ''), 1200);
		}
		return li;
	}

	function miniatura(f: Foto) {
		const li = plantilla('miniatura');
		const img = $<HTMLImageElement>('img', li);
		img.src = f.url;
		img.alt = f.descripcion || `Foto de ${f.autor.nombre}`;
		$('button', li).addEventListener('click', () => abrirVisor(fotos.indexOf(f)));
		nodos.set(f.id, { ...nodos.get(f.id)!, album: li });
		return li;
	}

	// Solo quien la subió ve "Borrar"; la BD vuelve a comprobarlo
	const nodos = new Map<string, { muro: HTMLElement; album?: HTMLElement }>();
	async function quitarFoto(f: Foto, li: HTMLElement, boton: HTMLButtonElement) {
		if (!confirm('¿Borrar esta foto? Desaparecerá para todos.')) return;
		boton.disabled = true;
		boton.textContent = 'Borrando…';
		try {
			await borrarFoto(f.id);
			fotos = fotos.filter((x) => x !== f);
			li.remove();
			nodos.get(f.id)?.album?.remove();
			nodos.delete(f.id);
			contar();
		} catch {
			boton.disabled = false;
			boton.textContent = 'No se ha podido borrar';
		}
	}

	function contar() {
		$('[data-cuenta]').textContent = String(fotos.length);
		$('[data-vacio]').hidden = fotos.length > 0;
	}

	function pintarTodo() {
		muro.replaceChildren(...fotos.map((f) => publicacion(f)));
		album.replaceChildren(...fotos.map(miniatura));
		contar();
	}

	// Añade arriba sin repintar el resto (no se pierde la posición de lectura)
	function anadirArriba(nuevas: Foto[]) {
		fotos = [...nuevas, ...fotos];
		muro.prepend(...nuevas.map((f) => publicacion(f, true)));
		album.prepend(...nuevas.map(miniatura));
		contar();
	}

	raiz.querySelectorAll<HTMLButtonElement>('[data-vista]').forEach((boton, _, todos) =>
		boton.addEventListener('click', () => {
			todos.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));
			muro.hidden = boton.dataset.vista !== 'muro';
			album.hidden = boton.dataset.vista !== 'album';
		}),
	);

	// --- Fotos nuevas en directo: se avisa arriba y se añaden al tocar, para no mover lo que estás viendo ---
	const avisoNuevas = $<HTMLButtonElement>('[data-nuevas]');
	let pendientes: Foto[] = [];
	avisoNuevas.addEventListener('click', () => {
		anadirArriba(pendientes);
		pendientes = [];
		avisoNuevas.hidden = true;
	});

	if (estado === 'abierto' || estado === 'cerrado') {
		$('[data-muro-caja]').hidden = false;
		fotos = await listarFotos();
		pintarTodo();
		if (estado === 'abierto')
			escucharFotos((f) => {
				if (fotos.some((x) => x.id === f.id) || pendientes.some((x) => x.id === f.id)) return;
				pendientes = [f, ...pendientes];
				const n = pendientes.length;
				$('[data-nuevas-texto]').textContent = n === 1 ? `${f.autor.nombre} acaba de subir una foto · Ver` : `${n} fotos nuevas · Ver`;
				avisoNuevas.hidden = false;
			});
	}

	// --- Subida: elegir, escribir el pie de cada una y publicar ---
	const borradores = $<HTMLUListElement>('[data-borradores]');
	const publicar = $<HTMLButtonElement>('[data-publicar]');
	const cancelar = $<HTMLButtonElement>('[data-cancelar]');
	const aviso = $('[data-aviso]');
	let cola: { archivo: File; li: HTMLElement }[] = [];
	let publicando = false;

	function actualizarAcciones() {
		const n = cola.length;
		$('[data-publicar-fila]').hidden = n === 0;
		publicar.textContent = n > 1 ? `Publicar ${n} fotos` : 'Publicar foto';
		borradores.classList.toggle('mb-3', n > 0);
		// Con borradores, cámara y galería pasan a ser "añadir más" en gris
		raiz.querySelectorAll('[data-elegir]').forEach((b) => b.classList.toggle('grayscale', n > 0));
	}

	const alElegir = (ev: Event) => {
		const input = ev.target as HTMLInputElement;
		aviso.textContent = '';
		for (const archivo of input.files ?? []) {
			const li = plantilla('borrador');
			$<HTMLImageElement>('img', li).src = URL.createObjectURL(archivo);
			const texto = $<HTMLTextAreaElement>('textarea', li);
			texto.addEventListener('input', () => ($('[data-quedan]', li).textContent = String(MAX_DESCRIPCION - texto.value.length)));
			const item = { archivo, li };
			$('[data-quitar]', li).addEventListener('click', () => {
				cola = cola.filter((x) => x !== item);
				li.remove();
				actualizarAcciones();
			});
			cola.push(item);
			borradores.append(li);
		}
		input.value = '';
		actualizarAcciones();
	};
	raiz.querySelectorAll('[data-subir]').forEach((input) => input.addEventListener('change', alElegir));

	cancelar.addEventListener('click', () => {
		cola = [];
		borradores.replaceChildren();
		actualizarAcciones();
	});

	publicar.addEventListener('click', async () => {
		if (publicando) return;
		publicando = true;
		publicar.disabled = cancelar.disabled = true;
		let bien = 0;
		// De una en una: en móvil con mala cobertura es más fiable que todas a la vez
		for (const item of [...cola]) {
			const marca = $('[data-estado-subida]', item.li);
			$<HTMLTextAreaElement>('textarea', item.li).readOnly = true;
			$('[data-quitar]', item.li).hidden = true;
			try {
				marca.textContent = 'Preparando…';
				const imagen = await reducirImagen(item.archivo);
				marca.textContent = 'Subiendo…';
				const foto = await subirFoto(imagen, $<HTMLTextAreaElement>('textarea', item.li).value, yo);
				anadirArriba([foto]);
				cola = cola.filter((x) => x !== item);
				item.li.remove();
				bien++;
			} catch {
				marca.textContent = 'No se ha podido subir';
				marca.className = 'font-bold text-[#c0504d]';
				$<HTMLTextAreaElement>('textarea', item.li).readOnly = false;
				$('[data-quitar]', item.li).hidden = false;
			}
		}
		publicando = false;
		publicar.disabled = cancelar.disabled = false;
		actualizarAcciones();
		if (bien) {
			aviso.textContent = bien === 1 ? '✓ Foto publicada en el muro' : `✓ ${bien} fotos publicadas en el muro`;
			$('[data-muro-caja]').scrollIntoView({ behavior: 'smooth', block: 'start' });
		}
	});

	// --- Visor ---
	const visor = document.querySelector<HTMLDialogElement>('[data-visor]')!;
	const pista = $<HTMLUListElement>('[data-pista]', visor);
	const contador = $('[data-contador]', visor);
	const actual = () => Math.round(pista.scrollLeft / pista.clientWidth);

	function abrirVisor(indice: number) {
		pista.replaceChildren(
			...fotos.map((f) => {
				const li = plantilla('diapositiva');
				const img = $<HTMLImageElement>('[data-foto]', li);
				img.src = f.url;
				img.alt = f.descripcion || `Foto de ${f.autor.nombre}`;
				pintarAvatar($('[data-avatar]', li), f.autor);
				$('[data-autor]', li).textContent = f.autor.nombre;
				$('[data-pie]', li).textContent = f.descripcion;
				return li;
			}),
		);
		visor.showModal();
		pista.scrollTo({ left: indice * pista.clientWidth, behavior: 'instant' });
		contador.textContent = `${indice + 1} / ${fotos.length}`;
	}

	pista.addEventListener('scroll', () => (contador.textContent = `${actual() + 1} / ${fotos.length}`), { passive: true });

	// Descarga como archivo (un <a download> no funciona con imágenes de otro dominio)
	async function descargar(foto: Foto | undefined) {
		if (!foto) return;
		const blob = await (await fetch(foto.url)).blob();
		const enlace = Object.assign(document.createElement('a'), {
			href: URL.createObjectURL(blob),
			download: `trio-feliz-${foto.id}.${blob.type.split('/')[1] ?? 'jpg'}`,
		});
		enlace.click();
		URL.revokeObjectURL(enlace.href);
	}
	$('[data-descargar]', visor).addEventListener('click', () => descargar(fotos[actual()]));
</script>
