---
import Emblema from '../common/Emblema.astro';

// Carta estilo Pokémon (vacía). La rellena `pintarCromo()` de pintar.ts desde el navegador.
// Se usa en el destacado del álbum y en el sobre. Proporción real de carta: 63 × 88.
interface Props {
	class?: string;
}

const { class: clase } = Astro.props;
---

<article
	data-cromo
	class:list={['carta relative mx-auto aspect-[63/88] w-full max-w-72 select-none [container-type:inline-size]', clase]}
>
	<!-- Marco dorado -->
	<div class="carta-marco absolute inset-0 rounded-[5cqw] bg-gradient-to-br from-amarillo-claro via-amarillo to-amarillo-oscuro p-[3.5cqw] shadow-chapa">
		<!-- Cuerpo -->
		<div class="flex size-full flex-col gap-[2cqw] rounded-[3cqw] bg-crema p-[3cqw] text-tinta">
			<!-- Cabecera: etapa, nombre y "PS" -->
			<div class="flex items-center gap-[2cqw]">
				<span class="rounded-sm bg-granate px-[1.6cqw] py-[0.4cqw] text-[3cqw] font-black uppercase italic text-amarillo">Básico</span>
				<p data-c-apodo lang="es" class="rotulo min-w-0 flex-1 truncate text-[6.5cqw] text-granate-oscuro"></p>
				<p class="flex items-baseline gap-[0.8cqw] text-granate">
					<span class="text-[3cqw] font-black">PS</span>
					<span data-c-ps class="rotulo text-[6cqw]"></span>
					<Emblema class="size-[5.5cqw] self-center" hueco="var(--color-crema)" />
				</p>
			</div>

			<!-- Ilustración -->
			<div class="relative aspect-[10/7] overflow-hidden border-[0.9cqw] border-amarillo-oscuro bg-granate-oscuro shadow-[0_0_0_0.5cqw_var(--color-amarillo-claro)]">
				<img data-c-foto alt="" class="size-full object-cover" hidden />
				<span data-c-inicial class="rotulo absolute inset-0 grid place-items-center text-[26cqw] text-amarillo"></span>
				<span class="holo pointer-events-none absolute inset-0" aria-hidden="true"></span>
			</div>
			<p class="-mt-[0.5cqw] text-center text-[2.6cqw] font-bold italic text-tinta-suave">
				<span data-c-numero></span> · <span data-c-especial-texto>Invitado</span>
			</p>

			<!-- Ataque (la frase) -->
			<div class="flex flex-1 flex-col justify-center gap-[1.5cqw] border-y border-granate/20 py-[2cqw] text-center">
				<p class="flex items-center justify-center gap-[2cqw] text-granate">
					<Emblema class="size-[5cqw]" hueco="var(--color-crema)" />
					<span class="rotulo text-[4.6cqw]">Frase</span>
				</p>
				<p data-c-frase class="px-[2cqw] text-[3.8cqw] leading-snug text-tinta"></p>
			</div>

			<!-- Pie: nombre real y debilidad -->
			<div class="flex items-end justify-between gap-[2cqw] text-[2.8cqw] font-bold text-tinta-suave">
				<p class="min-w-0">
					<span class="block text-[2.2cqw] uppercase tracking-[0.15em]">Entrenador</span>
					<span data-c-nombre class="block truncate text-[3.6cqw] font-black text-tinta"></span>
				</p>
				<p class="shrink-0 text-right">
					<span class="block text-[2.2cqw] uppercase tracking-[0.15em]">Debilidad</span>
					<span class="block text-[3.6cqw] font-black text-tinta">🚬 ×2</span>
				</p>
			</div>
		</div>
	</div>

	<p
		data-c-especial
		hidden
		class="absolute -top-[1.5cqw] left-1/2 -translate-x-1/2 whitespace-nowrap rounded-sm bg-granate px-[3cqw] py-[0.8cqw] text-[2.8cqw] font-black uppercase tracking-[0.2em] text-amarillo shadow"
	>
		★ Edición especial ★
	</p>
	<span class="brillo pointer-events-none absolute inset-0 rounded-[5cqw]" aria-hidden="true"></span>
</article>

<style>
	.carta.entra {
		animation: entra 0.35s ease-out;
	}
	@keyframes entra {
		from {
			opacity: 0.4;
			transform: scale(0.97);
		}
	}

	/* Cartas especiales: ilustración holográfica y destello sobre toda la carta */
	.carta.es-especial .holo {
		background: linear-gradient(
			125deg,
			rgb(255 0 128 / 0.35),
			rgb(255 220 0 / 0.3) 25%,
			rgb(0 220 160 / 0.3) 50%,
			rgb(60 120 255 / 0.35) 75%,
			rgb(255 0 128 / 0.35)
		);
		background-size: 300% 300%;
		animation: holo 5s ease-in-out infinite;
		mix-blend-mode: color-dodge;
	}
	@keyframes holo {
		50% {
			background-position: 100% 100%;
		}
	}
	.carta.es-especial .brillo {
		background: linear-gradient(115deg, transparent 30%, rgb(255 255 255 / 0.4) 45%, rgb(240 188 68 / 0.3) 52%, transparent 65%);
		background-size: 250% 100%;
		animation: brillo 3.5s ease-in-out infinite;
		mix-blend-mode: overlay;
	}
	@keyframes brillo {
		from {
			background-position: 120% 0;
		}
		to {
			background-position: -120% 0;
		}
	}
</style>
