---
import { getImage } from 'astro:assets';
import { imagenTema } from '../../layouts/temas';
import { LISTA_TIPOS } from './tiposCarta';
import './energias.css';

// Cromo grande (vacío), con la maquetación de una carta coleccionable en español (63×88):
// borde plateado; fase, nombre, PS y tipo; ilustración con marco y barra de especie; habilidad;
// ataque; debilidad / resistencia / retirada; ilustrador, reglamento, número y texto de la entrada.
// Todas las medidas van en cqw (ancho de la carta), así escala como una carta física.
// Lo rellena `pintarCromo()` de pintar.ts: los data-c-* son el contrato.
interface Props {
	class?: string;
}

const { class: clase } = Astro.props;

// Símbolos de energía oficiales si están en src/assets/temas/cartas/energia-<tipo>.* (ver energias.css)
const energias = await Promise.all(
	LISTA_TIPOS.map(async (tipo) => {
		const img = imagenTema('cartas', `energia-${tipo}`);
		return img ? { tipo, url: (await getImage({ src: img, width: 96 })).src } : null;
	}),
).then((lista) => lista.filter((e) => e !== null));
// La imagen oficial ya trae su círculo: sin sombra ni color de fondo para que se vea entera
const estiloEnergias = energias
	.map((e) => `:root{--energia-${e.tipo}:url(${e.url})}.energia[data-tipo="${e.tipo}"]{background-color:transparent;box-shadow:none}`)
	.join('');
---

<article data-cromo data-tipo="incoloro" class:list={['cromo carta mx-auto w-full max-w-[27rem]', clase]}>
	<div class="cara">
		<!-- Cabecera -->
		<span class="fase">Básico</span>
		<div class="cabecera">
			<p data-c-apodo lang="es" class="nombre"></p>
			<span data-c-especial hidden class="marca-ex">ex</span>
			<p class="ps"><span class="ps-letras">PS</span><span data-c-ps class="ps-numero"></span></p>
			<span data-c-tipo-icono class="tipo-icono"></span>
		</div>

		<p class="subtitulo-ex">Cumpleañero · 4ª edición</p>

		<!-- Ilustración -->
		<div class="ilustracion">
			<img data-c-foto alt="" hidden />
			<span data-c-inicial class="inicial"></span>
		</div>
		<p class="especie">
			N.º <span data-c-dex></span>&nbsp; <span data-c-nombre></span>&nbsp; Altura: <span data-c-altura></span> m&nbsp; Peso:
			<span data-c-peso></span> kg
		</p>

		<!-- Habilidad y ataque -->
		<div class="cuerpo">
			<div class="habilidad">
				<p class="habilidad-titulo"><span class="pastilla">Habilidad</span><span data-c-habilidad class="habilidad-nombre"></span></p>
				<p data-c-habilidad-texto class="habilidad-texto"></p>
			</div>
			<div class="ataque">
				<span data-c-coste class="coste"></span>
				<span data-c-ataque class="ataque-nombre"></span>
				<span data-c-dano class="dano"></span>
			</div>
		</div>

		<!-- Debilidad, resistencia y retirada -->
		<div class="barra">
			<p class="barra-celda">Debilidad <span data-c-debilidad class="barra-valor"></span></p>
			<span class="barra-separador" aria-hidden="true"></span>
			<p class="barra-celda">Resistencia <span data-c-resistencia class="barra-valor"></span></p>
			<span class="barra-diagonal" aria-hidden="true"></span>
			<p class="barra-celda retirada">Retirada <span data-c-retirada class="barra-valor"></span></p>
		</div>

		<!-- Pie: ilustrador, reglamento, colección, número y texto de la entrada -->
		<div class="pie">
			<div class="pie-izquierda">
				<p class="ilustrador">Ilus. Trio Feliz</p>
				<p class="coleccion">
					<span class="caja">J</span><span class="caja">TF4<small>ES</small></span>
					<span data-c-numero class="numero"></span>
					<span class="rareza" aria-hidden="true"></span>
				</p>
			</div>
			<p data-c-frase class="entrada"></p>
			<p class="regla-ex"><b>Regla de los cumpleañeros ex</b> Cuando un cumpleañero ex se va a dormir, cada invitado coge 2 chupitos de Premio.</p>
		</div>
	</div>
	<p class="derechos">©2027 Trio Feliz</p>
	<span class="brillo" aria-hidden="true"></span>
</article>

{estiloEnergias && <style is:inline set:html={estiloEnergias} />}

<style>
	/* Medidas tomadas de una carta real (63×88): todo en cqw, % del ancho de la carta.
	 * La cara empieza a 4cqw del borde; las posiciones "top" son desde arriba de la cara. */
	.carta {
		container-type: inline-size;
		position: relative;
		aspect-ratio: 63 / 88;
		overflow: hidden;
		border-radius: 4.2% / 3.01%;
		background: linear-gradient(160deg, #eceef0, #cfd2d6 45%, #e4e6e9 70%, #c6c9cd);
		box-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
		color: #1d1d1f;
		font-family: 'Gill Sans Cartas', 'Gill Sans', 'Gill Sans MT', sans-serif;
		line-height: 1.15;
	}
	/* La cara se coloca en % de la carta (no en cqw): así cuadra en todos los navegadores.
	 * Equivale a 2,7 / 2,8 / 3,2 / 3,1 cqw de borde plateado arriba / izquierda / derecha / abajo. */
	.cara {
		position: absolute;
		top: 1.94%;
		left: 2.8%;
		right: 3.2%;
		bottom: 2.22%;
		border-radius: 1.4cqw;
		background:
			radial-gradient(120% 70% at 50% 40%, transparent 55%, rgb(0 0 0 / 0.06)),
			radial-gradient(1px 1px at 20% 30%, rgb(255 255 255 / 0.25), transparent),
			var(--carta-m, #f8cf3f);
	}
	.cara > * {
		position: absolute;
	}

	/* --- Cabecera --- */
	.fase {
		top: 1.6cqw;
		left: -0.5cqw;
		height: 3.6cqw;
		padding: 0 4.6cqw 0 2.2cqw;
		display: flex;
		align-items: center;
		clip-path: polygon(0 0, 100% 0, 84% 100%, 0 100%);
		background: linear-gradient(180deg, #fbfbfb, #c4c7cb 55%, #9a9ea4);
		color: #3b3d42;
		font-size: 2.7cqw;
		font-weight: 700;
		font-style: italic;
		text-transform: uppercase;
		text-shadow: 0 0.15cqw 0 #fff;
	}
	.cabecera {
		top: 0;
		left: 17cqw;
		right: 0.6cqw;
		height: 10.2cqw;
		display: flex;
		align-items: center;
		gap: 0.6cqw;
	}
	.nombre {
		flex: 0 1 auto;
		min-width: 0;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: 6.2cqw;
		font-weight: 700;
		letter-spacing: -0.015em;
	}
	.ps {
		margin-left: auto;
		display: flex;
		align-items: baseline;
		font-weight: 700;
	}
	.ps-letras {
		font-size: 2.9cqw;
	}
	.ps-numero {
		font-size: 8.6cqw;
		letter-spacing: -0.05em;
		line-height: 1;
	}
	.tipo-icono :global(.energia) {
		width: 8.7cqw;
		height: 8.7cqw;
	}

	/* --- Ilustración y barra de especie --- */
	.ilustracion {
		top: 10.2cqw;
		left: 5.6cqw;
		width: 85.4cqw;
		height: 53.2cqw;
		background: linear-gradient(135deg, #f4f5f6, #b4b8bd 40%, #e9ebed 60%, #a4a8ae);
	}
	.ilustracion img,
	.inicial {
		position: absolute;
		inset: 0.7cqw;
		width: calc(100% - 1.4cqw);
		height: calc(100% - 1.4cqw);
		object-fit: cover;
		background: var(--color-granate);
	}
	.inicial {
		display: grid;
		place-items: center;
		font-size: 22cqw;
		font-weight: 700;
		color: var(--color-amarillo);
	}
	.especie {
		top: 63.5cqw;
		left: 2.2cqw;
		width: 91.6cqw;
		height: 3.5cqw;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.2cqw;
		clip-path: polygon(1.5% 0, 100% 0, 97% 100%, 0 100%);
		background: linear-gradient(180deg, #f7f7f8, #c9ccd0 60%, #aeb2b7);
		font-size: 1.85cqw;
		font-weight: 600;
		color: #3a3c40;
		white-space: nowrap;
	}

	/* --- Habilidad --- */
	.cuerpo {
		top: 71.9cqw;
		left: 0;
		right: 0;
		height: 40cqw;
	}
	.cuerpo > * {
		position: absolute;
	}
	.habilidad {
		top: 0;
		left: 5.8cqw;
		right: 4.8cqw;
	}
	.habilidad-titulo {
		display: flex;
		align-items: center;
		gap: 2cqw;
		height: 5.4cqw;
	}
	.pastilla {
		flex-shrink: 0;
		width: 22.6cqw;
		height: 4.2cqw;
		display: grid;
		place-items: center;
		border-radius: 9999px;
		background: linear-gradient(180deg, #f05252, #cc1428 55%, #a10d20);
		box-shadow:
			0 0 0 0.45cqw #e1e3e6,
			0 0 0 0.8cqw #9a9ea4;
		color: #fff;
		font-size: 2.75cqw;
		font-weight: 700;
		font-style: italic;
		letter-spacing: 0.02em;
	}
	.habilidad-nombre {
		font-size: 4.9cqw;
		font-weight: 700;
		color: #c8102e;
		letter-spacing: -0.015em;
		white-space: nowrap;
	}
	.habilidad-texto {
		margin-top: 0.9cqw;
		font-size: 3.45cqw;
		line-height: 3.85cqw;
		text-align: justify;
	}

	/* --- Ataque --- */
	.ataque {
		top: 28.8cqw;
		left: 5.2cqw;
		right: 4.8cqw;
		height: 6cqw;
		display: flex;
		align-items: center;
	}
	.coste {
		display: flex;
		gap: 0.7cqw;
		width: 25.4cqw;
	}
	.coste :global(.energia) {
		width: 5.6cqw;
		height: 5.6cqw;
	}
	.ataque-nombre {
		flex: 1;
		font-size: 4.9cqw;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.dano {
		font-size: 5cqw;
		font-weight: 700;
	}

	/* --- Barra de debilidad, resistencia y retirada --- */
	.barra {
		top: 115.8cqw;
		left: 2.2cqw;
		right: 1.8cqw;
		height: 6.3cqw;
		display: flex;
		align-items: center;
		gap: 1.6cqw;
		padding-inline: 0.4cqw;
		font-size: 2.3cqw;
		font-weight: 700;
		background:
			linear-gradient(#b9bcc1, #b9bcc1) left top / 58% 0.4cqw no-repeat,
			linear-gradient(#b9bcc1, #b9bcc1) right bottom / 40% 0.4cqw no-repeat,
			linear-gradient(#b9bcc1, #b9bcc1) left bottom / 52% 0.4cqw no-repeat,
			linear-gradient(#b9bcc1, #b9bcc1) right top / 34% 0.4cqw no-repeat;
	}
	.barra-celda {
		display: flex;
		align-items: center;
		gap: 0.8cqw;
		white-space: nowrap;
	}
	.barra-valor {
		display: flex;
		align-items: center;
		gap: 0.4cqw;
		font-size: 3.3cqw;
	}
	.barra-valor :global(.energia) {
		width: 3.5cqw;
		height: 3.5cqw;
	}
	.barra-separador {
		width: 0.3cqw;
		height: 3cqw;
		margin-inline: 1.4cqw;
		background: #9a9da3;
	}
	.barra-diagonal {
		width: 5cqw;
		height: 6.3cqw;
		margin-left: auto;
		background: linear-gradient(118deg, transparent 44%, #b9bcc1 44% 56%, transparent 56%);
	}
	.retirada {
		margin-left: 1cqw;
		margin-right: 2cqw;
	}

	/* --- Pie --- */
	.pie {
		top: 124.4cqw;
		left: 3cqw;
		right: 3.2cqw;
		height: 9cqw;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2cqw;
		padding-bottom: 1.2cqw;
	}
	.ilustrador {
		font-size: 1.85cqw;
		font-weight: 700;
		font-style: italic;
	}
	.coleccion {
		display: flex;
		align-items: center;
		gap: 0.8cqw;
		margin-top: 0.8cqw;
		font-size: 2.5cqw;
		font-style: italic;
		font-weight: 600;
	}
	.caja {
		padding: 0 0.45cqw;
		border: 0.25cqw solid #1d1d1f;
		border-radius: 0.6cqw;
		font-size: 1.9cqw;
		font-style: normal;
		font-weight: 700;
		line-height: 1.25;
		background: rgb(255 255 255 / 0.55);
	}
	.caja small {
		font-size: 0.75em;
		margin-left: 0.2cqw;
	}
	.rareza::before {
		content: '●';
		font-style: normal;
		font-size: 2cqw;
	}
	.cromo.es-especial .rareza::before {
		content: '★';
	}
	.entrada {
		max-width: 36cqw;
		font-size: 2.35cqw;
		line-height: 3.1cqw;
		text-align: right;
	}
	.derechos {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 3.1cqw;
		display: grid;
		place-items: center;
		font-size: 1.35cqw;
		font-weight: 600;
		color: #3b3d42;
	}

	/* --- Cartas ex (cumpleañeros) --- */
	.marca-ex {
		flex-shrink: 0;
		margin-left: -0.2cqw;
		font-size: 6.6cqw;
		font-weight: 900;
		font-style: italic;
		line-height: 1;
		letter-spacing: -0.04em;
		color: #fff;
		-webkit-text-stroke: 0.45cqw #1d1d1f;
		paint-order: stroke fill;
		text-shadow: 0 0.4cqw 0 rgb(0 0 0 / 0.35);
	}
	.subtitulo-ex {
		display: none;
		top: 7.3cqw;
		left: 17cqw;
		font-size: 1.9cqw;
		font-style: italic;
		font-weight: 600;
		color: rgb(0 0 0 / 0.65);
	}
	.regla-ex {
		display: none;
		max-width: 40cqw;
		padding: 0.8cqw 1.4cqw;
		border-radius: 0.8cqw;
		background: rgb(255 255 255 / 0.75);
		box-shadow: 0 0 0 0.3cqw #b9bcc1;
		font-size: 1.65cqw;
		line-height: 1.3;
		text-align: center;
	}
	.regla-ex b {
		display: block;
		font-size: 1.75cqw;
	}
	.cromo.es-especial .subtitulo-ex {
		display: block;
	}
	.cromo.es-especial .regla-ex {
		display: block;
	}
	.cromo.es-especial .entrada,
	.cromo.es-especial .especie {
		display: none;
	}
	/* Ilustración más alta y bloque de texto más abajo */
	.cromo.es-especial .ilustracion {
		top: 10.6cqw;
		height: 63.5cqw;
	}
	.cromo.es-especial .cuerpo {
		top: 76.5cqw;
	}
	.cromo.es-especial .ataque {
		top: 26cqw;
	}
	.cromo.es-especial .rareza::before {
		content: '★★';
	}

	/* Arte completo: la foto ocupa toda la cara y el texto va encima, en blanco */
	.cromo.es-especial .cara {
		overflow: hidden;
		background: #111;
	}
	.cromo.es-especial .ilustracion {
		inset: 0;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: none;
		box-shadow: none;
		z-index: 0;
	}
	.cromo.es-especial .ilustracion img,
	.cromo.es-especial .inicial {
		inset: 0;
		width: 100%;
		height: 100%;
	}
	/* Velos: arriba para la cabecera y abajo, más oscuro, para el texto */
	.cromo.es-especial .cara::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(180deg, rgb(0 0 0 / 0.55) 0%, transparent 14%),
			linear-gradient(180deg, transparent 45%, rgb(0 0 0 / 0.55) 62%, rgb(0 0 0 / 0.8) 100%);
		pointer-events: none;
	}
	.cromo.es-especial .cara > :not(.ilustracion) {
		z-index: 2;
	}
	.cromo.es-especial .cabecera,
	.cromo.es-especial .cuerpo,
	.cromo.es-especial .barra,
	.cromo.es-especial .pie {
		color: #fff;
		text-shadow: 0 0.25cqw 0.6cqw rgb(0 0 0 / 0.85);
	}
	.cromo.es-especial .subtitulo-ex {
		color: rgb(255 255 255 / 0.85);
		text-shadow: 0 0.25cqw 0.6cqw rgb(0 0 0 / 0.85);
	}
	.cromo.es-especial .habilidad-nombre {
		color: #ff6b6b;
	}
	.cromo.es-especial .caja {
		border-color: #fff;
		background: rgb(0 0 0 / 0.35);
	}
	.cromo.es-especial .regla-ex {
		color: #1d1d1f;
		text-shadow: none;
	}
	.cromo.es-especial .barra {
		background:
			linear-gradient(rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.7)) left top / 58% 0.4cqw no-repeat,
			linear-gradient(rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.7)) right bottom / 40% 0.4cqw no-repeat,
			linear-gradient(rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.7)) left bottom / 52% 0.4cqw no-repeat,
			linear-gradient(rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.7)) right top / 34% 0.4cqw no-repeat;
	}

	/* --- Animación y brillo holográfico (cumpleañeros) --- */
	.cromo.entra {
		animation: entra 0.35s ease-out;
	}
	@keyframes entra {
		from {
			opacity: 0.4;
			transform: scale(0.97);
		}
	}
	.brillo {
		pointer-events: none;
		position: absolute;
		inset: 0;
	}
	.cromo.es-especial .brillo {
		background: linear-gradient(
			115deg,
			transparent 25%,
			rgb(255 255 255 / 0.45) 38%,
			rgb(179 136 255 / 0.35) 46%,
			rgb(61 224 255 / 0.3) 54%,
			rgb(255 230 120 / 0.35) 62%,
			transparent 75%
		);
		background-size: 250% 100%;
		animation: brillo 3.5s ease-in-out infinite;
		mix-blend-mode: overlay;
	}
	@keyframes brillo {
		from {
			background-position: 120% 0;
		}
		to {
			background-position: -120% 0;
		}
	}
</style>
