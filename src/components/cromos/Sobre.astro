---
import Cromo from './Cromo.astro';
import EscudoTrio from '../registro/EscudoTrio.astro';

// Sobre de bienvenida: una carta certificada del SEPE del Trío (el registro es un trámite de principio a fin).
// Diálogo a pantalla completa que se abre con `abrirSobre(cromos)` de sobre.ts; los data-* son el contrato.
// Pasos: sobre cerrado → se rasga la tira de arriba → los cromos salen como documentos del expediente (toca para
// pasar) → "Expediente completo".
---

<dialog
	data-sobre-dialogo
	aria-label="Sobre de cromos"
	class="sobre-dialogo fixed inset-0 m-0 hidden h-dvh max-h-none w-dvw max-w-none overflow-hidden p-0 text-white backdrop:bg-black/70 open:block"
>
	<div class="fondo absolute inset-0" aria-hidden="true"></div>

	<button type="button" data-cerrar aria-label="Cerrar" class="cerrar">×</button>

	<div class="relative mx-auto flex h-full max-w-md flex-col items-center justify-center px-4 py-[max(1.5rem,env(safe-area-inset-top))]">
		<!-- 1 · Sobre certificado cerrado -->
		<div data-paso-sobre class="w-full text-center">
			<p class="antetitulo">Correspondencia certificada</p>
			<p class="titulo" data-titulo-sobre>Tiene usted una notificación</p>

			<button type="button" data-paquete class="paquete" aria-label="Abrir el sobre">
				<span data-tapa class="tapa">
					<span class="tijera" aria-hidden="true">✂</span>
					<span>Abrir por aquí</span>
				</span>
				<span class="cuerpo">
					<span class="remitente">
						<EscudoTrio class="remitente-escudo" />
						<span>
							<strong>Gobierno del Trío</strong>
							<span>SEPE · Servicio Público de Empleo del Trío</span>
							<span>Apartado de Correos 067</span>
						</span>
					</span>

					<span class="franqueo" aria-hidden="true">
						<span class="sello-postal">
							<span class="sello-interior">
								<span class="sello-rana">🐸</span>
								<span class="sello-valor">0,67 €</span>
							</span>
						</span>
						<span class="matasellos">TRIOLAND<br />2026</span>
					</span>

					<span class="certificado" aria-hidden="true">Certificado</span>

					<span class="ventanilla">
						<span>D./Dña. <strong data-destinatario>Invitado/a</strong></span>
						<span>C/ de la Charca, nº 67</span>
						<span>00067 Trioland</span>
					</span>

					<span class="pie-sobre">
						<span data-n-cartas class="contiene"></span>
						<span class="codigo-barras" aria-hidden="true"></span>
					</span>
				</span>
			</button>
			<p class="aviso-abrir">Toca el sobre para abrirlo</p>
		</div>

		<!-- 2 · Documentos (cromos) -->
		<div data-paso-cartas hidden class="flex w-full flex-col items-center">
			<p class="antetitulo">Documento <span data-actual>1</span> de <span data-total>1</span></p>
			<div data-mazo class="relative w-full max-w-72 cursor-pointer [perspective:1000px]">
				<!-- Folios de atrás, solo de adorno -->
				<div class="dorso absolute inset-0 translate-x-2 translate-y-2 rotate-3" aria-hidden="true"></div>
				<div class="dorso absolute inset-0 -translate-x-1 translate-y-1 -rotate-2" aria-hidden="true"></div>
				<div data-escenario class="relative"></div>
			</div>
			<p data-anuncio class="sr-only" aria-live="polite"></p>
			<div class="mt-7 flex w-full max-w-72 gap-3">
				<button type="button" data-saltar class="boton boton-sec flex-1">Saltar</button>
				<button type="button" data-siguiente class="boton flex-[2]">Siguiente →</button>
			</div>
		</div>

		<!-- 3 · Final -->
		<div data-paso-final hidden class="final">
			<p class="final-cab">Resolución</p>
			<p class="final-titulo">Expediente completo</p>
			<p class="final-n"><span data-final-n>0</span> cromos</p>
			<p class="final-texto">Incorporados a su álbum: todos los que vienen a la fiesta.</p>
			<span class="final-sello" aria-hidden="true">Aprobado</span>
			<button type="button" data-fin class="boton w-full">Ver el álbum</button>
		</div>
	</div>

	<template data-plantilla-carta>
		<div class="carta-sobre"><Cromo /></div>
	</template>
</dialog>

<style>
	.sobre-dialogo {
		--kraft: #d9b98a;
		--kraft-osc: #b8945f;
		--azul: #1d4a7a;
		--rojo: #c8102e;
		background: #12324f;
	}
	.fondo {
		background:
			linear-gradient(#ffffff06 1px, transparent 1px) 0 0 / 1.6rem 1.6rem,
			linear-gradient(90deg, #ffffff06 1px, transparent 1px) 0 0 / 1.6rem 1.6rem,
			radial-gradient(ellipse at 50% 35%, #2a6aa8 0%, #12324f 70%);
	}
	.cerrar {
		position: absolute;
		right: 0.75rem;
		top: max(0.75rem, env(safe-area-inset-top));
		z-index: 10;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: #ffffff1a;
		font-size: 1.5rem;
		font-weight: 900;
	}
	.antetitulo {
		margin-bottom: 0.4rem;
		font-family: 'Space Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: #f1bf00;
	}
	.titulo {
		margin-bottom: 1.4rem;
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-size: 1.35rem;
		font-weight: 800;
	}
	.aviso-abrir {
		margin-top: 1.6rem;
		font-family: 'Space Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		opacity: 0.8;
		animation: sobre-parpadea 1.6s ease-in-out infinite;
	}

	/* --- El sobre: carta certificada en papel kraft --- */
	.paquete {
		position: relative;
		display: block;
		width: min(21rem, 92vw);
		margin: 0 auto;
		text-align: left;
		color: #2b2116;
		font-family: 'Space Mono', ui-monospace, monospace;
		filter: drop-shadow(0 10px 18px #0007);
		animation: sobre-respira 2.6s ease-in-out infinite;
	}
	.tapa,
	.cuerpo {
		display: block;
		background:
			repeating-linear-gradient(35deg, #ffffff0d 0 2px, transparent 2px 6px),
			repeating-linear-gradient(-35deg, #0000000a 0 1px, transparent 1px 5px),
			var(--kraft);
	}
	/* Tira de arriba que se rasga */
	.tapa {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		height: 1.7rem;
		border-radius: 0.3rem 0.3rem 0 0;
		border-bottom: 2px dashed #6b5236;
		padding: 0 0.7rem;
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #6b5236;
		transform-origin: 0 100%;
	}
	.tijera {
		font-size: 0.9rem;
		letter-spacing: 0;
	}
	.cuerpo {
		position: relative;
		aspect-ratio: 22 / 12;
		border-radius: 0 0 0.3rem 0.3rem;
		padding: 0.7rem 0.8rem;
		overflow: hidden;
	}
	.remitente {
		display: flex;
		align-items: flex-start;
		gap: 0.4rem;
		max-width: 62%;
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-size: 0.5rem;
		line-height: 1.3;
	}
	.remitente strong {
		display: block;
		font-size: 0.62rem;
		font-weight: 800;
		text-transform: uppercase;
	}
	.remitente span span {
		display: block;
	}
	.paquete :global(.remitente-escudo) {
		flex-shrink: 0;
		width: 1.5rem;
		height: auto;
	}
	/* Sello postal con borde dentado y matasellos encima */
	.franqueo {
		position: absolute;
		top: 0.6rem;
		right: 0.7rem;
	}
	/* Borde dentado: un fondo de agujeros y, encima, el sello liso algo más pequeño (solo se ven los del borde) */
	.sello-postal {
		display: block;
		padding: 4px;
		background: radial-gradient(circle, transparent 0 2.2px, #f6efe0 2.7px) -1.5px -1.5px / 7px 7px;
		filter: drop-shadow(0 1px 1px #0003);
		rotate: 4deg;
	}
	.sello-interior {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 2.6rem;
		height: 3.1rem;
		border: 1.5px solid var(--rojo);
		background: #f6efe0;
	}
	.sello-rana {
		font-size: 1.35rem;
		line-height: 1;
	}
	.sello-valor {
		margin-top: 0.2rem;
		font-size: 0.5rem;
		font-weight: 700;
		color: var(--rojo);
	}
	.matasellos {
		position: absolute;
		top: 1.3rem;
		left: -1.6rem;
		display: grid;
		place-items: center;
		width: 2.9rem;
		height: 2.9rem;
		border: 2px solid #1d3d6acc;
		border-radius: 50%;
		font-size: 0.42rem;
		font-weight: 700;
		line-height: 1.2;
		text-align: center;
		color: #1d3d6acc;
		rotate: -12deg;
	}
	.matasellos::after {
		content: '';
		position: absolute;
		left: 2.6rem;
		top: 0.6rem;
		width: 3.4rem;
		height: 1.5rem;
		background: repeating-linear-gradient(#1d3d6a99 0 2px, transparent 2px 6px);
		-webkit-mask-image: linear-gradient(90deg, #000, transparent);
		mask-image: linear-gradient(90deg, #000, transparent);
	}
	.certificado {
		position: absolute;
		top: 42%;
		right: 0.9rem;
		border: 2px solid var(--rojo);
		border-radius: 0.2rem;
		padding: 0.05rem 0.4rem;
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-size: 0.62rem;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--rojo);
		rotate: -8deg;
		opacity: 0.85;
		mix-blend-mode: multiply;
	}
	/* Ventanilla transparente con la dirección */
	.ventanilla {
		position: absolute;
		left: 0.8rem;
		bottom: 1.7rem;
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
		width: 58%;
		border: 1px solid #ffffff99;
		border-radius: 0.25rem;
		background: linear-gradient(115deg, #ffffffcc, #f4f1eaee 40%, #ffffffcc);
		padding: 0.4rem 0.55rem;
		font-size: 0.6rem;
		line-height: 1.35;
		box-shadow: inset 0 0 0 1px #0000000d;
	}
	.ventanilla strong {
		text-transform: uppercase;
	}
	.pie-sobre {
		position: absolute;
		left: 0.8rem;
		right: 0.8rem;
		bottom: 0.45rem;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.contiene {
		font-size: 0.5rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.codigo-barras {
		width: 5.5rem;
		height: 0.9rem;
		background: repeating-linear-gradient(90deg, #2b2116 0 1px, transparent 1px 3px, #2b2116 3px 5px, transparent 5px 6px, #2b2116 6px 7px, transparent 7px 10px);
	}

	/* Rasgado: tiembla, la tira sale volando y el sobre baja para dejar salir los documentos */
	.paquete.abierto {
		animation: sobre-tiembla 0.35s linear;
	}
	.paquete.abierto .tapa {
		animation: sobre-vuela 0.6s 0.3s ease-in forwards;
	}
	.paquete.abierto .cuerpo {
		animation: sobre-hunde 0.5s 0.65s ease-in forwards;
	}

	/* --- Documentos --- */
	.dorso {
		border-radius: 5%;
		background:
			repeating-linear-gradient(transparent 0 1.3rem, #1d4a7a1a 1.3rem calc(1.3rem + 1px)),
			#f6f4ee;
		box-shadow: 0 4px 12px #0005;
	}
	.carta-sobre.entra {
		animation: sobre-carta-entra 0.55s cubic-bezier(0.2, 0.8, 0.3, 1.15);
	}
	.carta-sobre.sale {
		animation: sobre-carta-sale 0.35s ease-in forwards;
	}
	.boton {
		border-radius: 0.3rem;
		background: #f1bf00;
		padding: 0.75rem 1rem;
		font-family: 'Space Mono', ui-monospace, monospace;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #12324f;
		box-shadow: 0 4px 0 #a88400;
	}
	.boton:active {
		translate: 0 3px;
		box-shadow: 0 1px 0 #a88400;
	}
	.boton-sec {
		background: transparent;
		color: #fff;
		box-shadow: inset 0 0 0 2px #ffffffaa;
	}

	/* --- Final --- */
	.final {
		position: relative;
		width: 100%;
		max-width: 19rem;
		overflow: hidden;
		border-radius: 0.3rem;
		background:
			repeating-linear-gradient(transparent 0 1.3rem, #1d4a7a14 1.3rem calc(1.3rem + 1px)),
			#fbfaf4;
		padding: 1.3rem 1.2rem 1.2rem;
		text-align: center;
		color: #23262b;
		box-shadow: 0 10px 30px #0006;
		animation: sobre-carta-entra 0.5s ease-out;
	}
	.final-cab {
		display: inline-block;
		border: 2px solid var(--azul);
		padding: 0.05rem 0.5rem;
		font-family: 'Space Mono', ui-monospace, monospace;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--azul);
	}
	.final-titulo {
		margin-top: 0.6rem;
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-size: 1.4rem;
		font-weight: 800;
		text-transform: uppercase;
	}
	.final-n {
		margin-top: 0.4rem;
		font-family: 'Space Mono', ui-monospace, monospace;
		font-size: 2.4rem;
		font-weight: 700;
		color: var(--azul);
	}
	.final-texto {
		margin: 0.3rem 0 1.4rem;
		font-size: 0.85rem;
		color: #555;
	}
	.final-sello {
		position: absolute;
		top: 0.9rem;
		right: 0.5rem;
		border: 4px double #1f7a32;
		border-radius: 0.4rem;
		padding: 0.1rem 0.6rem;
		font-family: 'Space Mono', ui-monospace, monospace;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #1f7a32;
		rotate: 14deg;
		opacity: 0.85;
		mix-blend-mode: multiply;
		animation: sobre-estampa 0.45s 0.25s cubic-bezier(0.2, 1.6, 0.5, 1) both;
	}

	/* Nombres propios (sobre-*): las animaciones son globales y chocarían con las de otras piezas */
	@keyframes sobre-respira {
		50% {
			transform: translateY(-6px) rotate(-1deg);
		}
	}
	@keyframes sobre-parpadea {
		50% {
			opacity: 0.35;
		}
	}
	@keyframes sobre-tiembla {
		20% {
			transform: translateX(-4px) rotate(-2deg);
		}
		40% {
			transform: translateX(4px) rotate(2deg);
		}
		60% {
			transform: translateX(-3px) rotate(-1deg);
		}
		80% {
			transform: translateX(3px) rotate(1deg);
		}
	}
	@keyframes sobre-vuela {
		to {
			transform: translate(30%, -320%) rotate(25deg);
			opacity: 0;
		}
	}
	@keyframes sobre-hunde {
		to {
			transform: translateY(60%) scale(0.85);
			opacity: 0;
		}
	}
	@keyframes sobre-carta-entra {
		from {
			transform: translateY(40%) rotateX(25deg) scale(0.85);
			opacity: 0;
		}
	}
	@keyframes sobre-carta-sale {
		to {
			transform: translateX(130%) rotate(18deg);
			opacity: 0;
		}
	}
	@keyframes sobre-estampa {
		from {
			opacity: 0;
			scale: 2.6;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sobre-dialogo *,
		.sobre-dialogo {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
		}
	}
</style>
