---
import { getImage } from 'astro:assets';
import Cromo from './Cromo.astro';
import EscudoTrio from '../registro/EscudoTrio.astro';
import ranaCartas from '../../assets/mascota/cartas.png';

// Sobres de cromos, en vertical como las cartas. Diálogo a pantalla completa que se abre con `abrirSobre(cromos)`
// de sobre.ts; los data-* son el contrato. Hay dos, según `variante`:
// - "empleo": el de bienvenida, una oferta de empleo certificada del SEPE del Trío (el registro es un trámite).
// - "cartas": el de las versiones nuevas de la carta, un sobre de aluminio de cartas coleccionables.
// Pasos: sobre cerrado → se rasga la tira de arriba → salen las cartas (toca para pasar) → final.
const { src: ranaSrc } = await getImage({ src: ranaCartas, width: 420, format: 'webp' });
---

<dialog
	data-sobre-dialogo
	data-variante="empleo"
	aria-label="Sobre de cromos"
	class="sobre-dialogo fixed inset-0 m-0 hidden h-dvh max-h-none w-dvw max-w-none overflow-hidden p-0 text-white backdrop:bg-black/70 open:block"
>
	<div class="fondo absolute inset-0" aria-hidden="true"></div>

	<button type="button" data-cerrar aria-label="Cerrar" class="cerrar">×</button>

	<div class="relative mx-auto flex h-full max-w-md flex-col items-center justify-center px-4 py-[max(1.5rem,env(safe-area-inset-top))]">
		<!-- 1 · Sobre cerrado -->
		<div data-paso-sobre class="w-full text-center">
			<p class="antetitulo" data-antetitulo></p>
			<p class="titulo" data-titulo-sobre></p>

			<!-- Oferta de empleo certificada, en papel kraft -->
			<button type="button" data-paquete="empleo" class="paquete paquete-empleo" aria-label="Abrir el sobre">
				<span class="tapa">
					<span class="tijera" aria-hidden="true">✂</span>
					<span>Abrir por aquí</span>
				</span>
				<span class="cuerpo">
					<span class="remitente">
						<EscudoTrio class="remitente-escudo" />
						<span>
							<strong>Gobierno del Trío</strong>
							<span>SEPE · Servicio Público de Empleo del Trío</span>
							<span>Apartado de Correos 067</span>
						</span>
					</span>

					<span class="franqueo" aria-hidden="true">
						<span class="sello-postal">
							<span class="sello-interior">
								<span class="sello-rana">🐸</span>
								<span class="sello-valor">0,67 €</span>
							</span>
						</span>
						<span class="matasellos">TRIOLAND<br />2026</span>
					</span>

					<span class="oferta">
						<span class="oferta-titulo">Oferta de empleo</span>
						<span class="oferta-linea"><b>Ref.</b> 067/2026</span>
						<span class="oferta-linea"><b>Puesto</b> Invitado/a</span>
						<span class="oferta-linea"><b>Jornada</b> De noche, hasta caer</span>
						<span class="oferta-linea"><b>Sueldo</b> En cerveza</span>
					</span>

					<span class="certificado" aria-hidden="true">Certificado</span>

					<span class="ventanilla">
						<span>D./Dña. <strong data-destinatario>Invitado/a</strong></span>
						<span>C/ de la Charca, nº 67</span>
						<span>00067 Trioland</span>
					</span>

					<span class="pie-sobre">
						<span data-n-cartas class="contiene"></span>
						<span class="codigo-barras" aria-hidden="true"></span>
					</span>
				</span>
			</button>

			<!-- Sobre de cartas coleccionables, en aluminio -->
			<button type="button" data-paquete="cartas" hidden class="paquete paquete-cartas" aria-label="Abrir el sobre">
				<span class="tapa"><span>✂ Rasgar aquí</span></span>
				<span class="cuerpo">
					<span class="bolsa-rayos" aria-hidden="true"></span>
					<span class="bolsa-logo"><span>Trio</span><span>Feliz</span></span>
					<span class="bolsa-lema">Cartas coleccionables</span>
					<img class="bolsa-rana" src={ranaSrc} alt="" width="420" height="495" decoding="async" />
					<span class="bolsa-banda">
						<span class="bolsa-edicion">4ª edición · Versión especial</span>
						<span data-n-cartas class="contiene"></span>
					</span>
					<span class="bolsa-brillo" aria-hidden="true"></span>
				</span>
				<span class="bolsa-cierre" aria-hidden="true"></span>
			</button>
			<p class="aviso-abrir">Toca el sobre para abrirlo</p>
		</div>

		<!-- 2 · Documentos (cromos) -->
		<div data-paso-cartas hidden class="flex w-full flex-col items-center">
			<p class="antetitulo"><span data-pieza>Documento</span> <span data-actual>1</span> de <span data-total>1</span></p>
			<div data-mazo class="relative w-full max-w-72 cursor-pointer [perspective:1000px]">
				<!-- Folios de atrás, solo de adorno -->
				<div class="dorso absolute inset-0 translate-x-2 translate-y-2 rotate-3" aria-hidden="true"></div>
				<div class="dorso absolute inset-0 -translate-x-1 translate-y-1 -rotate-2" aria-hidden="true"></div>
				<div data-escenario class="relative"></div>
			</div>
			<p data-anuncio class="sr-only" aria-live="polite"></p>
			<div class="mt-7 flex w-full max-w-72 gap-3">
				<button type="button" data-saltar class="boton boton-sec flex-1">Saltar</button>
				<button type="button" data-siguiente class="boton flex-[2]">Siguiente →</button>
			</div>
		</div>

		<!-- 3 · Final -->
		<div data-paso-final hidden class="final">
			<p class="final-cab" data-final-cab>Resolución</p>
			<p class="final-titulo" data-final-titulo>Plantilla completa</p>
			<p class="final-n"><span data-final-n>0</span> <span data-final-unidad>cromos</span></p>
			<p class="final-texto" data-final-texto>Incorporados a su álbum: todos los que vienen a la fiesta.</p>
			<span class="final-sello" aria-hidden="true">Contratado</span>
			<button type="button" data-fin class="boton w-full">Ver el álbum</button>
		</div>
	</div>

	<template data-plantilla-carta>
		<div class="carta-sobre"><Cromo /></div>
	</template>
</dialog>

<style>
	.sobre-dialogo {
		--kraft: #d9b98a;
		--kraft-osc: #b8945f;
		--azul: #1d4a7a;
		--rojo: #c8102e;
		background: #12324f;
	}
	.fondo {
		background:
			linear-gradient(#ffffff06 1px, transparent 1px) 0 0 / 1.6rem 1.6rem,
			linear-gradient(90deg, #ffffff06 1px, transparent 1px) 0 0 / 1.6rem 1.6rem,
			radial-gradient(ellipse at 50% 35%, #2a6aa8 0%, #12324f 70%);
	}
	.cerrar {
		position: absolute;
		right: 0.75rem;
		top: max(0.75rem, env(safe-area-inset-top));
		z-index: 10;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: #ffffff1a;
		font-size: 1.5rem;
		font-weight: 900;
	}
	.antetitulo {
		margin-bottom: 0.4rem;
		font-family: 'Space Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: #f1bf00;
	}
	.titulo {
		margin-bottom: 1.4rem;
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-size: 1.35rem;
		font-weight: 800;
	}
	.aviso-abrir {
		margin-top: 1.6rem;
		font-family: 'Space Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		opacity: 0.8;
		animation: sobre-parpadea 1.6s ease-in-out infinite;
	}

	/* --- Los sobres: en vertical, con la proporción de una carta --- */
	.paquete {
		position: relative;
		display: block;
		/* Que quepa también en móviles bajos: el alto manda */
		width: min(16.5rem, 78vw, 41dvh);
		container-type: inline-size;
		margin: 0 auto;
		text-align: left;
		color: #2b2116;
		font-family: 'Space Mono', ui-monospace, monospace;
		filter: drop-shadow(0 10px 18px #0007);
		animation: sobre-respira 2.6s ease-in-out infinite;
	}
	.paquete[hidden] {
		display: none;
	}

	/* --- Oferta de empleo: carta certificada en papel kraft (medidas en cqw: ancho del sobre) --- */
	.paquete-empleo .tapa,
	.paquete-empleo .cuerpo {
		display: block;
		background:
			repeating-linear-gradient(35deg, #ffffff0d 0 2px, transparent 2px 6px),
			repeating-linear-gradient(-35deg, #0000000a 0 1px, transparent 1px 5px),
			var(--kraft);
	}
	/* Tira de arriba que se rasga */
	.tapa {
		position: relative;
		transform-origin: 0 100%;
	}
	.paquete-empleo .tapa {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		height: 10cqw;
		border-radius: 0.3rem 0.3rem 0 0;
		border-bottom: 2px dashed #6b5236;
		padding: 0 4cqw;
		font-size: 3.7cqw;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #6b5236;
	}
	.tijera {
		font-size: 5.5cqw;
		letter-spacing: 0;
	}
	.cuerpo {
		position: relative;
		overflow: hidden;
	}
	.paquete-empleo .cuerpo {
		aspect-ratio: 63 / 82;
		border-radius: 0 0 0.3rem 0.3rem;
		padding: 5cqw;
	}
	.remitente {
		display: flex;
		align-items: flex-start;
		gap: 2cqw;
		max-width: 64%;
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-size: 3cqw;
		line-height: 1.3;
	}
	.remitente strong {
		display: block;
		font-size: 3.9cqw;
		font-weight: 800;
		text-transform: uppercase;
	}
	.remitente span span {
		display: block;
	}
	.paquete :global(.remitente-escudo) {
		flex-shrink: 0;
		width: 9cqw;
		height: auto;
	}
	/* Sello postal con borde dentado y matasellos encima */
	.franqueo {
		position: absolute;
		top: 4.5cqw;
		right: 4.5cqw;
	}
	/* La oferta, escrita a máquina en el propio sobre */
	.oferta {
		position: absolute;
		left: 5cqw;
		right: 5cqw;
		top: 37cqw;
		display: block;
	}
	.oferta-titulo {
		display: block;
		margin-bottom: 2.2cqw;
		border-block: 2.5px solid #2b2116;
		padding: 1.2cqw 0;
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-size: 8.2cqw;
		font-weight: 900;
		font-stretch: 85%;
		line-height: 1;
		letter-spacing: 0.01em;
		text-align: center;
		text-transform: uppercase;
	}
	.oferta-linea {
		display: flex;
		gap: 2cqw;
		font-size: 3.7cqw;
		line-height: 1.55;
	}
	.oferta-linea b {
		flex: none;
		width: 20cqw;
	}
	/* Borde dentado: un fondo de agujeros y, encima, el sello liso algo más pequeño (solo se ven los del borde) */
	.sello-postal {
		display: block;
		padding: 4px;
		background: radial-gradient(circle, transparent 0 2.2px, #f6efe0 2.7px) -1.5px -1.5px / 7px 7px;
		filter: drop-shadow(0 1px 1px #0003);
		rotate: 4deg;
	}
	.sello-interior {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 16cqw;
		height: 19cqw;
		border: 1.5px solid var(--rojo);
		background: #f6efe0;
	}
	.sello-rana {
		font-size: 8.5cqw;
		line-height: 1;
	}
	.sello-valor {
		margin-top: 1cqw;
		font-size: 3.1cqw;
		font-weight: 700;
		color: var(--rojo);
	}
	.matasellos {
		position: absolute;
		top: 9cqw;
		left: -11cqw;
		display: grid;
		place-items: center;
		width: 18cqw;
		height: 18cqw;
		border: 2px solid #1d3d6acc;
		border-radius: 50%;
		font-size: 2.6cqw;
		font-weight: 700;
		line-height: 1.2;
		text-align: center;
		color: #1d3d6acc;
		rotate: -12deg;
	}
	.matasellos::after {
		content: '';
		position: absolute;
		left: 16cqw;
		top: 4cqw;
		width: 20cqw;
		height: 9cqw;
		background: repeating-linear-gradient(#1d3d6a99 0 2px, transparent 2px 6px);
		-webkit-mask-image: linear-gradient(90deg, #000, transparent);
		mask-image: linear-gradient(90deg, #000, transparent);
	}
	.certificado {
		position: absolute;
		top: 77cqw;
		right: 4cqw;
		border: 2px solid var(--rojo);
		border-radius: 0.2rem;
		padding: 0.05rem 0.4rem;
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-size: 4.2cqw;
		font-weight: 900;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--rojo);
		rotate: -8deg;
		opacity: 0.85;
		mix-blend-mode: multiply;
	}
	/* Ventanilla transparente con la dirección */
	.ventanilla {
		position: absolute;
		left: 5cqw;
		bottom: 12cqw;
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
		width: 74%;
		border: 1px solid #ffffff99;
		border-radius: 0.25rem;
		background: linear-gradient(115deg, #ffffffcc, #f4f1eaee 40%, #ffffffcc);
		padding: 2.5cqw 3.5cqw;
		font-size: 3.7cqw;
		line-height: 1.35;
		box-shadow: inset 0 0 0 1px #0000000d;
	}
	.ventanilla strong {
		text-transform: uppercase;
	}
	.pie-sobre {
		position: absolute;
		left: 5cqw;
		right: 5cqw;
		bottom: 3cqw;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.contiene {
		font-size: 3.1cqw;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.codigo-barras {
		width: 34cqw;
		height: 5.6cqw;
		background: repeating-linear-gradient(90deg, #2b2116 0 1px, transparent 1px 3px, #2b2116 3px 5px, transparent 5px 6px, #2b2116 6px 7px, transparent 7px 10px);
	}

	/* --- Sobre de cartas: bolsa de aluminio con los extremos prensados y dentados --- */
	.paquete-cartas {
		--dientes: 2.6cqw;
		color: #fff;
		filter: drop-shadow(0 14px 22px #000a);
	}
	.paquete-cartas .tapa,
	.bolsa-cierre {
		display: grid;
		place-items: center;
		height: 12cqw;
		background:
			repeating-linear-gradient(90deg, #ffffff66 0 1px, #00000022 1px 2px, transparent 2px 5px),
			linear-gradient(100deg, #8f96a8, #f4f6fb 22%, #a5acbd 40%, #eef1f7 58%, #8a91a4 78%, #d9deea);
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-size: 3.6cqw;
		font-weight: 800;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #3a3f52;
	}
	/* Borde en zigzag: una fila de triángulos, arriba en la tapa y abajo en el cierre */
	.paquete-cartas .tapa {
		-webkit-mask:
			conic-gradient(from 135deg at 50% 0, #000 90deg, #0000 0) top / calc(var(--dientes) * 2) var(--dientes) repeat-x,
			linear-gradient(#000 0 0) bottom / 100% calc(100% - var(--dientes)) no-repeat;
		mask:
			conic-gradient(from 135deg at 50% 0, #000 90deg, #0000 0) top / calc(var(--dientes) * 2) var(--dientes) repeat-x,
			linear-gradient(#000 0 0) bottom / 100% calc(100% - var(--dientes)) no-repeat;
	}
	.bolsa-cierre {
		-webkit-mask:
			conic-gradient(from -45deg at 50% 100%, #000 90deg, #0000 0) bottom / calc(var(--dientes) * 2) var(--dientes) repeat-x,
			linear-gradient(#000 0 0) top / 100% calc(100% - var(--dientes)) no-repeat;
		mask:
			conic-gradient(from -45deg at 50% 100%, #000 90deg, #0000 0) bottom / calc(var(--dientes) * 2) var(--dientes) repeat-x,
			linear-gradient(#000 0 0) top / 100% calc(100% - var(--dientes)) no-repeat;
	}
	.paquete-cartas .cuerpo {
		display: block;
		aspect-ratio: 63 / 78;
		background:
			radial-gradient(circle at 50% 58%, #d8ff7a 0%, #35c77d 24%, #0f7f86 48%, #23308f 74%, #171252 100%);
		text-align: center;
	}
	.bolsa-rayos {
		position: absolute;
		inset: -30%;
		background: repeating-conic-gradient(from 0deg at 50% 54%, #ffffff2e 0 7deg, transparent 7deg 15deg);
		animation: sobre-rayos 40s linear infinite;
	}
	.bolsa-logo {
		position: relative;
		display: block;
		padding-top: 5cqw;
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-size: 17cqw;
		font-weight: 900;
		font-stretch: 115%;
		line-height: 0.86;
		letter-spacing: -0.03em;
		text-transform: uppercase;
		color: #fff;
		text-shadow:
			0 0.05em 0 #171252,
			0 0.1em 0.14em #0009;
		rotate: -3deg;
	}
	.bolsa-logo span {
		display: block;
	}
	.bolsa-logo span + span {
		color: #d8ff7a;
	}
	.bolsa-lema {
		position: relative;
		display: inline-block;
		margin-top: 2cqw;
		background: #171252;
		padding: 0.8cqw 3cqw;
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-size: 3.5cqw;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		rotate: -3deg;
	}
	.bolsa-rana {
		position: absolute;
		left: 50%;
		bottom: -30cqw;
		width: 92cqw;
		max-width: none;
		height: auto;
		translate: -50% 0;
		filter: drop-shadow(0 3cqw 4cqw #0008);
	}
	.bolsa-banda {
		position: absolute;
		inset: auto 0 0;
		display: flex;
		flex-direction: column;
		gap: 0.4cqw;
		border-top: 1cqw solid #d8ff7a;
		background: linear-gradient(#171252ee, #0d0a35);
		padding: 2.4cqw 3cqw 2.8cqw;
		font-family: 'Archivo Variable', Arial, sans-serif;
	}
	.bolsa-edicion {
		font-size: 4.2cqw;
		font-weight: 800;
	}
	.bolsa-banda .contiene {
		font-size: 3.4cqw;
		color: #d8ff7a;
	}
	/* Pliegues del aluminio y un destello que lo cruza */
	.bolsa-brillo {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(115deg, transparent 40%, #ffffffb3 50%, transparent 60%) 130% 0 / 260% 100% no-repeat,
			linear-gradient(90deg, #00000055, transparent 9%, #ffffff3d 14%, transparent 22% 76%, #ffffff33 86%, transparent 91%, #00000059);
		mix-blend-mode: soft-light;
		animation: sobre-destello 3.8s ease-in-out infinite;
	}

	/* Rasgado: tiembla, la tira sale volando y el sobre baja para dejar salir los documentos */
	.paquete.abierto {
		animation: sobre-tiembla 0.35s linear;
	}
	.paquete.abierto .tapa {
		animation: sobre-vuela 0.6s 0.3s ease-in forwards;
	}
	.paquete.abierto .cuerpo {
		animation: sobre-hunde 0.5s 0.65s ease-in forwards;
	}
	.paquete.abierto .bolsa-cierre {
		/* El cierre baja a la vez que el cuerpo: lo que él, menos lo que encoge */
		--baja: 65cqw;
		animation: sobre-hunde 0.5s 0.65s ease-in forwards;
	}

	/* --- Con el sobre de cartas cambia también el resto de la pantalla --- */
	.sobre-dialogo[data-variante='cartas'] {
		background: #120d3a;
	}
	.sobre-dialogo[data-variante='cartas'] .fondo {
		background:
			repeating-conic-gradient(from 0deg at 50% 45%, #ffffff0a 0 6deg, transparent 6deg 14deg),
			radial-gradient(ellipse at 50% 42%, #3b2fa8 0%, #120d3a 70%);
	}
	.sobre-dialogo[data-variante='cartas'] .antetitulo {
		color: #d8ff7a;
	}
	.sobre-dialogo[data-variante='cartas'] .dorso {
		background: radial-gradient(circle, #35c77d 0%, #0f7f86 40%, #23308f 100%);
		border: 0.4rem solid #171252;
	}
	.sobre-dialogo[data-variante='cartas'] .boton {
		border-radius: 9999px;
		background: #d8ff7a;
		font-family: 'Archivo Variable', Arial, sans-serif;
		font-weight: 800;
		color: #171252;
		box-shadow: 0 4px 0 #7ba52a;
	}
	.sobre-dialogo[data-variante='cartas'] .boton-sec {
		background: transparent;
		color: #fff;
