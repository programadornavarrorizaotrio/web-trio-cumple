---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import trio from '../../data/trio.json';

// Deja en la página las fotos optimizadas del trío para los cromos de ejemplo (demo.ts).
// TODO(B6): borrar cuando las fotos lleguen de Supabase.
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/trio/*.jpg', { eager: true });
const urls = Object.fromEntries(
	await Promise.all(
		trio.map(async (p) => [
			p.slug,
			(await getImage({ src: fotos[`../../assets/trio/${p.foto}`].default, width: 480, format: 'webp' })).src,
		]),
	),
);
---

<script type="application/json" id="fotos-demo" set:html={JSON.stringify(urls)} />
