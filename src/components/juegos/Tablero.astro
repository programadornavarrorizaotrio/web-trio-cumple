---
import Hoja from '../common/Hoja.astro';
import ElegirEquipo from './ElegirEquipo.astro';
import Partida from './Partida.astro';
import Ranking from './Ranking.astro';
import { MINIJUEGOS } from './liga';

// Hub de /juegos: tablero de hexágonos al estilo Catan. Arriba, una tarjeta con tu estado (equipo,
// rango, puntos) y debajo un hexágono por juego o zona. Los minijuegos dan el "recurso" de su hex
// y el número es lo máximo que se puede ganar en una partida, como las fichas de Catan.
interface Hex {
	id: string;
	icono: string;
	titulo: string;
	/** Recurso de Catan (solo minijuegos) */
	recurso?: string;
	/** Ficha con número (solo minijuegos) */
	ficha?: number;
	texto: string;
	fondo: string;
	color: string;
}

const juego = (id: string, icono: string, fondo: string, color: string): Hex => {
	const m = MINIJUEGOS.find((x) => x.id === id)!;
	return { id, icono, titulo: m.titulo, recurso: m.recurso, ficha: m.maxPuntos, texto: `${m.descripcion} Una partida al día.`, fondo, color };
};

const hexes: Record<string, Hex> = {
	'memory-cromos': juego('memory-cromos', '🃏', '#f1e4c6', '#561a26'),
	'golpea-rana': juego('golpea-rana', '🐸', '#c9dba0', '#2a3a12'),
	'dados-catan': juego('dados-catan', '🎲', '#d9a566', '#2a1116'),
	'adivina-cromo': juego('adivina-cromo', '🕵️', '#bcd6e6', '#12303f'),
	'wordle-trio': juego('wordle-trio', '🔤', '#d9c9ec', '#3a1f52'),
	ranking: { id: 'ranking', icono: '🏆', titulo: 'Ranking', texto: 'Marcador por equipos y clasificación de todos.', fondo: '#f0bc44', color: '#561a26' },
	premios: { id: 'premios', icono: '🎁', titulo: 'Premios', texto: 'Lo que se llevan los mejores de la liga.', fondo: '#f7d88c', color: '#561a26' },
	fiesta: { id: 'fiesta', icono: '🎉', titulo: 'La fiesta', texto: '', fondo: '#8e3345', color: '#fbf4e4' },
};

const filas = [
	['memory-cromos', 'golpea-rana', 'dados-catan'],
	['adivina-cromo', 'wordle-trio'],
	['ranking', 'premios', 'fiesta'],
];
---

<div class="[container-type:inline-size]" data-tablero>
	<button
		type="button"
		data-centro
		aria-label="Tu estado en la liga"
		class="tarjeta-yo mx-auto mb-5 block w-full max-w-md rounded-lg bg-granate-oscuro p-4 text-left text-amarillo shadow-chapa"
	>
		<span class="flex items-center justify-between gap-3">
			<span>
				<span class="block text-[0.65rem] font-black uppercase tracking-widest opacity-80">Tu equipo</span>
				<strong data-centro-equipo class="block text-2xl font-black uppercase leading-none">Elige equipo</strong>
			</span>
			<span class="text-right">
				<span data-centro-rango class="block text-lg font-black uppercase">Hierro</span>
				<span data-centro-puntos class="block text-xs font-bold opacity-80">0 pts</span>
			</span>
		</span>
		<span class="mt-3 block h-2 overflow-hidden rounded-full bg-granate" aria-hidden="true">
			<span data-centro-barra class="block h-full rounded-full bg-amarillo transition-[width] duration-500" style="width:0%"></span>
		</span>
	</button>

	<div class="tablero mx-auto">
		{
			filas.map((fila) => (
				<div class="fila">
					{fila.map((id) => (
						<button type="button" class="hex hex-boton" data-hex={id} data-titulo={hexes[id].titulo} data-texto={hexes[id].texto}>
							<span class="hex-int" style={`--fondo:${hexes[id].fondo};--texto:${hexes[id].color}`}>
								<span class="text-[1.6em] leading-none" aria-hidden="true">{hexes[id].icono}</span>
								<span class="text-[0.78em] font-black uppercase leading-tight">{hexes[id].titulo}</span>
								{hexes[id].recurso && <span class="text-[0.6em] font-bold uppercase tracking-wider opacity-70">{hexes[id].recurso}</span>}
								{hexes[id].ficha && (
									<span data-ficha class="ficha" aria-label={`Hasta ${hexes[id].ficha} puntos`}>
										{hexes[id].ficha}
									</span>
								)}
							</span>
						</button>
					))}
				</div>
			))
		}
	</div>
	<p class="mx-auto mt-4 max-w-sm text-center text-xs text-tinta-suave">
		Cada hexágono es un juego. La ficha es lo máximo que puedes ganar y cada minijuego se juega una vez al día.
	</p>
</div>

<ElegirEquipo />
<Partida />
<Ranking />

<Hoja id="hoja-hex" titulo="hoja-hex-titulo">
	<div class="space-y-3 p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-8 sm:p-6">
		<h3 id="hoja-hex-titulo" data-hex-titulo class="text-2xl text-granate"></h3>
		<p data-hex-texto class="text-tinta-suave"></p>
		<form method="dialog">
			<button class="w-full rounded border-2 border-granate/25 py-3 text-sm font-bold text-granate">Cerrar</button>
		</form>
	</div>
</Hoja>

<style>
	.tablero {
		/* Ancho de un hexágono: caben 3 en fila, con un máximo en pantallas grandes */
		--w: min(31cqw, 9.5rem);
		--h: calc(var(--w) * 1.1547);
		font-size: calc(var(--w) * 0.12);
		width: 100%;
	}
	.fila {
		display: flex;
		justify-content: center;
	}
	/* Las filas se encajan: cada una sube 1/4 de hexágono (menos una holgura) */
	.fila + .fila {
		margin-top: calc(var(--w) * -0.2887 + 0.3rem);
	}
	.hex {
		--punta: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
		width: var(--w);
		height: var(--h);
		margin-inline: 0.15rem;
		padding: 3px;
		flex: none;
		clip-path: var(--punta);
		background: #561a26;
		transition:
			transform 0.15s ease-out,
			background-color 0.15s;
	}
	.hex-int {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.15em;
		width: 100%;
		height: 100%;
		padding: 0 0.6em;
		text-align: center;
		clip-path: var(--punta);
		background: var(--fondo);
		color: var(--texto);
	}
	.hex-boton {
		cursor: pointer;
	}
	.hex-boton:active {
		transform: scale(0.96);
	}
	@media (hover: hover) {
		.hex-boton:hover {
			transform: scale(1.05);
			background: #f0bc44;
		}
	}
	/* El outline se recortaría con el clip-path: el foco se marca con el borde */
	.hex-boton:focus-visible {
		outline: none;
		background: #f0bc44;
		padding: 5px;
		transform: scale(1.05);
	}
	/* Ficha de Catan */
	.ficha {
		display: grid;
		place-items: center;
		min-width: 2em;
		height: 2em;
		margin-top: 0.1em;
		border-radius: 999px;
		border: 2px solid #561a26;
		background: #fbf4e4;
		color: #742434;
		font-size: 0.8em;
		font-weight: 900;
	}
	.ficha.hecha {
		background: #561a26;
		color: #f0bc44;
	}
	/* Mientras no hay equipo, el centro late para llamar a elegirlo */
	.tarjeta-yo.sin-equipo {
		animation: late 1.8s ease-in-out infinite;
	}
	@keyframes late {
		50% {
			transform: scale(1.02);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tarjeta-yo.sin-equipo {
			animation: none;
		}
	}
</style>

<script>
	import { estadoLiga, equipoPorId, MINIJUEGOS } from './liga';
	import { hayJuego, lanzar } from './partida';

	const tablero = document.querySelector<HTMLElement>('[data-tablero]')!;
	const hoja = document.getElementById('hoja-hex') as HTMLDialogElement;
	const hojaEquipo = document.getElementById('hoja-equipo') as HTMLDialogElement;
	const centro = tablero.querySelector<HTMLElement>('[data-centro]')!;
	let estado = await estadoLiga();

	function abrirHoja(titulo: string, texto: string) {
		hoja.querySelector('[data-hex-titulo]')!.textContent = titulo;
		hoja.querySelector('[data-hex-texto]')!.textContent = texto;
		hoja.showModal();
	}

	// Pintar el estado propio en el hexágono central y marcar los minijuegos ya jugados hoy
	function pintar() {
		const poner = (sel: string, texto: string) => (centro.querySelector(`[data-centro-${sel}]`)!.textContent = texto);
		poner('equipo', estado.equipo ? equipoPorId(estado.equipo).nombre : 'Elige equipo');
		poner('rango', estado.rango.nombre);
		poner('puntos', `${estado.puntos} pts`);
		centro.classList.toggle('sin-equipo', !estado.equipo);
		const { rango, siguienteRango: sig, puntos } = estado;
		const pct = sig ? Math.round(((puntos - rango.desde) / (sig.desde - rango.desde)) * 100) : 100;
		centro.querySelector<HTMLElement>('[data-centro-barra]')!.style.width = `${pct}%`;
		for (const id of estado.jugadosHoy) {
			const ficha = tablero.querySelector<HTMLElement>(`[data-hex="${id}"] [data-ficha]`);
			if (ficha) {
				ficha.textContent = '✓';
				ficha.classList.add('hecha');
				ficha.setAttribute('aria-label', `${MINIJUEGOS.find((m) => m.id === id)?.titulo}: ya jugado hoy`);
			}
		}
	}
	pintar();
	document.addEventListener('liga:cambio', async () => {
		estado = await estadoLiga();
		pintar();
	});

	// El centro: sin equipo, a elegirlo; con equipo, tu progreso hacia el siguiente rango
	centro.addEventListener('click', () => {
		if (!estado.equipo) return hojaEquipo.showModal();
		const { nombre, lema } = equipoPorId(estado.equipo);
		const falta = estado.siguienteRango ? ` Te faltan ${estado.siguienteRango.desde - estado.puntos} puntos para ${estado.siguienteRango.nombre}.` : ' Has llegado al rango máximo.';
		abrirHoja(`Equipo ${nombre}`, `${lema}. Rango ${estado.rango.nombre} con ${estado.puntos} puntos, puesto ${estado.puesto} de la liga.${falta}`);
	});

	// Cada hexágono abre su hoja. La fiesta baja a la lista de propuestas.
	tablero.querySelectorAll<HTMLButtonElement>('[data-hex]').forEach((boton) => {
		boton.addEventListener('click', () => {
			if (boton.dataset.hex === 'ranking') return; // lo abre Ranking.astro
			const id = boton.dataset.hex!;
			if (hayJuego(id)) {
				if (!estado.equipo) return hojaEquipo.showModal();
				if (estado.jugadosHoy.includes(id)) return abrirHoja(boton.dataset.titulo ?? '', 'Ya has jugado hoy. Vuelve mañana para otra partida.');
				return void lanzar(id);
			}
			if (boton.dataset.hex === 'fiesta') {
				document.getElementById('fiesta-lista')?.scrollIntoView({ behavior: 'smooth' });
				return;
			}
			abrirHoja(boton.dataset.titulo ?? '', `${boton.dataset.texto} Se abre muy pronto.`);
		});
	});
</script>
