---
import Hoja from '../common/Hoja.astro';
import { EQUIPOS } from './liga';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import trio from '../../data/trio.json';
import { splash } from './lol/imagenes';

// "Selección de campeón" al estilo del LoL: cada cumpleañero tiene su campeón (Pencho es Ezreal, Fran es
// K'Sante y Juan es Gragas). Al tocar un retrato (la foto del amigo) se ve su splash con el amigo delante,
// y al fijarlo entras en su equipo. Solo se puede elegir una vez (la RPC `elegir_equipo` lo impide).
const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/trio/*.jpg', { eager: true });
const retrato = async (id: string) => {
	const t = trio.find((p) => p.slug === id)!;
	const src = (await getImage({ src: fotos[`../../assets/trio/${t.foto}`].default, width: 160, format: 'webp' })).src;
	return { src, encuadre: t.encuadre === 'top' ? 'center top' : t.encuadre };
};
const equipos = await Promise.all(EQUIPOS.map(async (e) => ({ ...e, splash: await splash(e.campeon.clave), foto: await retrato(e.id) })));
---

<Hoja id="hoja-equipo" titulo="hoja-equipo-titulo" asaClara>
	<form data-form-equipo class="cs">
		<div class="cs-escenario">
			{equipos.map((e) => <img data-de={e.id} class="cs-splash" src={e.splash} alt="" style={`object-position:${e.campeon.foco}`} decoding="async" />)}
			<div class="cs-velo" aria-hidden="true"></div>
			{equipos.map((e) => <img data-de={e.id} class="cs-poster" src={`/${e.poster}`} alt="" width="360" height="414" decoding="async" />)}

			<div class="cs-cabecera">
				<p class="cs-paso">Selección de equipo</p>
				<h3 id="hoja-equipo-titulo" class="cs-titulo">Elige tu campeón</h3>
			</div>

			<p class="cs-vacio" data-vacio>¿Con quién juegas?<span>Toca uno de los tres</span></p>
			{
				equipos.map((e) => (
					<div data-de={e.id} class="cs-ficha" aria-hidden="true">
						<span class="cs-campeon">
							{e.campeon.nombre} · {e.campeon.titulo}
						</span>
						<strong class="cs-amigo">{e.nombre}</strong>
						<span class="cs-lema">{e.lema}</span>
					</div>
				))
			}
			<p class="cs-sello" aria-hidden="true">¡Fijado!</p>
		</div>

		<div class="cs-panel">
			<fieldset class="cs-retratos">
				<legend class="sr-only">Equipo</legend>
				{
					equipos.map((e) => (
						<label class="cs-retrato">
							<input type="radio" name="equipo" value={e.id} required class="sr-only" />
							<span class="cs-aro">
								<img src={e.foto.src} alt="" width="128" height="128" loading="lazy" style={`object-position:${e.foto.encuadre}`} />
							</span>
							<span class="cs-retrato-nombre">{e.nombre}</span>
							<span class="sr-only">
								, {e.campeon.nombre}. {e.lema}
							</span>
						</label>
					))
				}
			</fieldset>

			<p class="cs-aviso">Tus puntos van al marcador de su equipo y el día de la fiesta se corona al ganador. <strong>Solo puedes elegir una vez.</strong></p>
			<p data-error hidden role="alert" class="cs-error"></p>
			<button type="submit" class="cs-fijar" data-confirmar disabled>Elige un campeón</button>
		</div>
	</form>
</Hoja>

<style>
	.cs {
		--lol-fondo: #010a13;
		--lol-panel: #0a1428;
		--lol-oro: #c8aa6e;
		--lol-oro-oscuro: #785a28;
		--lol-crema: #f0e6d2;
		--lol-azul: #0ac8b9;
		min-height: 100%;
		background: var(--lol-fondo);
		color: var(--lol-crema);
	}

	/* --- Escenario: splash del campeón con el amigo delante --- */
	.cs-escenario {
		position: relative;
		height: min(54dvh, 25rem);
		min-height: 19rem;
		overflow: hidden;
		background:
			radial-gradient(circle at 50% 42%, rgb(200 170 110 / 0.14), transparent 45%),
			repeating-conic-gradient(from 0deg at 50% 42%, rgb(200 170 110 / 0.05) 0 6deg, transparent 6deg 12deg),
			var(--lol-panel);
	}
	.cs-splash {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transform: scale(1.12);
		transition:
			opacity 0.45s ease,
			transform 6s ease-out;
	}
	.cs-splash.activo {
		opacity: 1;
		transform: scale(1);
	}
	.cs-velo {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(to bottom, rgb(1 10 19 / 0.75), transparent 28%),
			linear-gradient(to top, var(--lol-fondo) 2%, rgb(1 10 19 / 0.7) 30%, transparent 60%);
	}
	.cs-poster {
		position: absolute;
		right: -0.75rem;
		bottom: 2.25rem;
		height: 58%;
		width: auto;
		opacity: 0;
		transform: translateX(2.5rem);
		filter: drop-shadow(0 0 1.25rem rgb(1 10 19 / 0.9));
		transition:
			opacity 0.3s ease,
			transform 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.15);
	}
	.cs-poster.activo {
		opacity: 1;
		transform: none;
		transition-delay: 0.1s;
	}

	.cs-cabecera {
		position: absolute;
		inset: 1.5rem 1rem auto;
		text-align: center;
	}
	.cs-paso {
		color: var(--lol-oro);
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.3em;
		text-transform: uppercase;
	}
	.cs-titulo {
		margin-top: 0.15rem;
		color: var(--lol-crema);
		font-family: var(--font-rotulo);
		font-size: 1.6rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-shadow: 0 2px 8px rgb(0 0 0 / 0.8);
	}

	.cs-vacio {
		position: absolute;
		inset: 50% 1rem auto;
		translate: 0 -10%;
		color: var(--lol-oro);
		font-family: var(--font-rotulo);
		font-size: 1.4rem;
		font-weight: 800;
		text-align: center;
		text-transform: uppercase;
		transition: opacity 0.25s;
	}
	.cs-vacio span {
		display: block;
		margin-top: 0.4rem;
		color: rgb(240 230 210 / 0.6);
		font-family: inherit;
		font-size: 0.7rem;
		letter-spacing: 0.25em;
	}
	.cs[data-elegido] .cs-vacio {
		opacity: 0;
	}

	.cs-ficha {
		position: absolute;
		left: 1rem;
		right: 38%;
		bottom: 3.25rem;
		opacity: 0;
		transform: translateY(0.75rem);
		transition:
			opacity 0.3s,
			transform 0.4s ease-out;
	}
	.cs-ficha.activo {
		opacity: 1;
		transform: none;
		transition-delay: 0.15s;
	}
	.cs-campeon {
		display: block;
		color: var(--lol-oro);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.cs-amigo {
		display: block;
		color: var(--lol-crema);
		font-family: var(--font-rotulo);
		font-size: 2.6rem;
		font-weight: 800;
		line-height: 1;
		text-transform: uppercase;
		text-shadow: 0 3px 10px rgb(0 0 0 / 0.8);
	}
	.cs-lema {
		display: block;
		margin-top: 0.25rem;
		color: rgb(240 230 210 / 0.75);
		font-size: 0.85rem;
		font-weight: 700;
	}

	/* Sello de "¡Fijado!" al confirmar */
	.cs-sello {
		position: absolute;
		inset: 42% 0 auto;
		color: var(--lol-crema);
		font-family: var(--font-rotulo);
		font-size: 2.6rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-align: center;
		text-transform: uppercase;
		text-shadow:
			0 0 18px var(--lol-oro),
			0 0 40px rgb(200 170 110 / 0.7);
		opacity: 0;
		pointer-events: none;
	}
	.cs.fijado .cs-sello {
		animation: cs-sello 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.3) forwards;
	}
	@keyframes cs-sello {
		from {
			opacity: 0;
			transform: scale(2.4);
			letter-spacing: 0.6em;
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
	/* Destello dorado que recorre el escenario */
	.cs-escenario::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 50%, rgb(240 230 210 / 0.9), rgb(200 170 110 / 0.4) 40%, transparent 70%);
		opacity: 0;
		pointer-events: none;
	}
	.cs.fijado .cs-escenario::after {
		animation: cs-destello 0.7s ease-out;
	}
	@keyframes cs-destello {
		15% {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	/* --- Panel: retratos y botón de fijar --- */
	.cs-panel {
		position: relative;
		padding: 0.75rem 1.25rem max(1.25rem, env(safe-area-inset-bottom));
		border-top: 1px solid var(--lol-oro-oscuro);
		background: linear-gradient(var(--lol-panel), var(--lol-fondo));
	}
	.cs-retratos {
		display: flex;
		justify-content: center;
		gap: 1.25rem;
		margin-top: -2.6rem;
	}
	.cs-retrato {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	.cs-aro {
		position: relative;
		display: block;
		width: 4.25rem;
		height: 4.25rem;
		padding: 3px;
		border-radius: 50%;
		background: linear-gradient(160deg, var(--lol-oro), var(--lol-oro-oscuro));
		box-shadow: 0 4px 12px rgb(0 0 0 / 0.6);
		transition:
			transform 0.2s,
			box-shadow 0.2s,
			filter 0.2s;
	}
	.cs-aro img {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		border: 2px solid var(--lol-fondo);
		object-fit: cover;
	}
	.cs-retrato-nombre {
		color: rgb(240 230 210 / 0.7);
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.cs[data-elegido] .cs-retrato:not(:has(:checked)) .cs-aro {
		filter: grayscale(0.7) brightness(0.65);
	}
	.cs-retrato:has(:checked) .cs-aro {
		transform: scale(1.12);
		background: linear-gradient(160deg, #f0e6d2, var(--lol-oro) 45%, var(--lol-oro-oscuro));
		box-shadow:
			0 0 0 2px var(--lol-fondo),
			0 0 0 4px var(--lol-azul),
			0 0 22px 4px rgb(10 200 185 / 0.55);
	}
	.cs-retrato:has(:checked) .cs-retrato-nombre {
		color: var(--lol-crema);
	}
	.cs-retrato:has(:focus-visible) .cs-aro {
		outline: 2px solid var(--lol-azul);
		outline-offset: 4px;
	}

	.cs-aviso {
		margin-top: 1rem;
		color: rgb(240 230 210 / 0.65);
		font-size: 0.8rem;
		line-height: 1.4;
		text-align: center;
	}
	.cs-aviso strong {
		color: var(--lol-crema);
	}
	.cs-error {
		margin-top: 0.5rem;
		color: #ff7f6e;
		font-size: 0.85rem;
		font-weight: 700;
		text-align: center;
	}
	.cs-fijar {
		display: block;
		width: 100%;
		margin-top: 1rem;
		padding: 0.95rem;
		border: 2px solid var(--lol-oro);
		background: linear-gradient(var(--lol-panel), #1e2328);
		color: var(--lol-crema);
		font-family: var(--font-rotulo);
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		box-shadow:
			inset 0 0 0 2px var(--lol-fondo),
			inset 0 0 14px rgb(10 200 185 / 0.25);
		cursor: pointer;
		transition:
			filter 0.2s,
			box-shadow 0.2s;
	}
	.cs-fijar:not(:disabled):active {
		filter: brightness(1.3);
	}
	.cs-fijar:disabled {
		border-color: #3c3c41;
		color: rgb(240 230 210 / 0.35);
		box-shadow: none;
		cursor: default;
	}
	.cs.fijado .cs-fijar {
		border-color: var(--lol-oro);
		background: linear-gradient(var(--lol-oro), var(--lol-oro-oscuro));
		color: var(--lol-fondo);
	}

	@media (prefers-reduced-motion: reduce) {
		.cs-splash,
		.cs-poster,
		.cs-ficha {
			transition: opacity 0.2s;
			transform: none;
		}
		.cs.fijado .cs-sello {
			animation: none;
			opacity: 1;
		}
		.cs.fijado .cs-escenario::after {
			animation: none;
		}
	}
</style>

<script>
	import { elegirEquipo, equipoPorId, type EquipoId } from './liga';

	const form = document.querySelector<HTMLFormElement>('[data-form-equipo]')!;
	const boton = form.querySelector<HTMLButtonElement>('[data-confirmar]')!;
	const error = form.querySelector<HTMLElement>('[data-error]')!;
	const reducido = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
	let fijando = false;

	// Al tocar un retrato: su splash, el amigo delante y el botón dice a quién fijas
	form.addEventListener('change', () => {
		const id = new FormData(form).get('equipo') as EquipoId | null;
		if (id) form.dataset.elegido = id;
		form.querySelectorAll<HTMLElement>('[data-de]').forEach((e) => e.classList.toggle('activo', e.dataset.de === id));
		boton.disabled = !id;
		boton.textContent = id ? `Fijar a ${equipoPorId(id).nombre}` : 'Elige un campeón';
		navigator.vibrate?.(8);
	});

	form.addEventListener('submit', async (ev) => {
		ev.preventDefault();
		if (fijando) return;
		fijando = true;
		error.hidden = true;
		try {
			await elegirEquipo(new FormData(form).get('equipo') as EquipoId);
		} catch {
			error.textContent = 'Ya habías elegido equipo.';
			error.hidden = false;
			fijando = false;
			return;
		}
		// ¡Fijado!: destello, sello y un momento para verlo antes de cerrar
		form.classList.add('fijado');
		boton.disabled = true;
		boton.textContent = 'Fijado';
		form.querySelectorAll('input').forEach((i) => (i.disabled = true));
		navigator.vibrate?.([30, 60, 90]);
		await new Promise((r) => setTimeout(r, reducido() ? 700 : 1500));
		form.closest('dialog')!.close();
		document.dispatchEvent(new CustomEvent('liga:cambio'));
		reiniciar();
	});

	// Deja la hoja como nueva, por si se vuelve a abrir sin recargar (botón "Cambiar equipo" del modo prueba)
	function reiniciar() {
		form.reset();
		form.classList.remove('fijado');
		delete form.dataset.elegido;
		form.querySelectorAll('input').forEach((i) => (i.disabled = false));
		form.querySelectorAll('[data-de]').forEach((e) => e.classList.remove('activo'));
		boton.disabled = true;
		boton.textContent = 'Elige un campeón';
		fijando = false;
	}
</script>
