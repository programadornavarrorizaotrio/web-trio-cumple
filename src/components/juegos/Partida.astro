---
import { getImage } from 'astro:assets';
import Button from '../common/Button.astro';
import rana from '../../assets/mascota/saluda.png';
import FotosDemo from '../cromos/FotosDemo.astro';

// Ventana a pantalla completa donde se juega un minijuego. La abre `lanzar(id)` de partida.ts
// y cada juego pinta su tablero dentro de [data-area].
const { src: ranaSrc } = await getImage({ src: rana, width: 240, format: 'webp' });
---

<dialog
	data-partida
	data-rana-src={ranaSrc}
	aria-label="Minijuego"
	class="fixed inset-0 m-0 hidden h-dvh max-h-none w-dvw max-w-none overflow-y-auto bg-granate-oscuro p-0 text-crema backdrop:bg-black/70 open:block"
>
	<button
		type="button"
		aria-label="Cerrar"
		onclick="this.closest('dialog').close()"
		class="absolute right-3 top-[max(0.75rem,env(safe-area-inset-top))] z-10 grid size-11 place-items-center rounded-full bg-crema/10 text-2xl font-black text-crema active:bg-crema/25"
	>
		×
	</button>

	<div class="mx-auto flex min-h-full max-w-md flex-col items-center justify-center px-4 py-[max(1.5rem,env(safe-area-inset-top))]">
		<!-- 1 · Instrucciones -->
		<div data-pantalla="intro" class="w-full text-center">
			<h2 data-titulo class="text-3xl text-amarillo"></h2>
			<p data-instrucciones class="mx-auto mt-4 max-w-xs text-crema/90"></p>
			<p class="mt-3 text-xs font-bold uppercase tracking-widest text-amarillo-claro">
				Hasta <span data-maximo></span> puntos · un intento al día
			</p>
			<Button data-jugar tamano="lg" class="mt-8 w-full">¡A jugar!</Button>
		</div>

		<!-- 2 · Partida -->
		<div data-pantalla="juego" hidden class="w-full">
			<div data-area></div>
		</div>

		<!-- 3 · Resultado -->
		<div data-pantalla="final" hidden class="w-full text-center">
			<p class="text-sm font-bold uppercase tracking-[0.3em] text-amarillo-claro">Partida terminada</p>
			<p class="rotulo mt-3 text-7xl text-amarillo"><span data-final-puntos>0</span></p>
			<p class="text-sm font-bold uppercase tracking-widest">puntos para tu equipo</p>
			<p data-final-detalle class="mt-3 text-crema/80"></p>
			<p data-final-subida class="mt-2 text-lg font-black text-amarillo"></p>
			<Button tamano="lg" class="mt-8 w-full" onclick="this.closest('dialog').close()">Volver al tablero</Button>
		</div>
	</div>
</dialog>

<!-- Fotos de ejemplo del trío para el memory (TODO: vendrán de listar_cromos) -->
<FotosDemo />

<style is:global>
	/* === Golpea la rana === */
	.rana-hud {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
		font-weight: 900;
	}
	.rana-hud .rana-tiempo {
		flex: 1;
		height: 0.75rem;
		overflow: hidden;
		border-radius: 999px;
		background: var(--color-granate);
	}
	.rana-hud .rana-tiempo i {
		display: block;
		height: 100%;
		width: 100%;
		border-radius: 999px;
		background: var(--color-amarillo);
	}
	.rana-hud output {
		min-width: 4.5rem;
		text-align: right;
		color: var(--color-amarillo);
		font-size: 1.25rem;
	}
	.rana-campo {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
		padding: 0.75rem;
		border-radius: 1rem;
		background: #12402c;
		touch-action: manipulation;
		user-select: none;
		-webkit-user-select: none;
	}
	.rana-agujero {
		position: relative;
		aspect-ratio: 1;
		overflow: hidden;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	/* El agujero: una elipse oscura y un borde de hierba por delante de la rana */
	.rana-fondo {
		position: absolute;
		inset: auto 4% 12% 4%;
		height: 36%;
		border-radius: 50%;
		background: radial-gradient(ellipse at 50% 30%, #0b1f15, #06150e);
	}
	.rana-borde {
		position: absolute;
		inset: auto 0 0 0;
		height: 30%;
		border-radius: 50% 50% 0 0 / 100% 100% 0 0;
		border-top: 4px solid #8fbf3a;
		background: #1d6b45;
	}
	.rana-bicho {
		position: absolute;
		left: 50%;
		bottom: 12%;
		width: 70%;
		transform: translate(-50%, 115%);
		transition: transform 0.12s ease-out;
		pointer-events: none;
		-webkit-user-drag: none;
	}
	.rana-agujero.arriba .rana-bicho {
		transform: translate(-50%, 0);
	}
	.rana-agujero.golpeada .rana-bicho {
		transform: translate(-50%, 8%) rotate(-10deg) scaleY(0.88);
		filter: brightness(1.4);
	}
	.rana-agujero.dorada .rana-bicho {
		filter: sepia(1) saturate(4) hue-rotate(-8deg) brightness(1.15);
	}
	.rana-pop {
		position: absolute;
		left: 50%;
		top: 20%;
		translate: -50% 0;
		color: #fbf4e4;
		font-size: 1.5rem;
		font-weight: 900;
		pointer-events: none;
		animation: rana-pop 0.6s ease-out forwards;
	}
	@keyframes rana-pop {
		to {
			transform: translateY(-1.5rem);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.rana-bicho {
			transition: none;
		}
		.rana-pop {
			animation-duration: 0.01s;
		}
	}

	/* === Memory de cromos === */
	.memo-hud {
		display: flex;
		justify-content: space-between;
		margin-bottom: 1rem;
		color: var(--color-amarillo);
		font-size: 1.1rem;
		font-weight: 900;
		text-transform: uppercase;
	}
	.memo-campo {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.6rem;
		touch-action: manipulation;
		user-select: none;
		-webkit-user-select: none;
	}
	.memo-carta {
		aspect-ratio: 3 / 4;
		padding: 0;
		border: 0;
		background: none;
		perspective: 600px;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	.memo-int {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
		transition: transform 0.35s;
	}
	.memo-carta.vuelta .memo-int {
		transform: rotateY(180deg);
	}
	.memo-cara {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border: 3px solid var(--color-amarillo);
		border-radius: 0.6rem;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}
	.memo-dorso {
		background:
			radial-gradient(circle at 50% 50%, var(--color-granate-claro) 0 22%, transparent 23%),
			repeating-linear-gradient(45deg, var(--color-granate), var(--color-granate) 8px, var(--color-granate-oscuro) 8px 16px);
	}
	.memo-frente {
		display: flex;
		flex-direction: column;
		transform: rotateY(180deg);
		background: var(--color-crema);
	}
	.memo-frente img {
		flex: 1;
		min-height: 0;
		width: 100%;
		object-fit: cover;
		object-position: 50% 20%;
		-webkit-user-drag: none;
	}
	.memo-numero {
		display: grid;
		flex: 1;
		place-items: center;
		background: var(--color-granate-claro);
		color: var(--color-amarillo);
		font-size: 1.5rem;
		font-weight: 900;
	}
	.memo-nombre {
		padding: 0.25rem;
		background: var(--color-granate);
		color: var(--color-amarillo);
		font-size: 0.7rem;
		font-weight: 900;
		line-height: 1.1;
		text-align: center;
		text-transform: uppercase;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.memo-carta.pareja .memo-cara {
		border-color: #c6f26b;
		box-shadow: 0 0 0 2px #c6f26b;
	}
	@media (prefers-reduced-motion: reduce) {
		.memo-int {
			transition: none;
		}
	}

	/* === Dados de Catan === */
	.dados-escena {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		text-align: center;
	}
	.dados-par {
		display: flex;
		gap: 1.25rem;
		padding: 1.5rem;
		border: 0;
		border-radius: 1rem;
		background: #12402c;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	.dado {
		display: grid;
		grid-template: repeat(3, 1fr) / repeat(3, 1fr);
		width: 5.5rem;
		height: 5.5rem;
		padding: 0.6rem;
		border-radius: 1rem;
		background: var(--color-crema);
		box-shadow: 0 5px 0 #b9ac8c;
	}
	.dado-pip {
		align-self: center;
		justify-self: center;
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		background: var(--color-granate);
	}
	.dado.rodando {
		animation: dado-rueda 0.35s linear infinite;
	}
	.dado.rodando:nth-child(2) {
		animation-direction: reverse;
	}
	@keyframes dado-rueda {
		25% {
			transform: translateY(-14px) rotate(25deg);
		}
		50% {
			transform: translateY(0) rotate(-12deg);
		}
		75% {
			transform: translateY(-8px) rotate(18deg);
		}
	}
	.dados-total {
		min-height: 5rem;
		color: var(--color-amarillo);
		font-size: 4.5rem;
		font-weight: 900;
		line-height: 1;
	}
	.dados-mensaje {
		min-height: 1.75rem;
		font-size: 1.1rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.dados-escena.ladron .dados-total,
	.dados-escena.ladron .dados-mensaje {
		color: #ff7f6e;
	}
	@media (prefers-reduced-motion: reduce) {
		.dado.rodando {
			animation: none;
		}
	}

	/* === Adivina el cromo === */
	.adv-hud {
		display: flex;
		justify-content: space-between;
		margin-bottom: 1rem;
		color: var(--color-amarillo);
		font-size: 1.1rem;
		font-weight: 900;
		text-transform: uppercase;
	}
	.adv-marco {
		position: relative;
		margin-inline: auto;
		max-width: 17rem;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border: 4px solid var(--color-amarillo);
		border-radius: 0.9rem;
		background: var(--color-granate);
	}
	.adv-foto {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 20%;
		/* Se amplía un poco para que el difuminado no deje bordes claros */
		transform: scale(1.12);
		-webkit-user-drag: none;
	}
	.adv-quien {
		position: absolute;
		inset: auto 0 0 0;
		padding: 0.5rem;
		background: var(--color-granate-oscuro);
		color: var(--color-amarillo);
		font-weight: 900;
		text-align: center;
		text-transform: uppercase;
	}
	.adv-opciones {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.6rem;
		margin-top: 1rem;
	}
	.adv-opcion {
		min-height: 3.5rem;
		padding: 0.5rem;
		border: 3px solid var(--color-amarillo);
		border-radius: 0.6rem;
		background: var(--color-granate);
		color: var(--color-crema);
		font-size: 0.95rem;
		font-weight: 900;
		line-height: 1.1;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	.adv-opcion:active:not(:disabled) {
		transform: scale(0.97);
	}
	.adv-opcion.bien {
		border-color: #c6f26b;
		background: #2f6b2a;
		color: #fff;
	}
	.adv-opcion.mal {
		border-color: #ff7f6e;
		background: #8a2a20;
		color: #fff;
	}

	/* === La conga de Catan === */
	.conga-lienzo {
		display: block;
		margin-inline: auto;
		border: 4px solid var(--color-amarillo);
		border-radius: 0.6rem;
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
	}
</style>
