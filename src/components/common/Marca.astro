---
import Rotulo from './Rotulo.astro';
import { Image } from 'astro:assets';
import { imagenTema, type Tema } from '../../layouts/temas';

// Logo de la cabecera: emblema + "Trio Feliz", distinto en cada tema.
interface Props {
	tema: Tema;
}

const { tema } = Astro.props;
// Logo oficial si está en src/assets/temas/<tema>/logo.*
const logo = imagenTema(tema, 'logo');
// Cartas: el icono es el reverso de la carta (src/assets/temas/cartas/reverso.*) si está
const icono = tema === 'cartas' ? imagenTema('cartas', 'reverso') : undefined;

const color: Record<Tema, string> = {
	estanco: 'text-amarillo',
	cartas: 'text-crema',
	riverland: 'text-crema',
};
---

{
	logo ? (
		<Image src={logo} alt="" class="h-9 w-auto max-w-40 object-contain" height={72} />
	) : tema === 'estanco' ? (
		<Rotulo />
	) : (
		<span class:list={['inline-flex items-center gap-2', color[tema]]}>
			{icono && <Image src={icono} alt="" height={80} class="h-9 w-auto shrink-0 rounded-[3px] shadow-[0_1px_3px_rgb(0_0_0/0.5)]" />}
			<svg viewBox="0 0 32 32" class:list={['shrink-0', tema === 'riverland' ? 'h-8 w-9' : 'size-8', icono && 'hidden']} aria-hidden="true">
				{tema === 'cartas' && (
					<g>
						<rect x="6" y="2" width="20" height="28" rx="3" fill="currentColor" />
						<rect x="9" y="5" width="14" height="22" rx="1.5" fill="#2d5fae" />
						<path d="M16 9 l2 4.2 4.6.6-3.3 3.2.8 4.6L16 19.4 11.9 21.6l.8-4.6-3.3-3.2 4.6-.6z" fill="currentColor" />
					</g>
				)}
				{tema === 'riverland' && (
					<g>
						<!-- Monograma TF: bloques gruesos redondeados. T y F con hueco claro entre los brazos de la F -->
						<rect x="0" y="4" width="15" height="7" rx="2.2" fill="currentColor" />
						<rect x="4.2" y="4" width="6.6" height="24" rx="2.2" fill="currentColor" />
						<rect x="17" y="4" width="15" height="7" rx="2.2" fill="currentColor" />
						<rect x="17" y="4" width="6.8" height="24" rx="2.2" fill="currentColor" />
						<rect x="17" y="16.4" width="10.5" height="6" rx="2.2" fill="currentColor" />
					</g>
				)}
			</svg>
			<span class="rotulo text-xl leading-none">
				{tema === 'riverland' ? 'Trio Feliz Fest' : 'Trio Feliz'}
			</span>
		</span>
	)
}
