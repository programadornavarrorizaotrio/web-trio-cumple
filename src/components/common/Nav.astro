---
import Marca from './Marca.astro';
import type { Tema } from '../../layouts/temas';

// Navegación: en escritorio, enlaces arriba; en móvil y tablet, botón de hamburguesa que
// despliega el menú bajo la cabecera.
const enlaces = [
	{ href: '/', texto: 'Inicio', detalle: 'Cuenta atrás y el trío' },
	{ href: '/participantes', texto: 'Participantes', detalle: 'Tu álbum de cromos' },
	{ href: '/estanco', texto: 'Estanco', detalle: 'Reserva lo que quieras' },
	{ href: '/canciones', texto: 'Canciones', detalle: 'La playlist de la fiesta' },
	{ href: '/juegos', texto: 'Juegos', detalle: 'Propón a qué jugamos' },
	{ href: '/fotos', texto: 'Fotos', detalle: 'El carrete de la fiesta' },
];

interface Props {
	tema?: Tema;
}
const { tema = 'estanco' } = Astro.props;

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const actual = (href: string) => ruta === href;
---

<header data-barra data-nav class="sticky top-0 z-40 bg-granate pt-[env(safe-area-inset-top)] text-crema shadow-chapa">
	<nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4" aria-label="Principal">
		<a href="/" aria-label="Trio Feliz, inicio"><Marca tema={tema} /></a>

		<ul class="hidden gap-6 text-sm font-bold uppercase tracking-wider lg:flex">
			{
				enlaces.map((e) => (
					<li>
						<a
							href={e.href}
							aria-current={actual(e.href) ? 'page' : undefined}
							class="decoration-2 underline-offset-8 hover:text-amarillo hover:underline aria-[current=page]:text-amarillo aria-[current=page]:underline"
						>
							{e.texto}
						</a>
					</li>
				))
			}
		</ul>

		<!-- Hamburguesa (móvil y tablet) -->
		<button
			type="button"
			data-menu-boton
			aria-expanded="false"
			aria-controls="menu-movil"
			aria-label="Menú"
			class="group -mr-2 flex size-11 items-center justify-center rounded-full text-crema active:bg-granate-oscuro lg:hidden"
		>
			<svg viewBox="0 0 24 24" class="size-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
				<path class="origin-center transition-transform duration-200 group-aria-expanded:translate-y-[5px] group-aria-expanded:rotate-45" d="M4 7h16" />
				<path class="transition-opacity duration-150 group-aria-expanded:opacity-0" d="M4 12h16" />
				<path class="origin-center transition-transform duration-200 group-aria-expanded:-translate-y-[5px] group-aria-expanded:-rotate-45" d="M4 17h16" />
			</svg>
		</button>
	</nav>

	<!-- Menú desplegable: cuelga de la cabecera y ocupa el ancho -->
	<div
		id="menu-movil"
		hidden
		class="menu absolute inset-x-0 top-full max-h-[calc(100dvh-3.5rem-env(safe-area-inset-top))] overflow-y-auto overscroll-contain border-t-2 border-amarillo/40 bg-granate-oscuro shadow-[0_12px_24px_rgb(0_0_0/0.35)] lg:hidden"
	>
		<ul class="mx-auto max-w-lg space-y-1.5 p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
			{
				enlaces.map((e) => (
					<li>
						<a
							href={e.href}
							aria-current={actual(e.href) ? 'page' : undefined}
							class="flex flex-col rounded-lg px-4 py-3 text-crema active:bg-granate aria-[current=page]:bg-granate aria-[current=page]:text-amarillo"
						>
							<span class="rotulo text-lg">{e.texto}</span>
							<span class="text-sm text-crema/70">{e.detalle}</span>
						</a>
					</li>
				))
			}
			<li>
				<a href="/#asistencia" class="flex flex-col rounded-lg border-2 border-amarillo/60 px-4 py-3 text-amarillo active:bg-granate">
					<span class="rotulo text-lg">Confirmar asistencia</span>
					<span class="text-sm text-crema/70">¿Vienes o qué?</span>
				</a>
			</li>
		</ul>
	</div>
</header>

<style>
	.menu:not([hidden]) {
		animation: baja 0.2s ease-out;
	}
	@keyframes baja {
		from {
			opacity: 0;
			transform: translateY(-0.5rem);
		}
	}
</style>

<script>
	const cabecera = document.querySelector<HTMLElement>('[data-nav]');
	const boton = cabecera?.querySelector<HTMLButtonElement>('[data-menu-boton]');
	const menu = cabecera?.querySelector<HTMLElement>('#menu-movil');

	if (cabecera && boton && menu) {
		const abrir = (si: boolean) => {
			menu.hidden = !si;
			boton.setAttribute('aria-expanded', String(si));
		};
		boton.addEventListener('click', () => abrir(menu.hidden === true));
		// Se cierra al elegir (también "Asistencia", que salta a un ancla de la home), con Esc,
		// al tocar fuera o si la pantalla pasa a escritorio
		menu.addEventListener('click', (ev) => (ev.target as HTMLElement).closest('a') && abrir(false));
		document.addEventListener('keydown', (ev) => {
			if (ev.key === 'Escape' && !menu.hidden) {
				abrir(false);
				boton.focus();
			}
		});
		document.addEventListener('click', (ev) => !cabecera.contains(ev.target as Node) && abrir(false));
		matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && abrir(false));
	}
</script>
