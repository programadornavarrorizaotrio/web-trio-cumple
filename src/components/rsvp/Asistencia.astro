			radial-gradient(circle at 100% 100%, transparent var(--muesca), #000 calc(var(--muesca) + 0.5px)) top right / 51% 100% no-repeat;
		mask: radial-gradient(circle at 0 100%, transparent var(--muesca), #000 calc(var(--muesca) + 0.5px)) top left / 51% 100% no-repeat,
			radial-gradient(circle at 100% 100%, transparent var(--muesca), #000 calc(var(--muesca) + 0.5px)) top right / 51% 100% no-repeat;
