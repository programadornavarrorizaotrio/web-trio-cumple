---
import Button from '../common/Button.astro';
import CamposAsistencia from './CamposAsistencia.astro';

// Asistencia: se rellena en el registro; aquí se ve el resumen y se puede cambiar.
---

<div data-asistencia class="mx-auto max-w-md">
	<!-- Resumen -->
	<div data-resumen hidden class="rounded-lg border-2 border-granate/15 bg-white p-5 text-tinta shadow-chapa">
		<p class="text-xs font-black uppercase tracking-[0.2em] text-granate">Tu respuesta</p>
		<p data-r-titulo class="rotulo mt-2 text-3xl text-granate"></p>
		<ul data-r-detalle class="mt-3 space-y-1 text-sm font-bold text-tinta-suave"></ul>
		<Button data-cambiar variante="granate" class="mt-5 w-full">Cambiar respuesta</Button>
	</div>

	<!-- Formulario -->
	<form data-form hidden class="space-y-5 rounded-lg border-2 border-granate/15 bg-white p-5 text-tinta shadow-chapa">
		<p data-sin-respuesta class="text-tinta-suave">Aún no nos has dicho si vienes.</p>
		<CamposAsistencia />
		<div class="flex gap-3">
			<Button data-cancelar type="button" variante="borde" class="flex-1 text-granate" hidden>Cancelar</Button>
			<Button type="submit" class="flex-1">Guardar</Button>
		</div>
	</form>

	<p data-sin-sesion hidden class="rounded-lg bg-crema p-5 text-center text-tinta shadow-chapa">
		<a href="/registro" class="font-bold text-granate underline underline-offset-4">Regístrate</a> para decirnos si vienes.
	</p>
</div>

<script>
	import { obtenerAsistencia, guardarAsistencia, leerCampos, type Asistencia } from './datos';
	import { invitadoActual } from '../registro/sesion';

	const raiz = document.querySelector<HTMLElement>('[data-asistencia]')!;
	const resumen = raiz.querySelector<HTMLElement>('[data-resumen]')!;
	const form = raiz.querySelector<HTMLFormElement>('[data-form]')!;
	const cancelar = form.querySelector<HTMLElement>('[data-cancelar]')!;
	let actual: Asistencia | null = null;

	function mostrarResumen(a: Asistencia) {
		resumen.querySelector('[data-r-titulo]')!.textContent = a.asiste ? '¡Vienes! 🎉' : 'No vienes 😢';
		const lineas = a.asiste
			? [
					a.acompanantes ? `Con ${a.acompanantes} acompañante${a.acompanantes > 1 ? 's' : ''}` : 'Sin acompañantes',
					`Alergias: ${a.alergias ?? 'ninguna'}`,
				]
			: ['Si cambias de idea, aún estás a tiempo.'];
		resumen.querySelector('[data-r-detalle]')!.replaceChildren(
			...lineas.map((t) => Object.assign(document.createElement('li'), { textContent: t })),
		);
		resumen.hidden = false;
		form.hidden = true;
	}

	function mostrarFormulario() {
		form.querySelector<HTMLElement>('[data-sin-respuesta]')!.hidden = !!actual;
		cancelar.hidden = !actual;
		if (actual) {
			form.querySelector<HTMLInputElement>(`input[name="asiste"][value="${actual.asiste ? 'si' : 'no'}"]`)!.checked = true;
			(form.elements.namedItem('acompanantes') as HTMLInputElement).value = String(actual.acompanantes);
			(form.elements.namedItem('alergias') as HTMLInputElement).value = actual.alergias ?? '';
			form.dispatchEvent(new Event('rellenado'));
		}
		resumen.hidden = true;
		form.hidden = false;
	}

	if (!invitadoActual()) {
		raiz.querySelector<HTMLElement>('[data-sin-sesion]')!.hidden = false;
	} else {
		actual = await obtenerAsistencia();
		actual ? mostrarResumen(actual) : mostrarFormulario();
	}

	resumen.querySelector('[data-cambiar]')!.addEventListener('click', mostrarFormulario);
	cancelar.addEventListener('click', () => actual && mostrarResumen(actual));
	form.addEventListener('submit', async (ev) => {
		ev.preventDefault();
		actual = await guardarAsistencia(leerCampos(form));
		mostrarResumen(actual);
	});
</script>
