		mask: radial-gradient(circle at 0 0, transparent var(--muesca), #000 calc(var(--muesca) + 0.5px)) top left / 51% 100% no-repeat,
			radial-gradient(circle at 100% 0, transparent var(--muesca), #000 calc(var(--muesca) + 0.5px)) top right / 51% 100% no-repeat;
