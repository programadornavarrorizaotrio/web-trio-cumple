			font-size: 3.6rem;
		}
	}

	/* ===== Animación ===== */
	@media (prefers-reduced-motion: no-preference) {
		.reflejos {
			animation: reflejos 5s linear infinite;
		}
		.luciernagas i {
			animation: parpadeo 2.6s ease-in-out infinite;
			animation-delay: var(--d);
		}
		.plato {
			animation: mecer 6s ease-in-out infinite;
		}
		.grande + .grande .plato {
			animation-delay: -3s;
		}
		.flota {
			animation: respirar 3.5s ease-in-out infinite;
			transform-origin: 50% 100%;
		}
		.caja:not([hidden]),
		.resultado:not([hidden]) {
			animation: sale 0.4s cubic-bezier(0.3, 1.6, 0.5, 1);
		}
		.ranita.nueva {
			animation: sube 0.5s cubic-bezier(0.3, 1.6, 0.5, 1);
			transform-origin: 50% 100%;
		}
	}
	@keyframes sale {
		from {
			opacity: 0;
			scale: 0.9;
		}
	}
	@keyframes sube {
		from {
			opacity: 0;
			transform: translateY(-2rem) scale(0.6);
		}
	}
	@keyframes reflejos {
		to {
			transform: translateY(1.9rem);
		}
	}
	@keyframes mecer {
		50% {
			transform: translateY(0.25rem) rotate(1.2deg);
		}
	}
	@keyframes respirar {
		50% {
			transform: scale(1.02, 0.98);
		}
	}
	@keyframes parpadeo {
		0%,
		100% {
			opacity: 0.15;
			transform: translate(0, 0);
		}
		50% {
			opacity: 1;
			transform: translate(6px, -8px);
		}
	}
</style>

<script>
	import { obtenerAsistencia, guardarAsistencia, type Asistencia } from './datos';
	import { invitadoActual } from '../registro/sesion';

	const MAX = 5;
	const raiz = document.querySelector<HTMLElement>('[data-asistencia]')!;
	const pads = raiz.querySelector<HTMLElement>('[data-pads]')!;
	const rana = raiz.querySelector<HTMLElement>('[data-rana]')!;
	const hojas = new Map<string, HTMLElement>();
	raiz.querySelectorAll<HTMLElement>('[data-hoja]').forEach((h) => hojas.set(h.dataset.hoja!, h));
	const vistas = new Map<string, HTMLElement>();
	raiz.querySelectorAll<HTMLElement>('[data-vista]').forEach((v) => vistas.set(v.dataset.vista!, v));
	const formSi = vistas.get('si') as HTMLFormElement;
	const formNo = vistas.get('no') as HTMLFormElement;
	const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
	// La pose de la rana en cada estado coincide con el nombre del estado (ver `poses` arriba)
	const imagenes = [...rana.querySelectorAll<HTMLElement>('[data-pose-img]')];
	function ponerPose(pose: string) {
		rana.dataset.pose = pose;
		imagenes.forEach((i) => i.classList.toggle('activa', i.dataset.poseImg === pose));
	}
	ponerPose('ninguna');

	let guardada: Asistencia | null = null;
	let sitio = 'ninguna'; // nenúfar donde está la rana
	let acompanantes = 0;

	const mostrar = (nombre: string) => vistas.forEach((v, n) => (v.hidden = n !== nombre));

	// ---- La rana ----
	function destino(clave: string) {
		const c = pads.getBoundingClientRect();
		const p = hojas.get(clave)!.querySelector('svg')!.getBoundingClientRect();
		return {
			x: p.left - c.left + p.width / 2 - rana.offsetWidth / 2,
			y: p.top - c.top + p.height * 0.62 - rana.offsetHeight,
		};
	}
	function colocar() {
		const d = destino(sitio);
		rana.style.transform = `translate(${d.x}px, ${d.y}px)`;
	}
	function saltarA(clave: string) {
		if (clave === sitio) return;
		const desde = destino(sitio);
		const hasta = destino(clave);
		sitio = clave;
		raiz.dataset.estado = clave;
		hojas.forEach((h, n) => n !== 'ninguna' && h.setAttribute('aria-checked', String(n === clave)));
		rana.style.transform = `translate(${hasta.x}px, ${hasta.y}px)`;
		if (quieto) {
			ponerPose(clave);
			return;
		}
		setTimeout(() => ponerPose(clave), 330);
		const alto = Math.min(desde.y, hasta.y) - 70;
		rana.animate(
			[
				{ transform: `translate(${desde.x}px, ${desde.y}px) scale(1.12, 0.86)`, offset: 0 },
				{ transform: `translate(${(desde.x + hasta.x) / 2}px, ${alto}px) scale(0.95, 1.07)`, offset: 0.45 },
				{ transform: `translate(${hasta.x}px, ${hasta.y}px) scale(1.12, 0.86)`, offset: 0.85 },
				{ transform: `translate(${hasta.x}px, ${hasta.y}px) scale(1, 1)`, offset: 1 },
			],
			{ duration: 750, easing: 'ease-in-out' },
		);
		hojas.get(clave)!.querySelector('.onda')?.animate(
			[
				{ opacity: 0.9, transform: 'scale(0.6)' },
				{ opacity: 0, transform: 'scale(1.7)' },
			],
			{ duration: 1100, delay: 600, easing: 'ease-out' },
		);
	}

	// ---- Acompañantes = ranitas ----
	const ranitas = [...raiz.querySelectorAll<HTMLElement>('[data-ranita]')];
	function pintarRanitas(nueva = false) {
		ranitas.forEach((r, i) => {
			const antes = r.hidden;
			r.hidden = i >= acompanantes;
			r.classList.toggle('nueva', nueva && antes && !r.hidden);
		});
		raiz.querySelector<HTMLElement>('[data-vacio]')!.hidden = acompanantes > 0;
		raiz.querySelector('[data-cuenta]')!.textContent = String(acompanantes);
		raiz.querySelector('[data-cuenta-texto]')!.textContent = acompanantes === 1 ? 'acompañante' : 'acompañantes';
		raiz.querySelector<HTMLButtonElement>('[data-menos]')!.disabled = acompanantes <= 0;
		raiz.querySelector<HTMLButtonElement>('[data-mas]')!.disabled = acompanantes >= MAX;
	}
	raiz.querySelector('[data-menos]')!.addEventListener('click', () => {
		acompanantes = Math.max(0, acompanantes - 1);
		pintarRanitas();
	});
	raiz.querySelector('[data-mas]')!.addEventListener('click', () => {
		acompanantes = Math.min(MAX, acompanantes + 1);
		pintarRanitas(true);
	});

	// ---- Elegir nenúfar ----
	function elegir(valor: 'si' | 'no') {
		saltarA(valor);
		if (valor === 'si' && guardada?.asiste) {
			acompanantes = guardada.acompanantes;
			(formSi.elements.namedItem('alergias') as HTMLInputElement).value = guardada.alergias ?? '';
		}
		pintarRanitas();
		mostrar(valor);
		// Si ya había respuesta se puede volver atrás
		raiz.querySelectorAll<HTMLElement>('[data-cancelar]').forEach((b) => (b.hidden = !guardada));
	}
	['si', 'no'].forEach((v) => hojas.get(v)!.addEventListener('click', () => elegir(v as 'si' | 'no')));

	// ---- Entrada ----
	function numeroDe(texto: string) {
		let h = 0;
		for (const c of texto) h = (h * 31 + c.charCodeAt(0)) % 9000;
		return String(h + 1000);
	}
	function mostrarResultado(a: Asistencia) {
		guardada = a;
		const pagina = a.asiste ? 'si' : 'no';
		saltarA(pagina);
		if (a.asiste) {
			const nombre = invitadoActual()?.nombre ?? '';
			raiz.querySelector('[data-e-nombre]')!.textContent = nombre;
			raiz.querySelector('[data-e-acomp]')!.textContent = a.acompanantes ? `${a.acompanantes} acompañante${a.acompanantes > 1 ? 's' : ''}` : 'Solo tú';
			raiz.querySelector('[data-e-alergias]')!.textContent = a.alergias ?? 'Ninguna';
			raiz.querySelector('[data-e-numero]')!.textContent = numeroDe(nombre + a.acompanantes);
		}
		raiz.querySelector<HTMLElement>('[data-aviso]')!.hidden = true;
		mostrar(a.asiste ? 'resultado-si' : 'resultado-no');
	}

	async function guardar(a: Asistencia) {
		mostrarResultado(await guardarAsistencia(a));
	}
	formSi.addEventListener('submit', (ev) => {
		ev.preventDefault();
		const alergias = String(new FormData(formSi).get('alergias') ?? '').trim() || null;
		guardar({ asiste: true, acompanantes, alergias });
	});
	formNo.addEventListener('submit', (ev) => {
		ev.preventDefault();
		guardar({ asiste: false, acompanantes: 0, alergias: null });
	});
	raiz.querySelectorAll('[data-cancelar]').forEach((b) => b.addEventListener('click', () => guardada && mostrarResultado(guardada)));
	raiz.querySelectorAll('[data-cambiar]').forEach((b) =>
		b.addEventListener('click', () => {
			if (!guardada) return;
			elegir(guardada.asiste ? 'si' : 'no');
		}),
	);

	// Descargar la entrada: se dibuja una imagen propia (entrada.ts), no es una captura de la web
	raiz.querySelector<HTMLButtonElement>('[data-descargar]')!.addEventListener('click', async (ev) => {
		const boton = ev.currentTarget as HTMLButtonElement;
		const aviso = raiz.querySelector<HTMLElement>('[data-aviso]')!;
		aviso.hidden = true;
		boton.disabled = true;
		try {
			const { crearEntrada } = await import('./entrada');
			const texto = (campo: string) => raiz.querySelector(`[data-e-${campo}]`)!.textContent ?? '';
			const blob = await crearEntrada({
				nombre: texto('nombre'),
				fecha: raiz.dataset.fecha ?? '',
				llegada: raiz.dataset.llegada ?? '',
				lugar: raiz.dataset.lugar ?? '',
				contigo: texto('acomp'),
				alergias: texto('alergias'),
				numero: texto('numero'),
				edicion: Number(raiz.dataset.edicion),
				rana: raiz.dataset.rana ?? '',
			});
			const enlace = document.createElement('a');
			enlace.href = URL.createObjectURL(blob);
			enlace.download = 'entrada-trioland.png';
			enlace.click();
			setTimeout(() => URL.revokeObjectURL(enlace.href), 1000);
		} catch {
			aviso.hidden = false;
		} finally {
			boton.disabled = false;
		}
	});

	// ---- Arranque ----
	raiz.dataset.listo = '';
	pads.setAttribute('data-listo', '');
	colocar();
	new ResizeObserver(colocar).observe(pads);

	if (!invitadoActual()) {
		pads.hidden = true;
		mostrar('sin-sesion');
	} else {
		const a = await obtenerAsistencia();
		if (a) mostrarResultado(a);
	}
</script>
