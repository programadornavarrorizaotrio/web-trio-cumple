---
// Pestaña "Rana" del admin: escribir lo que dice la rana en la web, a quién y hasta cuándo. La lógica, en rana.ts.
import { getImage } from 'astro:assets';
import Button from '../common/Button.astro';
import { POSES } from '../rana/poses';
import { EQUIPOS } from '../juegos/liga';
import '../rana/rana.css';

const poses = await Promise.all(POSES.map(async (p) => ({ ...p, src: (await getImage({ src: p.imagen, width: 280, format: 'webp' })).src })));
const destinos = [
	{ id: 'todos', texto: 'Todos' },
	{ id: 'sin-responder', texto: 'Sin responder' },
	{ id: 'vienen', texto: 'Los que vienen' },
	{ id: 'equipo', texto: 'Un equipo' },
	{ id: 'invitado', texto: 'Una persona' },
];
const campo =
	'mt-1 block w-full min-w-0 rounded border-2 border-granate/25 bg-white px-3 py-2.5 font-normal text-tinta placeholder:text-tinta-suave/50 focus:border-granate focus:outline-none';
const chip =
	'block cursor-pointer rounded-full border-2 border-granate/20 px-3 py-2 text-sm font-bold text-granate peer-checked:border-granate peer-checked:bg-granate peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-granate';
---

<section data-vista="rana" hidden class="space-y-6">
	<form data-form-rana class="space-y-4 rounded-xl bg-white p-4 shadow-chapa">
		<div>
			<h3 class="text-lg text-granate">La rana habla</h3>
			<p class="mt-1 text-sm text-tinta-suave">Se asoma en la web y lo dice. A quien le da a «Vale» ya no le sale más.</p>
		</div>

		<!-- Así se va a ver -->
		<div data-previa class="rana-habla rana-previa" aria-hidden="true">
			<div class="rana-cuerpo"><img data-previa-img src={poses[0].src} alt="" /></div>
			<div class="rana-bocadillo">
				<p data-previa-texto></p>
				<div class="rana-pie"><span class="rana-vale">Vale</span></div>
			</div>
		</div>

		<div>
			<label class="block text-sm font-bold"
				>Qué dice<textarea name="texto" rows="3" required maxlength="160" placeholder="{nombre}, ¿vienes o qué?" class={campo}></textarea></label
			>
			<div class="mt-1.5 flex items-center justify-between gap-3">
				<button type="button" data-poner-nombre class="rounded-full border-2 border-granate/20 px-3 py-1.5 text-xs font-bold text-granate active:bg-amarillo-claro">+ Su nombre</button>
				<span data-quedan class="text-xs text-tinta-suave"></span>
			</div>
		</div>

		<fieldset>
			<legend class="text-sm font-bold">Cómo sale</legend>
			<div class="mt-1.5 grid grid-cols-5 gap-1.5">
				{
					poses.map((p, i) => (
						<label class="min-w-0">
							<input type="radio" name="pose" value={p.id} data-src={p.src} checked={i === 0} class="peer sr-only" />
							<span class="block cursor-pointer overflow-hidden rounded-lg border-2 border-granate/15 bg-crema p-1 text-center peer-checked:border-amarillo peer-checked:bg-amarillo-claro peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-granate">
								<img src={p.src} alt="" class="mx-auto h-14 w-full object-cover object-top" />
								<span class="mt-0.5 block truncate text-[0.65rem] font-bold">{p.texto}</span>
							</span>
						</label>
					))
				}
			</div>
		</fieldset>

		<fieldset>
			<legend class="text-sm font-bold">A quién</legend>
			<div class="mt-1.5 flex flex-wrap gap-1.5">
				{
					destinos.map((d, i) => (
						<label>
							<input type="radio" name="destino" value={d.id} checked={i === 0} class="peer sr-only" />
							<span class={chip}>{d.texto}</span>
						</label>
					))
				}
			</div>
			<label data-elige-equipo hidden class="mt-3 block text-sm font-bold"
				>Equipo<select name="equipo" class={campo}>{EQUIPOS.map((e) => <option value={e.id}>{e.nombre}</option>)}</select></label
			>
			<label data-elige-invitado hidden class="mt-3 block text-sm font-bold"
				>Persona<select name="invitado" class={campo}></select>
				<span class="mt-1 block text-xs font-normal text-tinta-suave">Solo salen los que ya se han registrado: a los demás no les llega.</span></label
			>
		</fieldset>

		<label class="block text-sm font-bold"
			>Hasta cuándo<select name="horas" class={campo}>
				<option value="24">Un día</option>
				<option value="72" selected>Tres días</option>
				<option value="168">Una semana</option>
				<option value="">Hasta que la calléis</option>
			</select></label
		>
		<Button type="submit" tamano="lg" class="w-full">Que lo diga</Button>
	</form>

	<div>
		<h3 class="text-lg text-granate">Lo que ha dicho</h3>
		<ul data-lista-rana class="mt-2 space-y-2"></ul>
	</div>
</section>
