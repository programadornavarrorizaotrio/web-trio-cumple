---
// Admin de los organizadores. Todo se pinta en el navegador con las RPC `admin_*` (ver datos.ts): la página
// en sí no tiene datos, y sin sesión de admin el servidor no devuelve nada.
import Button from '../common/Button.astro';
import AdminRana from './AdminRana.astro';

// Barra de abajo. El Wordle, los ajustes y el PIN van dentro de Liga: se tocan poco.
const pestanas = [
	{ id: 'inicio', texto: 'Inicio', icono: '🏠' },
	{ id: 'invitados', texto: 'Invitados', icono: '👥' },
	{ id: 'premios', texto: 'Premios', icono: '🎁' },
	{ id: 'liga', texto: 'Liga', icono: '🏆' },
	{ id: 'rana', texto: 'Rana', icono: '🐸' },
];
const campo =
	'mt-1 block w-full min-w-0 rounded border-2 border-granate/25 bg-white px-3 py-2.5 text-tinta placeholder:text-tinta-suave/50 focus:border-granate focus:outline-none';
---

<div data-admin class="text-tinta">
	<p data-admin-estado class="rounded-lg bg-crema-oscuro p-5 text-center font-bold text-tinta-suave">Cargando…</p>

	<div data-admin-panel hidden class="pb-24">
		<!-- Inicio: lo que más se hace, a mano, y el estado de la fiesta de un vistazo -->
		<section data-vista="inicio" class="space-y-6">
			<div class="grid grid-cols-2 gap-3">
				<button type="button" data-ir="premios" data-enfocar="codigo" class="rounded-xl bg-granate p-4 text-left text-amarillo shadow-chapa active:translate-y-0.5">
					<span class="block text-3xl" aria-hidden="true">🎁</span>
					<span class="mt-2 block text-lg font-black leading-tight">Canjear premio</span>
					<span class="mt-0.5 block text-xs font-bold text-amarillo-claro/80">Con el código del invitado</span>
				</button>
				<button type="button" data-ir="invitados" data-enfocar="filtro" class="rounded-xl bg-amarillo p-4 text-left text-granate-oscuro shadow-chapa-amarillo active:translate-y-0.5">
					<span class="block text-3xl" aria-hidden="true">🔎</span>
					<span class="mt-2 block text-lg font-black leading-tight">Buscar invitado</span>
					<span class="mt-0.5 block text-xs font-bold text-granate/70">Ver o corregir su ficha</span>
				</button>
			</div>
			<div>
				<h3 class="text-lg text-granate">La fiesta</h3>
				<p class="text-xs text-tinta-suave">Toca una cifra para ver quiénes son.</p>
				<div data-cifras class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-4"></div>
			</div>
			<div>
				<h3 class="text-lg text-granate">Equipos</h3>
				<ul data-equipos class="mt-2 space-y-1.5"></ul>
			</div>
		</section>

		<!-- Invitados -->
		<section data-vista="invitados" hidden class="space-y-3">
			<div class="flex gap-2">
				<input data-filtro type="search" placeholder="Buscar por nombre o apodo…" autocomplete="off" class={campo + ' mt-0'} />
				<Button type="button" data-nuevo-invitado class="shrink-0">Añadir</Button>
			</div>
			<div data-filtros class="-mx-4 flex gap-1.5 overflow-x-auto px-4 pb-1 [scrollbar-width:none]"></div>
			<ul data-lista-invitados class="space-y-2"></ul>
		</section>

		<!-- Premios -->
		<section data-vista="premios" hidden class="space-y-6">
			<form data-form-codigo class="rounded-xl bg-white p-4 shadow-chapa">
				<h3 class="text-xl text-granate">Canjear un premio</h3>
				<p class="mt-1 text-sm text-tinta-suave">Escribe el código que te enseña el invitado en su móvil.</p>
				<input
					name="codigo"
					required
					placeholder="A1B2C3-D4E5F6"
					autocomplete="off"
					autocapitalize="characters"
					spellcheck="false"
					class={campo + ' mt-3 text-center font-mono text-2xl font-bold uppercase tracking-widest'}
				/>
				<Button type="submit" tamano="lg" class="mt-3 w-full">Buscar código</Button>
				<div data-resultado-codigo hidden class="mt-4"></div>
			</form>
			<div>
				<h3 class="text-lg text-granate">Premios</h3>
				<p class="mt-1 text-sm text-tinta-suave">El requisito no se cambia aquí; el texto sí (lo ven los invitados en Premios).</p>
				<ul data-lista-premios class="mt-3 space-y-3"></ul>
			</div>
		</section>

		<!-- Liga: Wordle, ajustes y PIN (lo que se toca de vez en cuando) -->
		<section data-vista="liga" hidden class="space-y-6">
			<form data-form-wordle class="space-y-3 rounded-xl bg-white p-4 shadow-chapa">
				<h3 class="text-lg text-granate">Palabras del Wordle <span data-cuenta-wordle class="text-sm text-tinta-suave"></span></h3>
				<p class="text-sm text-tinta-suave">Sale una al día, en orden. De 4 a 8 letras; las tildes se quitan y la Ñ vale.</p>
				<ul data-lista-wordle class="flex flex-wrap gap-2"></ul>
				<textarea name="palabras" rows="3" required placeholder={'Una por línea o separadas por comas\nRANA, CAÑAS, TRIO'} class={campo + ' font-mono uppercase placeholder:normal-case'}></textarea>
				<Button type="submit" class="w-full">Añadir palabras</Button>
			</form>

			<form data-form-palabra class="space-y-3 rounded-xl bg-white p-4 shadow-chapa">
				<h3 class="text-lg text-granate">Palabra secreta</h3>
				<p class="text-sm text-tinta-suave">La rana insinúa en Participantes que hay algo oculto, y quien le diga la palabra se lleva la carta Fantasma. Da igual mayúsculas y tildes, y si se quedan cerca les dice «casi…». Sin palabra, la rana no sale.</p>
				<input name="palabra" maxlength="40" autocomplete="off" placeholder="Sin palabra: no se puede conseguir" class={campo} />
				<Button type="submit" class="w-full">Guardar palabra</Button>
				<div>
					<p class="text-sm font-bold">Quién tiene cada carta</p>
					<ul data-lista-acabados class="mt-1.5 flex flex-wrap gap-1.5"></ul>
				</div>
			</form>

			<form data-form-ajustes class="space-y-4 rounded-xl bg-white p-4 shadow-chapa">
				<h3 class="text-lg text-granate">Ajustes de la liga</h3>
				<div class="grid grid-cols-2 gap-3">
					<label class="text-sm font-bold">Tiradas entre semana<input name="tiradasEntreSemana" type="number" inputmode="numeric" min="0" max="10" required class={campo} /></label>
					<label class="text-sm font-bold">Tiradas en finde<input name="tiradasFinDeSemana" type="number" inputmode="numeric" min="0" max="10" required class={campo} /></label>
				</div>
				<label class="block text-sm font-bold"
					>LP que quita el diablillo<input name="penalizacionDiablo" type="number" inputmode="numeric" min="0" max="100" required class={campo} /></label
				>
				<label class="block text-sm font-bold"
					>Cierre de la liga<input name="cierreLiga" type="datetime-local" required class={campo} />
					<span class="mt-1 block text-xs font-normal text-tinta-suave">Desde ese momento no se puede tirar ni apostar y se deciden podio y equipo ganador.</span>
				</label>
				<Button type="submit" class="w-full">Guardar ajustes</Button>
			</form>

			<form data-form-pin class="space-y-3 rounded-xl bg-white p-4 shadow-chapa">
				<h3 class="text-lg text-granate">PIN de la fiesta</h3>
				<p class="text-sm text-tinta-suave">El código que va en el mensaje de WhatsApp para registrarse. Al cambiarlo, el anterior deja de valer (quien ya está registrado sigue dentro).</p>
				<input name="pin" required minlength="4" maxlength="20" autocomplete="off" placeholder="Nuevo PIN" class={campo} />
				<Button type="submit" variante="granate" class="w-full">Cambiar PIN</Button>
			</form>
		</section>

		<!-- Rana: lo que dice la mascota en la web -->
		<AdminRana />

		<!-- Barra de abajo, al alcance del pulgar -->
		<nav class="fixed inset-x-0 bottom-0 z-20 border-t-2 border-granate/15 bg-crema/95 pb-[env(safe-area-inset-bottom)] backdrop-blur" aria-label="Secciones del admin">
			<div class="mx-auto flex max-w-xl">
				{
					pestanas.map((p, i) => (
						<button
							type="button"
							data-pestana={p.id}
							aria-pressed={i === 0 ? 'true' : 'false'}
							class="flex flex-1 flex-col items-center gap-0.5 py-2 text-[0.7rem] font-black uppercase tracking-wider text-tinta-suave aria-pressed:text-granate"
						>
							<span class="grid h-8 w-12 place-items-center rounded-full text-xl" data-icono aria-hidden="true">{p.icono}</span>
							{p.texto}
						</button>
					))
				}
			</div>
		</nav>
	</div>

	<!-- Avisos: flotan encima de la barra para que se vean aunque hayas bajado -->
	<p
		data-aviso
		hidden
		role="status"
		class="fixed inset-x-4 bottom-[calc(4.75rem+env(safe-area-inset-bottom))] z-30 mx-auto max-w-md rounded-lg border-2 px-4 py-3 text-sm font-bold shadow-chapa"
	>
	</p>

	<!-- Ficha de un invitado -->
	<dialog data-ficha class="m-auto w-[min(100%-2rem,28rem)] rounded-lg bg-crema p-0 text-tinta backdrop:bg-tinta/60">
		<form data-form-invitado method="dialog" class="space-y-4 p-5">
			<div class="flex items-start justify-between gap-3">
				<h3 data-ficha-titulo class="text-xl text-granate"></h3>
				<button type="button" data-cerrar-ficha class="text-2xl leading-none text-tinta-suave" aria-label="Cerrar">×</button>
			</div>
			<p data-ficha-info class="text-sm text-tinta-suave"></p>
			<label class="block text-sm font-bold">Nombre<input name="nombre" required maxlength="80" class={campo} /></label>
			<label class="block text-sm font-bold"
				>Número de cromo<input name="numero" type="number" min="1" placeholder="Al final" class={campo} /></label
			>
			<label class="flex items-center gap-2 text-sm font-bold"><input name="especial" type="checkbox" class="size-5 accent-granate" /> Cromo especial (el trío)</label>
			<label class="flex items-center gap-2 text-sm font-bold"><input name="visible" type="checkbox" class="size-5 accent-granate" /> Visible (si no, no sale al buscar ni en el álbum)</label>
			<Button type="submit" class="w-full">Guardar</Button>

			<div data-ficha-rana class="border-t-2 border-granate/15 pt-4">
				<Button type="button" data-decirle variante="borde" class="w-full text-granate">🐸 Que la rana le diga algo</Button>
			</div>

			<div data-ficha-puntos class="space-y-2 border-t-2 border-granate/15 pt-4">
				<h4 class="font-bold text-granate">Corregir sus LP</h4>
				<p class="text-xs text-tinta-suave">Solo para arreglar errores (se le cortó una partida, algo salió mal). Queda apuntado quién lo hizo y por qué.</p>
				<div class="flex gap-2">
					<input name="puntos" type="number" min="-500" max="500" placeholder="+10 / −5" class={campo + ' mt-0 w-28'} />
					<input name="motivo" maxlength="140" placeholder="Motivo (se le cortó la partida…)" class={campo + ' mt-0'} />
				</div>
				<Button type="button" data-ajustar variante="borde" class="w-full text-granate">Aplicar corrección</Button>
			</div>

			<div data-ficha-foto class="space-y-2 border-t-2 border-granate/15 pt-4">
				<h4 class="font-bold text-granate">Foto del cromo</h4>
				<img data-ficha-foto-img alt="" class="aspect-[8/5] w-full rounded object-cover" />
				<p class="text-xs text-tinta-suave">La subió al registrarse. Si no es apropiada, quítala: su cromo vuelve a la inicial.</p>
				<Button type="button" data-quitar-foto variante="borde" class="w-full text-granate">Quitar foto</Button>
			</div>

			<div data-ficha-movil class="space-y-2 border-t-2 border-granate/15 pt-4">
				<h4 class="font-bold text-granate">Nuevo móvil</h4>
				<p class="text-xs text-tinta-suave">Cierra su sesión para que se vuelva a registrar (cambió de móvil o se registró otro por él). Conserva asistencia, equipo y puntos.</p>
				<Button type="button" data-nuevo-movil variante="borde" class="w-full text-granate">Dejar que se registre otra vez</Button>
			</div>
			<p data-ficha-error hidden role="alert" class="rounded border-2 border-granate bg-granate/10 px-3 py-2 text-sm font-bold text-granate"></p>
		</form>
	</dialog>
</div>

<script>
	import * as admin from './datos';
	import { usaBD } from '../../lib/rpc';
	import { equipoPorId } from '../juegos/liga';
	import { urlFoto } from '../cromos/datos';
	import { montarRana } from './rana';
	import { ACABADOS } from '../cromos/acabados';
	import type { InvitadoAdmin } from './datos';

	const raiz = document.querySelector<HTMLElement>('[data-admin]')!;
	const $ = <T extends HTMLElement = HTMLElement>(sel: string) => raiz.querySelector<T>(sel)!;
	const estado = $('[data-admin-estado]');
	const aviso = $('[data-aviso]');

	function el<K extends keyof HTMLElementTagNameMap>(tag: K, clase = '', texto?: string) {
		const e = document.createElement(tag);
		if (clase) e.className = clase;
		if (texto !== undefined) e.textContent = texto;
		return e;
	}

	let temporizador: number | undefined;
	function avisar(texto: string, bien = true) {
		aviso.textContent = (bien ? '✓ ' : '⚠ ') + texto;
		aviso.classList.toggle('aviso-mal', !bien);
		aviso.hidden = false;
		clearTimeout(temporizador);
		temporizador = window.setTimeout(() => (aviso.hidden = true), bien ? 3500 : 6000);
	}

	/** Ejecuta una acción con el botón bloqueado y avisa del resultado */
	async function accion(boton: HTMLButtonElement | null, hacer: () => Promise<string | void>) {
		if (boton) boton.disabled = true;
		try {
			const texto = await hacer();
			if (texto) avisar(texto);
		} catch (e) {
			avisar(admin.mensajeError(e), false);
		} finally {
			if (boton) boton.disabled = false;
		}
	}

	const rana = montarRana(raiz, { avisar, accion });

	// ── Pestañas ──
	const cargadas = new Set<string>();
	const cargar: Record<string, () => Promise<void>> = {
		inicio: pintarResumen,
		invitados: pintarInvitados,
		premios: pintarPremios,
		liga: async () => {
			await Promise.all([pintarAjustes(), pintarWordle(), pintarAcabados()]);
		},
		rana: () => rana.pintar(),
	};
	async function abrir(id: string) {
		raiz.querySelectorAll<HTMLButtonElement>('[data-pestana]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pestana === id)));
		raiz.querySelectorAll<HTMLElement>('[data-vista]').forEach((v) => (v.hidden = v.dataset.vista !== id));
		// Al principio de la sección, sin que la tape la cabecera fija
		const cabecera = document.querySelector<HTMLElement>('header[data-barra]')?.offsetHeight ?? 0;
		window.scrollTo({ top: raiz.getBoundingClientRect().top + window.scrollY - cabecera - 16 });
		if (!cargadas.has(id)) {
			cargadas.add(id);
			await cargar[id]().catch((e) => avisar(admin.mensajeError(e), false));
		}
	}
	raiz.querySelectorAll<HTMLButtonElement>('[data-pestana]').forEach((b) => b.addEventListener('click', () => void abrir(b.dataset.pestana!)));

	/** Atajos del inicio: abren una pestaña y, si toca, filtran la lista o ponen el cursor en un campo */
	async function ir(destino: string, filtroInicial?: string, enfocar?: string) {
		if (filtroInicial) {
			filtroRapido = filtroInicial;
			filtro.value = '';
		}
		await abrir(destino);
		if (destino === 'invitados') filtrar();
		if (enfocar === 'codigo') $<HTMLInputElement>('[data-form-codigo] [name="codigo"]').focus();
		if (enfocar === 'filtro') filtro.focus();
	}
	raiz.querySelectorAll<HTMLButtonElement>('[data-ir]').forEach((b) => b.addEventListener('click', () => void ir(b.dataset.ir!, undefined, b.dataset.enfocar)));
	/** Tras un cambio, lo que dependa de él se vuelve a cargar al abrir su pestaña */
	const caducar = (...ids: string[]) => ids.forEach((id) => cargadas.delete(id));

	// ── Resumen ──
	async function pintarResumen() {
		const r = await admin.resumen();
		/** Una cifra; si lleva destino, se puede tocar y lleva a la lista ya filtrada */
		const cifra = (valor: string | number, texto: string, destino?: { pestana: string; filtro?: string }) => {
			const d = el(destino ? 'button' : 'div', 'min-w-0 rounded-lg bg-white p-3 text-center shadow-chapa');
			const grande = typeof valor === 'number' || valor.length <= 5;
			d.append(
				el('p', `rotulo ${grande ? 'text-3xl' : 'py-1 text-xl'} truncate text-granate`, String(valor)),
				el('p', 'text-xs font-bold uppercase tracking-wider text-tinta-suave', texto + (destino ? ' ›' : '')),
			);
			if (d instanceof HTMLButtonElement) {
				d.type = 'button';
				d.classList.add('active:bg-amarillo-claro');
				d.addEventListener('click', () => void ir(destino!.pestana, destino!.filtro));
			}
			return d;
		};
		$('[data-cifras]').replaceChildren(
			cifra(r.vienen, 'vienen', { pestana: 'invitados', filtro: 'vienen' }),
			cifra(r.personas, 'personas en total'),
			cifra(r.invitados - r.vienen - r.noVienen, 'sin responder', { pestana: 'invitados', filtro: 'sin-responder' }),
			cifra(r.noVienen, 'no vienen', { pestana: 'invitados', filtro: 'no-vienen' }),
			cifra(r.alergias.length, 'con alergias', { pestana: 'invitados', filtro: 'alergias' }),
			cifra(`${r.registrados}/${r.invitados}`, 'registrados', { pestana: 'invitados', filtro: 'sin-registrar' }),
			cifra(r.premiosPorEntregar, 'premios por entregar', { pestana: 'premios' }),
			cifra(r.ligaCerrada ? 'Cerrada' : `${r.jugadores} jug.`, r.ligaCerrada ? 'liga' : 'en la liga', { pestana: 'liga' }),
		);
		$('[data-equipos]').replaceChildren(
			...[...r.equipos]
				.sort((a, b) => b.puntos - a.puntos)
				.map((e) => {
					const li = el('li', 'flex items-center justify-between rounded bg-white px-3 py-2');
					const nombre = el('span', 'font-bold');
					const punto = el('span', 'mr-2 inline-block rounded-full');
					Object.assign(punto.style, { background: equipoPorId(e.equipo).color, width: '0.75rem', height: '0.75rem' });
					nombre.append(punto, equipoPorId(e.equipo).nombre);
					li.append(nombre, el('span', 'text-sm text-tinta-suave', `${e.puntos} LP · ${e.miembros} ${e.miembros === 1 ? 'jugador' : 'jugadores'}`));
					return li;
				}),
		);
	}

	// ── Invitados ──
	let lista: InvitadoAdmin[] = [];
	const filtro = $<HTMLInputElement>('[data-filtro]');
	const normalizar = (t: string) => t.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();

	async function pintarInvitados() {
		lista = await admin.invitados();
		filtrar();
	}

	function etiqueta(texto: string, clase: string) {
		return el('span', `rounded-full px-2 py-0.5 text-[0.7rem] font-black uppercase tracking-wider ${clase}`, texto);
	}

	// Filtros rápidos de la lista (chips con cuántos hay en cada uno)
	const FILTROS: { id: string; texto: string; cumple: (i: InvitadoAdmin) => boolean }[] = [
		{ id: 'todos', texto: 'Todos', cumple: (i) => i.visible },
		{ id: 'vienen', texto: 'Vienen', cumple: (i) => i.visible && i.asiste === true },
		{ id: 'sin-responder', texto: 'Sin responder', cumple: (i) => i.visible && i.asiste === null },
		{ id: 'no-vienen', texto: 'No vienen', cumple: (i) => i.visible && i.asiste === false },
		{ id: 'alergias', texto: 'Alergias', cumple: (i) => !!i.alergias },
		{ id: 'sin-registrar', texto: 'Sin registrar', cumple: (i) => i.visible && !i.registrado },
		{ id: 'ocultos', texto: 'Ocultos', cumple: (i) => !i.visible },
	];
	let filtroRapido = 'todos';

	function pintarFiltros() {
		$('[data-filtros]').replaceChildren(
			...FILTROS.map((f) => {
				const b = el('button', 'shrink-0 rounded-full border-2 border-granate/20 bg-white px-3 py-1.5 text-xs font-black uppercase tracking-wider text-granate aria-pressed:border-granate aria-pressed:bg-granate aria-pressed:text-amarillo');
				b.type = 'button';
				b.setAttribute('aria-pressed', String(f.id === filtroRapido));
				b.append(f.texto, el('span', 'ml-1.5 opacity-70', String(lista.filter(f.cumple).length)));
				b.addEventListener('click', () => {
					filtroRapido = f.id;
					filtrar();
				});
				return b;
			}),
		);
	}

	/** Miniatura: su foto del cromo o la inicial */
	function miniatura(i: InvitadoAdmin) {
		const foto = urlFoto(i.foto);
		if (foto) {
			const img = el('img', 'size-11 shrink-0 rounded-full object-cover');
			img.src = foto;
			img.alt = '';
			img.loading = 'lazy';
			return img;
		}
		return el('span', 'grid size-11 shrink-0 place-items-center rounded-full bg-crema-oscuro text-lg font-black text-granate', i.nombre.trim().charAt(0).toUpperCase());
	}

	function filtrar() {
		const q = normalizar(filtro.value.trim());
		const condicion = FILTROS.find((f) => f.id === filtroRapido)!.cumple;
		// Al buscar por nombre se busca en todos (también ocultos), para no perder a nadie
		const visibles = lista.filter((i) => (q ? normalizar(`${i.nombre} ${i.apodo ?? ''}`).includes(q) : condicion(i)));
		pintarFiltros();
		$('[data-lista-invitados]').replaceChildren(
			...(visibles.length
				? visibles.map((i) => {
						const li = el('li');
						const b = el('button', 'flex w-full items-center gap-3 rounded-lg bg-white px-3 py-2.5 text-left shadow-chapa active:bg-amarillo-claro');
						b.type = 'button';
						const texto = el('span', 'min-w-0 flex-1');
						const linea = el('span', 'flex items-baseline gap-2');
						linea.append(el('span', 'min-w-0 truncate font-bold', i.nombre));
						if (i.apodo) linea.append(el('span', 'min-w-0 truncate text-sm text-tinta-suave', `«${i.apodo}»`));
						const etiquetas = el('span', 'mt-1 flex flex-wrap gap-1');
						etiquetas.append(
							i.asiste === true
								? etiqueta(i.acompanantes ? `Viene +${i.acompanantes}` : 'Viene', 'bg-green-100 text-green-800')
								: i.asiste === false
									? etiqueta('No viene', 'bg-granate/10 text-granate')
									: etiqueta('Sin responder', 'bg-crema-oscuro text-tinta-suave'),
						);
						if (!i.registrado) etiquetas.append(etiqueta('Sin registrar', 'bg-crema-oscuro text-tinta-suave'));
						if (i.equipo) etiquetas.append(etiqueta(`${equipoPorId(i.equipo).nombre} · ${i.puntos} LP`, 'bg-tinta/10 text-tinta'));
						if (i.rol === 'admin') etiquetas.append(etiqueta('Admin', 'bg-granate-oscuro text-amarillo'));
						if (!i.visible) etiquetas.append(etiqueta('Oculto', 'bg-tinta text-crema'));
						texto.append(linea, etiquetas);
						if (i.alergias) texto.append(el('span', 'mt-1 block text-xs font-bold text-granate', `⚠ ${i.alergias}`));
						b.append(miniatura(i), texto, el('span', 'shrink-0 text-xl text-tinta-suave', '›'));
						b.addEventListener('click', () => abrirFicha(i));
						li.append(b);
						return li;
					})
				: [el('li', 'rounded-lg bg-crema-oscuro p-4 text-center text-sm text-tinta-suave', q ? 'Nadie con ese nombre.' : 'Nadie en este grupo.')]),
		);
	}
	filtro.addEventListener('input', filtrar);

	// Ficha
	const ficha = $<HTMLDialogElement>('[data-ficha]');
	const formFicha = $<HTMLFormElement>('[data-form-invitado]');
	const errorFicha = $('[data-ficha-error]');
	let actual: InvitadoAdmin | null = null;
	const campoFicha = (n: string) => formFicha.elements.namedItem(n) as HTMLInputElement;

	function abrirFicha(i: InvitadoAdmin | null) {
		actual = i;
		errorFicha.hidden = true;
		formFicha.reset();
		$('[data-ficha-titulo]').textContent = i ? i.nombre : 'Nuevo invitado';
		const info: string[] = [];
		if (i?.apodo) info.push(`Cromo: «${i.apodo}»${i.frase ? ` — ${i.frase}` : ''}`);
		if (i?.alergias) info.push(`Alergias: ${i.alergias}`);
		$('[data-ficha-info]').textContent = info.join(' · ');
		campoFicha('nombre').value = i?.nombre ?? '';
		campoFicha('numero').value = i ? String(i.numero) : '';
		campoFicha('especial').checked = i?.especial ?? false;
		campoFicha('visible').checked = i?.visible ?? true;
		$('[data-ficha-puntos]').hidden = !i?.equipo;
		$('[data-ficha-movil]').hidden = !i?.registrado;
		$('[data-ficha-rana]').hidden = !i?.registrado || !i.visible;
		const foto = urlFoto(i?.foto ?? null);
		$('[data-ficha-foto]').hidden = !foto;
		if (foto) $<HTMLImageElement>('[data-ficha-foto-img]').src = foto;
		ficha.showModal();
	}

	function errorEnFicha(e: unknown) {
		errorFicha.textContent = admin.mensajeError(e);
		errorFicha.hidden = false;
	}

	$('[data-nuevo-invitado]').addEventListener('click', () => abrirFicha(null));
	$('[data-cerrar-ficha]').addEventListener('click', () => ficha.close());
	$('[data-decirle]').addEventListener('click', async () => {
		if (!actual) return;
		const { id } = actual;
		ficha.close();
		await abrir('rana');
		rana.para(id);
	});

	formFicha.addEventListener('submit', async (ev) => {
		ev.preventDefault();
		const boton = (ev as SubmitEvent).submitter as HTMLButtonElement | null;
		if (boton) boton.disabled = true;
		try {
			const numero = campoFicha('numero').value;
			await admin.guardarInvitado({
				id: actual?.id ?? null,
				nombre: campoFicha('nombre').value,
				numero: numero ? Number(numero) : null,
				especial: campoFicha('especial').checked,
				visible: campoFicha('visible').checked,
			});
			ficha.close();
			avisar(actual ? 'Invitado guardado' : 'Invitado añadido');
			caducar('inicio');
			await pintarInvitados();
		} catch (e) {
			errorEnFicha(e);
		} finally {
			if (boton) boton.disabled = false;
		}
	});

	$('[data-ajustar]').addEventListener('click', async (ev) => {
		const boton = ev.currentTarget as HTMLButtonElement;
		if (!actual) return;
		const puntos = Number(campoFicha('puntos').value);
		const motivo = campoFicha('motivo').value.trim();
		if (!puntos || !motivo) return errorEnFicha(new Error('datos'));
		if (!confirm(`¿${puntos > 0 ? 'Sumar' : 'Quitar'} ${Math.abs(puntos)} LP a ${actual.nombre}?`)) return;
		boton.disabled = true;
		try {
			const r = await admin.ajustarPuntos(actual.id, puntos, motivo);
			ficha.close();
			avisar(`${actual.nombre} tiene ahora ${r.puntos} LP`);
			caducar('inicio');
			await pintarInvitados();
		} catch (e) {
			errorEnFicha(e);
		} finally {
			boton.disabled = false;
		}
	});

	$('[data-quitar-foto]').addEventListener('click', async (ev) => {
		const boton = ev.currentTarget as HTMLButtonElement;
		if (!actual || !confirm(`¿Quitar la foto del cromo de ${actual.nombre}?`)) return;
		boton.disabled = true;
		try {
			await admin.quitarFoto(actual.id);
			ficha.close();
			avisar(`Foto de ${actual.nombre} quitada`);
			await pintarInvitados();
		} catch (e) {
			errorEnFicha(e);
		} finally {
			boton.disabled = false;
		}
	});

	$('[data-nuevo-movil]').addEventListener('click', async (ev) => {
		const boton = ev.currentTarget as HTMLButtonElement;
		if (!actual || !confirm(`${actual.nombre} tendrá que volver a registrarse. ¿Seguro?`)) return;
		boton.disabled = true;
		try {
			await admin.nuevoMovil(actual.id);
			ficha.close();
			avisar(`${actual.nombre} ya se puede registrar otra vez`);
			caducar('inicio');
			await pintarInvitados();
		} catch (e) {
			errorEnFicha(e);
		} finally {
			boton.disabled = false;
		}
	});

	// ── Premios ──
	const resultadoCodigo = $('[data-resultado-codigo]');
	$<HTMLFormElement>('[data-form-codigo]').addEventListener('submit', (ev) => {
		ev.preventDefault();
		const form = ev.currentTarget as HTMLFormElement;
		const codigo = String(new FormData(form).get('codigo') ?? '');
		void accion((ev as SubmitEvent).submitter as HTMLButtonElement, async () => {
			resultadoCodigo.hidden = true;
			const c = await admin.buscarCodigo(codigo.trim().toUpperCase());
			// Tarjeta grande: de quién es y qué premio, en verde si se puede entregar y en rojo si ya se entregó
			resultadoCodigo.className = `mt-4 rounded-xl border-4 p-4 text-center ${c.entregado ? 'border-granate bg-granate/10' : 'border-green-700 bg-green-50'}`;
			const titulo = el('p', 'rotulo text-2xl text-granate', c.premio);
			const quien = el('p', 'mt-1 text-lg font-bold', `${c.nombre}${c.apodo ? ` «${c.apodo}»` : ''}`);
			const pie = c.entregado
				? el('p', 'mt-3 rounded bg-granate px-3 py-2 text-sm font-black uppercase tracking-wider text-amarillo', `Ya entregado${c.entregadoEn ? ` el ${new Date(c.entregadoEn).toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' })}` : ''} · no lo des otra vez`)
				: el('button', 'mt-4 w-full rounded-lg bg-green-700 px-4 py-4 text-lg font-black uppercase tracking-wider text-white active:bg-green-800', '✓ Entregar');
			if (pie instanceof HTMLButtonElement) {
				pie.type = 'button';
				pie.addEventListener('click', () =>
					accion(pie, async () => {
						await admin.entregarPremio(c.codigo);
						resultadoCodigo.hidden = true;
						form.reset();
						caducar('inicio', 'premios');
						await pintarPremios();
						cargadas.add('premios');
						return `Entregado: ${c.premio} a ${c.nombre}`;
					}),
				);
			}
			resultadoCodigo.replaceChildren(titulo, quien, pie);
			resultadoCodigo.hidden = false;
		});
	});

	const requisito = (r: admin.PremioAdmin['requisito']) =>
		r.tipo === 'rango' ? `Llegar a ${r.rango}` : r.tipo === 'podio' ? (r.hasta === 1 ? 'Ganar la liga' : `Top ${r.hasta} al cierre`) : 'Equipo ganador';

	async function pintarPremios() {
		const premios = await admin.premios();
		$('[data-lista-premios]').replaceChildren(
			...premios.map((p) => {
				const li = el('li', 'rounded-lg bg-white p-3 shadow-chapa');
				const form = el('form', 'space-y-2');
				const cabecera = el('p', 'flex flex-wrap items-baseline justify-between gap-2 text-xs font-bold uppercase tracking-wider text-tinta-suave');
				cabecera.append(el('span', '', requisito(p.requisito)), el('span', '', `${p.conseguidos} conseguidos · ${p.entregados} entregados`));
				const titulo = el('input', 'block w-full rounded border-2 border-granate/25 px-3 py-2 font-bold');
				titulo.value = p.titulo;
				titulo.maxLength = 60;
				titulo.required = true;
				titulo.setAttribute('aria-label', 'Título del premio');
				const desc = el('textarea', 'block w-full rounded border-2 border-granate/25 px-3 py-2 text-sm');
				desc.value = p.descripcion;
				desc.maxLength = 300;
				desc.rows = 2;
				desc.setAttribute('aria-label', 'Descripción del premio');
				const pie = el('div', 'flex items-center justify-between gap-3');
				const activo = el('label', 'flex items-center gap-2 text-sm font-bold');
				const check = el('input', 'size-5 accent-granate');
				check.type = 'checkbox';
				check.checked = p.activo;
				activo.append(check, 'Activo');
				const guardar = el('button', 'rounded-sm bg-amarillo px-4 py-2 text-xs font-black uppercase tracking-wider text-granate-oscuro', 'Guardar');
				guardar.type = 'submit';
				pie.append(activo, guardar);
				form.append(cabecera, titulo, desc, pie);
				form.addEventListener('submit', (ev) => {
					ev.preventDefault();
					void accion(guardar, async () => {
						await admin.guardarPremio(p.id, titulo.value, desc.value, check.checked);
						return 'Premio guardado';
					});
				});
				li.append(form);
				return li;
			}),
		);
	}

	// ── Liga ──
	const formAjustes = $<HTMLFormElement>('[data-form-ajustes]');
	const campoAjuste = (n: string) => formAjustes.elements.namedItem(n) as HTMLInputElement;
	/** ISO → valor de <input type="datetime-local"> en la hora del móvil */
	const aLocal = (iso: string) => {
		const d = new Date(iso);
		const dos = (n: number) => String(n).padStart(2, '0');
		return `${d.getFullYear()}-${dos(d.getMonth() + 1)}-${dos(d.getDate())}T${dos(d.getHours())}:${dos(d.getMinutes())}`;
	};

	async function pintarAjustes() {
		const a = await admin.ajustes();
		campoAjuste('tiradasEntreSemana').value = String(a.tiradasEntreSemana);
		campoAjuste('tiradasFinDeSemana').value = String(a.tiradasFinDeSemana);
		campoAjuste('penalizacionDiablo').value = String(a.penalizacionDiablo);
		campoAjuste('cierreLiga').value = aLocal(a.cierreLiga);
	}

	formAjustes.addEventListener('submit', (ev) => {
		ev.preventDefault();
		void accion((ev as SubmitEvent).submitter as HTMLButtonElement, async () => {
			await admin.guardarAjustes({
				tiradasEntreSemana: Number(campoAjuste('tiradasEntreSemana').value),
				tiradasFinDeSemana: Number(campoAjuste('tiradasFinDeSemana').value),
				penalizacionDiablo: Number(campoAjuste('penalizacionDiablo').value),
				cierreLiga: new Date(campoAjuste('cierreLiga').value).toISOString(),
			});
			caducar('inicio');
			return 'Ajustes guardados';
		});
	});

	$<HTMLFormElement>('[data-form-pin]').addEventListener('submit', (ev) => {
		ev.preventDefault();
		const form = ev.currentTarget as HTMLFormElement;
		const pin = String(new FormData(form).get('pin') ?? '').trim();
		if (!confirm(`El PIN pasará a ser «${pin}». El anterior dejará de valer. ¿Seguro?`)) return;
		void accion((ev as SubmitEvent).submitter as HTMLButtonElement, async () => {
			await admin.cambiarPin(pin);
			form.reset();
			return 'PIN cambiado. Acuérdate de ponerlo en el mensaje de invitación.';
		});
	});

	// ── Acabados y palabra secreta ──
	const formPalabra = $<HTMLFormElement>('[data-form-palabra]');
	const campoPalabra = formPalabra.elements.namedItem('palabra') as HTMLInputElement;
	async function pintarAcabados() {
		const a = await admin.acabados();
		campoPalabra.value = a.palabra ?? '';
		$('[data-lista-acabados]').replaceChildren(
			...a.conseguidos.map((c) => el('li', 'rounded-full bg-crema-oscuro px-3 py-1 text-xs font-bold', `${ACABADOS[c.id].titulo}: ${c.cuantos}`)),
		);
	}
	formPalabra.addEventListener('submit', (ev) => {
		ev.preventDefault();
		void accion((ev as SubmitEvent).submitter as HTMLButtonElement, async () => {
			const palabra = campoPalabra.value.trim();
			await admin.guardarPalabra(palabra);
			return palabra ? 'Palabra guardada' : 'Palabra quitada';
		});
	});

	// ── Wordle ──
	async function pintarWordle() {
		const palabras = await admin.palabrasWordle();
		$('[data-cuenta-wordle]').textContent = `(${palabras.length})`;
		$('[data-lista-wordle]').replaceChildren(
			...(palabras.length
				? palabras.map((w) => {
						const li = el('li', 'flex items-center gap-1 rounded bg-white py-1 pl-3 pr-1 font-mono font-bold shadow-chapa');
						li.append(w.palabra);
						if (w.dia) li.append(el('span', 'ml-1 text-xs font-normal text-tinta-suave', w.dia.slice(5).split('-').reverse().join('/')));
						const borrar = el('button', 'ml-1 size-7 rounded text-lg leading-none text-granate disabled:opacity-30', '×');
						borrar.type = 'button';
						borrar.setAttribute('aria-label', `Borrar ${w.palabra}`);
						borrar.disabled = !!w.dia; // las que ya han salido no se pueden borrar
						borrar.addEventListener('click', () =>
							accion(borrar, async () => {
								await admin.borrarWordle(w.id);
								await pintarWordle();
								return `${w.palabra} borrada`;
							}),
						);
						li.append(borrar);
						return li;
					})
				: [el('li', 'text-sm text-tinta-suave', 'Aún no hay palabras.')]),
		);
	}

	$<HTMLFormElement>('[data-form-wordle]').addEventListener('submit', (ev) => {
		ev.preventDefault();
		const form = ev.currentTarget as HTMLFormElement;
		const palabras = String(new FormData(form).get('palabras') ?? '')
			.split(/[\s,;]+/)
			.filter(Boolean);
		void accion((ev as SubmitEvent).submitter as HTMLButtonElement, async () => {
			const n = await admin.anadirWordle(palabras);
			form.reset();
			await pintarWordle();
			return n === palabras.length ? `${n} añadidas` : `${n} añadidas (las repetidas no se añaden)`;
		});
	});

	// ── Arranque: solo con sesión de admin ──
	async function arrancar() {
		if (!usaBD()) {
			estado.innerHTML = 'Para entrar al admin, <a class="text-granate underline" href="/registro">regístrate</a> con tu nombre: los organizadores tenéis permiso.';
			return;
		}
		try {
			await pintarResumen();
			cargadas.add('inicio');
			estado.hidden = true;
			$('[data-admin-panel]').hidden = false;
		} catch (e) {
			const codigo = e instanceof Error ? e.message : '';
			estado.textContent =
				codigo === 'no-admin'
					? 'Esta página es solo para los organizadores.'
					: codigo === 'sesion'
						? 'Tu sesión ya no vale. Vuelve a registrarte.'
						: admin.mensajeError(e);
		}
	}
	void arrancar();
</script>

<style>
	/* Pestaña activa de la barra de abajo: el icono con fondo */
	[data-pestana][aria-pressed='true'] [data-icono] {
		background: var(--color-amarillo-claro);
	}
	/* Aviso flotante: verde si ha ido bien, granate si no */
	[data-aviso] {
		border-color: #15803d;
		background: #f0fdf4;
		color: #166534;
	}
	[data-aviso].aviso-mal {
		border-color: var(--color-granate);
		background: #fdf0f1;
		color: var(--color-granate);
	}
</style>
